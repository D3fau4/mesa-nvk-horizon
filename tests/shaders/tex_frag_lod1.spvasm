; tex_frag_lod1 -- Phase 5 item 6, sampling mip level 1 explicitly.
;
; Identical to tex_frag_sample except for OpImageSampleExplicitLod with
; Lod = 1.0. That makes mip selection the thing being measured rather
; than a consequence of the derivatives, and it needs the image view to
; really carry two levels and the descriptor to really describe them.
;
; Level 1 of the 8x8 source is 4x4 and holds a pattern that shares no
; value with level 0 (see t_vk_texture.c), so "sampled the wrong level"
; is a different image and not a subtly different one.
;
; Copyright (c) mesa-nvk-horizon contributors
; SPDX-License-Identifier: MIT
               OpCapability Shader
               OpMemoryModel Logical GLSL450
               OpEntryPoint Fragment %main "main" %in_uv %out_colour
               OpExecutionMode %main OriginUpperLeft

               OpDecorate %in_uv Location 0
               OpDecorate %out_colour Location 0
               OpDecorate %tex DescriptorSet 0
               OpDecorate %tex Binding 0

       %void = OpTypeVoid
     %fnvoid = OpTypeFunction %void
      %float = OpTypeFloat 32
    %v2float = OpTypeVector %float 2
    %v4float = OpTypeVector %float 4

      %image = OpTypeImage %float 2D 0 0 0 1 Unknown
    %sampled = OpTypeSampledImage %image
     %ptr_uc = OpTypePointer UniformConstant %sampled
        %tex = OpVariable %ptr_uc UniformConstant

  %ptr_in_v2 = OpTypePointer Input %v2float
 %ptr_out_v4 = OpTypePointer Output %v4float
      %in_uv = OpVariable %ptr_in_v2 Input
 %out_colour = OpVariable %ptr_out_v4 Output

        %f_1 = OpConstant %float 1

       %main = OpFunction %void None %fnvoid
      %entry = OpLabel
         %uv = OpLoad %v2float %in_uv
          %s = OpLoad %sampled %tex
          %c = OpImageSampleExplicitLod %v4float %s %uv Lod %f_1
               OpStore %out_colour %c
               OpReturn
               OpFunctionEnd
