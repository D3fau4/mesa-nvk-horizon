; tex_frag_sample -- Phase 5 item 6, sampling with the implicit level of
; detail.
;
; One combined image sampler at set 0 binding 0, sampled at the
; interpolated uv and written straight out. Used by the nearest case and
; by the linear one; what changes between them is the VkSampler, not the
; shader, which is the point -- the same SPIR-V has to produce two
; different and separately predicted images.
;
; Implicit LOD on purpose, rather than an explicit 0.0: it is the common
; path, it exercises the derivative computation, and the answer is not
; in doubt here. The mapping in tex_vert_fullscreen makes du/dx = 1/64,
; which is 1/8 of a texel on an 8x8 texture, so the computed LOD is
; log2(0.125) = -3 and clamps to level 0 with three octaves to spare.
; The explicit-LOD case lives in tex_frag_lod1.
;
; Copyright (c) mesa-nvk-horizon contributors
; SPDX-License-Identifier: MIT
               OpCapability Shader
               OpMemoryModel Logical GLSL450
               OpEntryPoint Fragment %main "main" %in_uv %out_colour
               OpExecutionMode %main OriginUpperLeft

               OpDecorate %in_uv Location 0
               OpDecorate %out_colour Location 0
               OpDecorate %tex DescriptorSet 0
               OpDecorate %tex Binding 0

       %void = OpTypeVoid
     %fnvoid = OpTypeFunction %void
      %float = OpTypeFloat 32
    %v2float = OpTypeVector %float 2
    %v4float = OpTypeVector %float 4

      %image = OpTypeImage %float 2D 0 0 0 1 Unknown
    %sampled = OpTypeSampledImage %image
     %ptr_uc = OpTypePointer UniformConstant %sampled
        %tex = OpVariable %ptr_uc UniformConstant

  %ptr_in_v2 = OpTypePointer Input %v2float
 %ptr_out_v4 = OpTypePointer Output %v4float
      %in_uv = OpVariable %ptr_in_v2 Input
 %out_colour = OpVariable %ptr_out_v4 Output

       %main = OpFunction %void None %fnvoid
      %entry = OpLabel
         %uv = OpLoad %v2float %in_uv
          %s = OpLoad %sampled %tex
          %c = OpImageSampleImplicitLod %v4float %s %uv
               OpStore %out_colour %c
               OpReturn
               OpFunctionEnd
