; depth_vert_z -- Phase 5 item 7, the vertex shader for every depth draw.
;
; The oversized single triangle again -- (-1,-1), (3,-1), (-1,3) -- but
; with its depth taken from a push constant, so the four draws differ
; only in the twenty bytes pushed before each of them. The region each
; one affects is carved by the scissor rectangle, which is exact in
; pixel coordinates and needs no geometry at all.
;
; That is deliberate: item 7 is about the depth test, and a test whose
; regions came from triangle edges would be measuring rasterisation
; again (item 5 already did) and would put a fill-rule question between
; the reader and the answer.
;
; z is constant across the triangle, so it survives interpolation
; exactly. With w = 1 and a viewport of minDepth 0 to maxDepth 1, the
; value written into the depth buffer is the constant itself: 0.75 and
; 0.25 and 0.875 are all exact in binary, which is what lets the depth
; readback be compared bit for bit.
;
; The push constant block is declared identically here and in
; depth_frag_pc: one range, offset 0, twenty bytes, both stages.
;
; Copyright (c) mesa-nvk-horizon contributors
; SPDX-License-Identifier: MIT
               OpCapability Shader
               OpMemoryModel Logical GLSL450
               OpEntryPoint Vertex %main "main" %position %vertex_index

               OpDecorate %position BuiltIn Position
               OpDecorate %vertex_index BuiltIn VertexIndex
               OpMemberDecorate %PC 0 Offset 0
               OpMemberDecorate %PC 1 Offset 16
               OpDecorate %PC Block

       %void = OpTypeVoid
     %fnvoid = OpTypeFunction %void
      %float = OpTypeFloat 32
      %int32 = OpTypeInt 32 1
       %uint = OpTypeInt 32 0
    %v2float = OpTypeVector %float 2
    %v4float = OpTypeVector %float 4

         %PC = OpTypeStruct %v4float %float
     %ptr_pc = OpTypePointer PushConstant %PC
   %ptr_pc_f = OpTypePointer PushConstant %float
         %pc = OpVariable %ptr_pc PushConstant

 %ptr_out_v4 = OpTypePointer Output %v4float
   %position = OpVariable %ptr_out_v4 Output
 %ptr_in_int = OpTypePointer Input %int32
%vertex_index = OpVariable %ptr_in_int Input

     %uint_3 = OpConstant %uint 3
     %arr3v2 = OpTypeArray %v2float %uint_3
 %ptr_pv_arr = OpTypePointer Private %arr3v2
  %ptr_pv_v2 = OpTypePointer Private %v2float

       %f_n1 = OpConstant %float -1
        %f_1 = OpConstant %float 1
        %f_3 = OpConstant %float 3
      %int_1 = OpConstant %int32 1

         %p0 = OpConstantComposite %v2float %f_n1 %f_n1
         %p1 = OpConstantComposite %v2float %f_3 %f_n1
         %p2 = OpConstantComposite %v2float %f_n1 %f_3
       %init = OpConstantComposite %arr3v2 %p0 %p1 %p2
      %verts = OpVariable %ptr_pv_arr Private %init

       %main = OpFunction %void None %fnvoid
      %entry = OpLabel
        %idx = OpLoad %int32 %vertex_index
         %pp = OpAccessChain %ptr_pv_v2 %verts %idx
         %xy = OpLoad %v2float %pp
          %x = OpCompositeExtract %float %xy 0
          %y = OpCompositeExtract %float %xy 1
         %zp = OpAccessChain %ptr_pc_f %pc %int_1
          %z = OpLoad %float %zp
        %pos = OpCompositeConstruct %v4float %x %y %z %f_1
               OpStore %position %pos
               OpReturn
               OpFunctionEnd
