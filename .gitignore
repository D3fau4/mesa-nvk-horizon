# Pinned Mesa checkout (populated by scripts/fetch-mesa.sh; see docs/architecture.md §4.1)
/mesa/*
!/mesa/.gitkeep

# Build outputs
/build/
/build-*/
*.o
*.a
*.elf
*.nro
*.nso
*.nacp
*.map

# Toolchain caches
/toolchain/sysroot/
/toolchain/.cache/

# Logs
*.log
# ...except the hardware runs, which are evidence rather than output.
# They were being force-added one at a time; a log that silently fails to
# be committed is the one kind of file this project cannot afford to lose,
# since a result nobody can re-run is only as good as its record.
!/docs/hw-logs/*.log
