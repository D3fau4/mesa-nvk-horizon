From fee9eb646726b55b9444d7cdc5ab0e76265ed370 Mon Sep 17 00:00:00 2001
From: mesa-nvk-horizon <mesa-nvk-horizon@localhost>
Date: Wed, 5 Aug 2026 10:50:31 +0000
Subject: [PATCH 57/59] vulkan/wsi: Horizon, a swapchain image's size is
 checked into 32 bits
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

mesa-nvk-horizon: Phase 6 item 5 (Zero-copy when the format/tiling
 combination allows it)
Why: wsi_image::sizes is uint32_t and VkMemoryRequirements::size is a
 VkDeviceSize, so wsi_horizon_create_image_mem was narrowing one to the
 other silently. An image too large for 32 bits is also too large for an
 NvGraphicBuffer, whose size and offset fields are the same width — so
 the truncation would not have been caught later by the zero-copy
 validation either, which checks the layout the driver reports and not
 the number this function wrote. The failure it would produce is a
 display reading half an image, with every check passing.
 Nothing reaches it today: the largest extent this surface offers is the
 window's, and 1920x1080x4 is 8 MiB. It is a guard against a swapchain
 format or extent this backend does not offer yet, which is when a
 narrowing of this shape is usually found.
Evidence: cross build of build/mesa-nvk. sizeof(((struct wsi_image
 *)0)->sizes[0]) is 4 (wsi_common_private.h) against VkDeviceSize's 8.
 Not run on a console.
Upstream: no.
---
 src/vulkan/wsi/wsi_horizon.c | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/src/vulkan/wsi/wsi_horizon.c b/src/vulkan/wsi/wsi_horizon.c
index 834fe8a..856c16f 100644
--- a/src/vulkan/wsi/wsi_horizon.c
+++ b/src/vulkan/wsi/wsi_horizon.c
@@ -58,6 +58,7 @@
 
 #include <switch.h>
 
+#include <inttypes.h>
 #include <stdlib.h>
 #include <string.h>
 
@@ -653,13 +654,26 @@ wsi_horizon_create_image_mem(const struct wsi_swapchain *chain,
                                                        reqs.memoryTypeBits),
    };
 
+   /* wsi_image::sizes is uint32_t and reqs.size is a VkDeviceSize. The
+    * narrowing is checked rather than performed: a swapchain image that
+    * does not fit 32 bits also does not fit an NvGraphicBuffer, whose
+    * size and offset fields are the same width, so refusing here says
+    * so once instead of leaving a truncated size to be discovered as a
+    * display reading half an image. */
+   if (reqs.size > UINT32_MAX) {
+      return vk_errorf(chain->wsi->pdevice, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                       "wsi_horizon: a swapchain image of %" PRIu64 " bytes "
+                       "does not fit the 32-bit fields this window system "
+                       "describes buffers with", (uint64_t)reqs.size);
+   }
+
    VkResult result = wsi->AllocateMemory(chain->device, &mem_info,
                                          &chain->alloc, &image->memory);
    if (result != VK_SUCCESS)
       return result;
 
    image->num_planes = 1;
-   image->sizes[0] = reqs.size;
+   image->sizes[0] = (uint32_t)reqs.size;
    image->offsets[0] = 0;
    /* row_pitches is filled in after the driver has described the
     * layout; there is no vkGetImageSubresourceLayout for an OPTIMAL
-- 
