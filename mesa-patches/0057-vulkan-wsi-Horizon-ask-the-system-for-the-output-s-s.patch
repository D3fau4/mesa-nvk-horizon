---
 src/vulkan/wsi/wsi_horizon.c | 53 ++++++++++++++++++++++++++++++++----
 1 file changed, 47 insertions(+), 6 deletions(-)

diff --git a/src/vulkan/wsi/wsi_horizon.c b/src/vulkan/wsi/wsi_horizon.c
index ebb3359bab7..25a8fa18a18 100644
--- a/src/vulkan/wsi/wsi_horizon.c
+++ b/src/vulkan/wsi/wsi_horizon.c
@@ -338,17 +338,58 @@ wsi_horizon_surface_get_support(VkIcdSurfaceBase *surface,
  * NOT nwindowGetDimensions, and the difference matters. That returns
  * NWindow::width when it is set, which is whatever the last
  * nwindowSetDimensions asked for — and this backend is what calls it,
- * so asking would be reading back our own request. NWindow::default_*
- * is the consumer's answer: libnx fills it from the BufferQueue's
- * output at connect and at every queue. It is what changes when the
- * console is docked and the display becomes 1920x1080.
+ * so asking would be reading back our own request.
+ *
+ * AND NOT NWindow::default_* EITHER, which is what this used to read
+ * and why patch 0040's dock path has never fired on hardware. That
+ * field is the BufferQueue's answer, and the BufferQueue does not hear
+ * about a display mode change.
+ *
+ * MEASURED ON A CONSOLE 2026-08-24, tests/t_dock.c, docking and
+ * undocking three times with a buffer queued every 50 ms so the
+ * consumer's answer was being refreshed throughout:
+ *
+ *   CHANGE 1 at 7201 ms: mode 0 -> 1, dimensions 1280x720 -> 1280x720,
+ *     default_ 1280x720 -> 1280x720, DisplayResolution 1280x720 ->
+ *     1280x720
+ *   CHANGE 2 at 7554 ms: mode 1 -> 1, dimensions 1280x720 -> 1280x720,
+ *     default_ 1280x720 -> 1280x720, DisplayResolution 1280x720 ->
+ *     1920x1080
+ *
+ * The operation mode moves, the applet hook fires, and the *display
+ * resolution* follows about 350 ms later — while the window and the
+ * queue stay at 1280x720 from beginning to end. The compositor scales
+ * this layer to the television rather than resizing it, so a producer
+ * watching the queue can never learn that the output changed.
+ *
+ * appletGetDefaultDisplayResolution() is the system's own answer to
+ * "how big is the output now", it moved on every one of those three
+ * docks, and it is what this reads. Patch 0040 wrote "VK_SUBOPTIMAL_KHR
+ * HAS NEVER BEEN RETURNED ON HARDWARE" and treated that as coverage it
+ * had not got; it was not coverage, it was a source that cannot move.
+ *
+ * Undocked the two agree — both 1280x720 — which is why this is a small
+ * change and not a redesign: every existing test's behaviour is
+ * unchanged by construction, and that is checked rather than assumed.
  */
 static VkResult
 wsi_horizon_get_extent(VkIcdSurfaceBase *surface, VkExtent2D *extent)
 {
    NWindow *win = wsi_horizon_window(surface);
-   u32 width = win->default_width;
-   u32 height = win->default_height;
+   u32 width = 0, height = 0;
+
+   s32 disp_w = 0, disp_h = 0;
+   if (R_SUCCEEDED(appletGetDefaultDisplayResolution(&disp_w, &disp_h)) &&
+       disp_w > 0 && disp_h > 0) {
+      width = (u32)disp_w;
+      height = (u32)disp_h;
+   } else {
+      /* The consumer's answer, which is where this used to start. It
+       * cannot follow a dock, but it is right whenever nothing has
+       * docked, and something has to be returned. */
+      width = win->default_width;
+      height = win->default_height;
+   }
 
    if (width == 0 || height == 0) {
       /* Nothing has been queued yet and the connect told us nothing.
