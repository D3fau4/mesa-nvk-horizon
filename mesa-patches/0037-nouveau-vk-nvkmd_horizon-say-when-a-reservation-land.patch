From 7fce532a6184c3fc16250551d52c1c0159ed0f67 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 28 Jul 2026 19:03:26 +0000
Subject: [PATCH 37/79] nouveau/vk: nvkmd_horizon, say when a reservation lands
 on the shader memory window

nvk_push_dispatch_state_init programs the shader local and shared memory
windows at fixed addresses -- 0xff000000 and 0xfe000000 on pre-Volta --
and a shader's LDL/STL/LDS/STS go through them. They are apertures, not
allocations, and upstream says outright that nothing stops a real buffer
landing there: "This will have to be dealt with for real eventually by
blocking off that area from the VM. Really?!? TODO: Fix this for realz."

On Horizon it is not a likelihood. The small-page region begins at
0x8000000 and NVK's reservations march up through 4 GiB, so the shader
heap's own reservation covers both windows. Measured on the emulator
with NVK_DEBUG=vm: alloc va [0xa052000, 0x10a052000) spans 0xfe000000
and 0xff000000.

Detected rather than worked around. NVGPU_AS_IOCTL_ALLOC_SPACE has no
"place it here" form, so the aperture cannot simply be reserved, and
every scheme for steering the allocator around it costs gigabytes of
address space on a guess that cannot be tested without a console. The
day a shader reads its own code instead of its locals, this line is in
the log.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 .../vulkan/nvkmd/horizon/nvkmd_horizon_va.c   | 37 +++++++++++++++++++
 1 file changed, 37 insertions(+)

diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_va.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_va.c
index afb8b02..8607413 100644
--- a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_va.c
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_va.c
@@ -381,6 +381,43 @@ nvkmd_horizon_alloc_va(struct nvkmd_dev *_dev,
                        (int)res.status, res.nv);
    }
 
+   /* The shader local- and shared-memory windows are fixed VA apertures,
+    * not allocations: nvk_push_dispatch_state_init programs
+    * SET_SHADER_LOCAL_MEMORY_WINDOW = 0xff000000 and
+    * SET_SHADER_SHARED_MEMORY_WINDOW = 0xfe000000 on pre-Volta, and a
+    * shader's LDL/STL/LDS/STS go through them. Upstream says outright
+    * that nothing stops a real allocation landing there — "Reduce
+    * likelihood of collision with real buffers ... This will have to be
+    * dealt with for real eventually by blocking off that area from the
+    * VM. Really?!? TODO: Fix this for realz."
+    *
+    * On this platform it is not a likelihood, it is what happens. The
+    * small-page region begins at 0x8000000 and NVK's reservations march
+    * up through 4 GiB, so the shader heap's own 4 GiB reservation covers
+    * both windows. Measured on the emulator, 2026-07-28:
+    * alloc va [0xa052000, 0x10a052000) spans 0xfe000000 and 0xff000000.
+    *
+    * Detected rather than worked around. NVGPU_AS_IOCTL_ALLOC_SPACE has
+    * no "place it here" form (see NVKMD_VA_ALLOC_FIXED above), so the
+    * aperture cannot simply be reserved, and every scheme for steering
+    * the allocator around it costs gigabytes of address space on a guess
+    * nobody can test without a console. Saying so precisely is worth
+    * more than a blind fix: the day a shader reads its own code instead
+    * of its locals, this line is in the log.
+    */
+   const uint64_t win_lo = UINT64_C(0xfe000000); /* shared window base */
+   const uint64_t win_hi = UINT64_C(0x100000000); /* local window end */
+   const uint64_t va_lo = horizon_gpu_va_range_base(va->range);
+   const uint64_t va_hi = va_lo + horizon_gpu_va_range_size(va->range);
+   if (va_lo < win_hi && win_lo < va_hi) {
+      mesa_loge("nvkmd_horizon: reservation [0x%" PRIx64 ", 0x%" PRIx64
+                ") overlaps the shader local/shared memory window "
+                "[0x%" PRIx64 ", 0x%" PRIx64 "). Shader local and shared "
+                "accesses go through that aperture; anything bound here "
+                "will be read as locals and vice versa.",
+                va_lo, va_hi, win_lo, win_hi);
+   }
+
    va->base.ops = &nvkmd_horizon_va_ops;
    va->base.dev = _dev;
    va->base.flags = flags;
-- 
