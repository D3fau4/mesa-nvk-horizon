From 46b9715cd8cd1d15d919d319fb6585a5ec970d19 Mon Sep 17 00:00:00 2001
From: mesa-nvk-horizon <noreply@invalid>
Date: Sun, 9 Aug 2026 20:01:34 +0200
Subject: [PATCH] vulkan/wsi: Horizon, report the layout that was registered

mesa-nvk-horizon: Phase 6 item 4 (Horizon WSI backend)
Why: every check in wsi_horizon_fill_graphic_buffer is a predicate. They
 say the image's layout is one an NvGraphicBuffer can describe; none of
 them says what it is. So a swapchain that reaches zero-copy proves the
 arithmetic held and leaves no way to learn the numbers it held for -
 and the numbers are exactly what nobody could check across a display
 mode change, because every measurement in Phase 6 was taken at one
 extent.
Evidence: hardware, docs/hw-logs/t_vk_wsi_mt-run20-review-fixes-PASS.log
 (build 2026-08-09T18:29:27.522Z e7870a0-dirty mesa:ebf2e31, full
 memory), which carries 50 of these lines. At 1280x720:
   layout: stride 5120 B (1280 px), block height 32 GOBs (log2 5, 256
   rows), kind 0xfe, block-linear, display GOB order yes, offset 0 B,
   allocation 3932160 B, scanout 3932160 B
 The block height is log2 5, not the 4 that would have been the natural
 guess, and 3932160 B is exactly 5120 x align_up(720, 256).
 .
 THE EVIDENCE THIS COMMIT FIRST CITED DOES NOT EXIST, and that is why
 this line reads differently from the one in the checkout's history. It
 said "Measured on hardware (t_vk_mode, 2026-08-09, handheld, PASS
 56/56)". There is no tests/t_vk_mode.c in this tree and no log for it
 under docs/hw-logs/, so nobody could check the claim or re-run it. The
 measurement above is the same one, read out of a log that is committed
 verbatim with its digest in MANIFEST.sha256. Nothing was reconstructed:
 the unverifiable citation was replaced, not the finding.
Upstream: no - this file is the Horizon backend itself.

The decision line already goes out at INFO through the debug-utils
messenger so an application can observe which present path it got. This
adds the geometry beside it: stride in bytes and in pixels, block height
in GOBs and in rows, the page-table kind, whether the image is
block-linear in the display's sector order, the offset, the allocation,
and the scanout region the compositor was told to read.

Image 0 only, with a second line when another image disagrees. They come
from one VkImageCreateInfo and are expected to differ in nothing but
where they landed; that expectation is now stated in code rather than
assumed, because it is what makes one line enough.

scanout_size_B is recorded on the image at registration rather than
recomputed for the log, so the value reported is the value that went to
the compositor and not a second opinion about it.

This commit was written outside the patch series and lived only in the
mesa/ checkout, which is what STATUS.md records as D18: the checkout
carried 71 commits against 70 tracked patches, so a clean rebuild did
not reproduce the binary run 20 was measured on. Exporting it here is
what closes that.
---
 src/vulkan/wsi/wsi_horizon.c | 56 +++++++++++++++++++++++++++++++++++-
 1 file changed, 55 insertions(+), 1 deletion(-)

diff --git a/src/vulkan/wsi/wsi_horizon.c b/src/vulkan/wsi/wsi_horizon.c
index 4073d16..d6b0552 100644
--- a/src/vulkan/wsi/wsi_horizon.c
+++ b/src/vulkan/wsi/wsi_horizon.c
@@ -560,6 +560,13 @@ struct wsi_horizon_image {
     * that acquired it. */
    NvMultiFence release_fence;
    bool have_release_fence;
+
+   /* The region the graphic buffer told the compositor to read: the row
+    * stride times the height rounded out to a whole block. Recorded at
+    * registration rather than recomputed, so the decision can be
+    * reported with the numbers it was actually made from. Zero-copy
+    * path only. */
+   uint32_t scanout_size_B;
 };
 
 struct wsi_horizon_swapchain {
@@ -730,7 +737,7 @@ wsi_horizon_configure_image(const struct wsi_swapchain *chain,
  */
 static bool
 wsi_horizon_fill_graphic_buffer(struct wsi_horizon_swapchain *chain,
-                                const struct wsi_horizon_image *image,
+                                struct wsi_horizon_image *image,
                                 NvGraphicBuffer *gb, const char **why)
 {
    const struct wsi_horizon_image_info *info = &image->info;
@@ -839,6 +846,7 @@ wsi_horizon_fill_graphic_buffer(struct wsi_horizon_swapchain *chain,
    gb->planes[0].offset = (uint32_t)info->offset_B;
    gb->planes[0].size = scanout_size_B;
 
+   image->scanout_size_B = scanout_size_B;
    return true;
 }
 
@@ -2181,6 +2189,52 @@ done:
               "wsi_horizon: zero-copy was declined because %s", why);
    }
 
+   /* THE LAYOUT THAT WAS REGISTERED, IN NUMBERS.
+    *
+    * Every check in wsi_horizon_fill_graphic_buffer is a predicate: it
+    * says the layout is describable, never what it is. So a swapchain
+    * that succeeds at one resolution proves nothing about the values it
+    * succeeded with, and a reader of this backend's log had no way to
+    * learn whether a 1080p image gets the same block height as a 720p
+    * one — the sort of thing that is easy to assume and was worth
+    * measuring instead.
+    *
+    * Reported for image 0, with a second line only when another image
+    * disagrees. They are created from one VkImageCreateInfo, so they
+    * are expected to agree on everything but the memory they landed in;
+    * that expectation is stated here rather than trusted, because it is
+    * what makes one line enough.
+    */
+   if (chain->zero_copy) {
+      const struct wsi_horizon_image_info *i0 = &chain->images[0].info;
+      vk_logi(VK_LOG_OBJS(&chain->base.base),
+              "wsi_horizon: layout: stride %" PRIu32 " B (%" PRIu32 " px), "
+              "block height %u GOBs (log2 %" PRIu32 ", %u rows), kind 0x%02x, "
+              "%sblock-linear, display GOB order %s, offset %" PRIu64 " B, "
+              "allocation %" PRIu64 " B, scanout %" PRIu32 " B",
+              i0->row_stride_B, i0->row_stride_B / format->bytes_per_pixel,
+              1u << i0->block_height_log2, i0->block_height_log2,
+              (unsigned)WSI_HORIZON_GOB_HEIGHT_ROWS << i0->block_height_log2,
+              i0->pte_kind, i0->block_linear ? "" : "not ",
+              i0->gob_layout_is_display ? "yes" : "no", i0->offset_B,
+              i0->size_B, chain->images[0].scanout_size_B);
+
+      for (uint32_t i = 1; i < image_count; i++) {
+         const struct wsi_horizon_image_info *ii = &chain->images[i].info;
+         if (ii->row_stride_B != i0->row_stride_B ||
+             ii->block_height_log2 != i0->block_height_log2 ||
+             ii->pte_kind != i0->pte_kind || ii->size_B != i0->size_B ||
+             ii->offset_B != i0->offset_B) {
+            vk_logi(VK_LOG_OBJS(&chain->base.base),
+                    "wsi_horizon: layout: image %" PRIu32 " differs: stride %"
+                    PRIu32 " B, block height log2 %" PRIu32 ", kind 0x%02x, "
+                    "offset %" PRIu64 " B, allocation %" PRIu64 " B",
+                    i, ii->row_stride_B, ii->block_height_log2, ii->pte_kind,
+                    ii->offset_B, ii->size_B);
+         }
+      }
+   }
+
    *swapchain_out = &chain->base;
    return VK_SUCCESS;
 
-- 
2.55.0.windows.2

