From ecd6d84fedadc11915eae57bc74e076c19a55e71 Mon Sep 17 00:00:00 2001
From: mesa-nvk-horizon <mesa-nvk-horizon@localhost>
Date: Tue, 28 Jul 2026 15:08:46 +0000
Subject: [PATCH 22/51] nouveau/vk: sparse follows a kmd capability, not the 3D
 class alone (D12)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

NVK derives sparseBinding, the sparseResidency* features and the queue
family's VK_QUEUE_SPARSE_BINDING_BIT from cls_eng3d >= MAXWELL_B. That
is a fact about the chip. Whether the address space underneath can
express a sparse reservation is a fact about the kernel-mode driver,
and the two need not agree: nvkmd_horizon_alloc_va refuses
NVKMD_VA_SPARSE outright, so on Horizon the feature was advertised and
then declined the moment it was used.

nvkmd_info gains has_sparse. nouveau answers true — DRM_NOUVEAU_VM_BIND
reserves sparse space, so the chip's answer is the whole answer there —
and Horizon answers false. This is decision D12, and this is the
answer.

The recorded reason for D12 was corrected once (originally in patch
0040 of the pre-compaction series): it first said "NVGPU_AS has no
sparse reservation", but NvAllocSpaceFlags_Sparse sits in libnx's
ioctl.h beside the FixedOffset flag the same paragraph missed. A sparse
reservation is expressible. What is missing is partial unbind: sparse
rebinds arbitrary sub-ranges over a reservation's lifetime and
horizon_gpu maps and unmaps whole mappings, which is why
nvkmd_horizon_va_unbind demands an exact match. The decision stands on
that basis instead.

It also stops NVK asking for a bind context, which on this platform
would be a third GPFIFO channel created to service a feature that is
not offered.

mesa-nvk-horizon: Phase 4 — the mandatory Vulkan sequence
Why: GM20B's queried 3D class is exactly MAXWELL_B, so the condition
  was true on this chip while the backend could not honour it.
Evidence: nvkmd_horizon_va.c refuses NVKMD_VA_SPARSE with
  VK_ERROR_FEATURE_NOT_PRESENT.
Upstream: yes — it moves a driver-dependent answer from the chip check
  to the driver, and nouveau's answer keeps its behaviour identical.
---
 src/nouveau/vulkan/nvk_physical_device.c      | 34 ++++++++++++-------
 .../vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c | 24 +++++++++++++
 .../vulkan/nvkmd/nouveau/nvkmd_nouveau_pdev.c |  4 +++
 src/nouveau/vulkan/nvkmd/nvkmd.h              |  7 ++++
 4 files changed, 56 insertions(+), 13 deletions(-)

diff --git a/src/nouveau/vulkan/nvk_physical_device.c b/src/nouveau/vulkan/nvk_physical_device.c
index 63ad5b07c5e..19f267a2ed5 100644
--- a/src/nouveau/vulkan/nvk_physical_device.c
+++ b/src/nouveau/vulkan/nvk_physical_device.c
@@ -323,6 +323,7 @@ nvk_get_device_extensions(const struct nvk_instance *instance,
 
 static void
 nvk_get_device_features(const struct nv_device_info *info,
+                        const struct nvkmd_info *kmd_info,
                         const struct vk_device_extension_table *supported_extensions,
                         struct vk_features *features)
 {
@@ -375,14 +376,14 @@ nvk_get_device_features(const struct nv_device_info *info,
       .shaderInt16 = true,
       .shaderResourceResidency = info->cls_eng3d >= VOLTA_A,
       .shaderResourceMinLod = info->cls_eng3d >= VOLTA_A,
-      .sparseBinding = info->cls_eng3d >= MAXWELL_B,
-      .sparseResidency2Samples = info->cls_eng3d >= MAXWELL_B,
-      .sparseResidency4Samples = info->cls_eng3d >= MAXWELL_B,
-      .sparseResidency8Samples = info->cls_eng3d >= MAXWELL_B,
-      .sparseResidencyAliased = info->cls_eng3d >= MAXWELL_B,
-      .sparseResidencyBuffer = info->cls_eng3d >= MAXWELL_B,
-      .sparseResidencyImage2D = info->cls_eng3d >= MAXWELL_B,
-      .sparseResidencyImage3D = info->cls_eng3d >= MAXWELL_B,
+      .sparseBinding = kmd_info->has_sparse && info->cls_eng3d >= MAXWELL_B,
+      .sparseResidency2Samples = kmd_info->has_sparse && info->cls_eng3d >= MAXWELL_B,
+      .sparseResidency4Samples = kmd_info->has_sparse && info->cls_eng3d >= MAXWELL_B,
+      .sparseResidency8Samples = kmd_info->has_sparse && info->cls_eng3d >= MAXWELL_B,
+      .sparseResidencyAliased = kmd_info->has_sparse && info->cls_eng3d >= MAXWELL_B,
+      .sparseResidencyBuffer = kmd_info->has_sparse && info->cls_eng3d >= MAXWELL_B,
+      .sparseResidencyImage2D = kmd_info->has_sparse && info->cls_eng3d >= MAXWELL_B,
+      .sparseResidencyImage3D = kmd_info->has_sparse && info->cls_eng3d >= MAXWELL_B,
       .variableMultisampleRate = true,
       .inheritedQueries = true,
 
@@ -1477,8 +1478,8 @@ nvk_create_physical_device(struct vk_instance *_instance,
                              &supported_extensions);
 
    struct vk_features supported_features;
-   nvk_get_device_features(&nvkmd->dev_info, &supported_extensions,
-                           &supported_features);
+   nvk_get_device_features(&nvkmd->dev_info, &nvkmd->kmd_info,
+                           &supported_extensions, &supported_features);
 
    struct vk_properties properties;
    nvk_get_device_properties(instance, &nvkmd->dev_info, &properties);
@@ -1604,17 +1605,24 @@ nvk_create_physical_device(struct vk_instance *_instance,
    assert(pdev->mem_heap_count <= ARRAY_SIZE(pdev->mem_heaps));
    assert(pdev->mem_type_count <= ARRAY_SIZE(pdev->mem_types));
 
+   /* The sparse-binding queue flag follows the same fact as the
+    * features above: a queue that advertises it is asked for a bind
+    * context, and a kmd that cannot express a sparse reservation has
+    * nothing to put behind one.
+    */
+   const VkQueueFlags sparse_flag =
+      nvkmd->kmd_info.has_sparse ? VK_QUEUE_SPARSE_BINDING_BIT : 0;
+
    pdev->queue_families[pdev->queue_family_count++] = (struct nvk_queue_family) {
       .queue_flags = VK_QUEUE_GRAPHICS_BIT |
                      VK_QUEUE_COMPUTE_BIT |
                      VK_QUEUE_TRANSFER_BIT |
-                     VK_QUEUE_SPARSE_BINDING_BIT,
+                     sparse_flag,
       .queue_count = 1,
    };
    if (pdev->info.has_transfer_queue) {
       pdev->queue_families[pdev->queue_family_count++] = (struct nvk_queue_family) {
-         .queue_flags = VK_QUEUE_TRANSFER_BIT |
-                        VK_QUEUE_SPARSE_BINDING_BIT,
+         .queue_flags = VK_QUEUE_TRANSFER_BIT | sparse_flag,
          .queue_count = 2,
       };
    }
diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c
index 2ee6db238da..93a888cb39b 100644
--- a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c
@@ -271,6 +271,30 @@ nvkmd_horizon_create_pdev(struct vk_object_base *log_obj,
     *                      fail.
     */
    pdev->base.kmd_info = (struct nvkmd_info) {
+      /* Decision D12. The condition NVK used, cls_eng3d >= MAXWELL_B, is
+       * a fact about GM20B and says nothing about the address space, so
+       * the answer belongs here — but the *reason* recorded here was
+       * wrong and is corrected.
+       *
+       * It used to say "NVGPU_AS has no sparse reservation". It has one:
+       * NvAllocSpaceFlags_Sparse, in libnx's ioctl.h beside the
+       * FixedOffset flag that a neighbouring claim also missed. A sparse
+       * reservation is expressible; that is not the obstacle.
+       *
+       * What is missing is partial unbind. Sparse binding rebinds and
+       * unbinds arbitrary sub-ranges of a reservation over its lifetime,
+       * and horizon_gpu maps and unmaps whole mappings —
+       * nvkmd_horizon_va_unbind requires an exact (offset, range) match
+       * for exactly that reason, because splitting a mapping would leave
+       * the address space and its bookkeeping disagreeing. Sparse needs
+       * that split implemented in horizon_gpu, not a flag flipped here.
+       *
+       * Staying false also stops NVK asking for a bind context, which on
+       * this platform would be a third GPFIFO channel created to service
+       * a feature that is not offered. D12 remains open on those terms:
+       * the work is known and bounded, and nothing in Phase 4 needs it.
+       */
+      .has_sparse = false,
       .has_dma_buf = false,
       .has_get_vram_used = false,
       .has_alloc_tiled = false,
diff --git a/src/nouveau/vulkan/nvkmd/nouveau/nvkmd_nouveau_pdev.c b/src/nouveau/vulkan/nvkmd/nouveau/nvkmd_nouveau_pdev.c
index 10042cdf106..9d7e8fcba36 100644
--- a/src/nouveau/vulkan/nvkmd/nouveau/nvkmd_nouveau_pdev.c
+++ b/src/nouveau/vulkan/nvkmd/nouveau/nvkmd_nouveau_pdev.c
@@ -97,6 +97,10 @@ nvkmd_nouveau_try_create_pdev(struct _drmDevice *drm_device,
    pdev->base.debug_flags = debug_flags;
    pdev->base.dev_info = ws_dev->info;
    pdev->base.kmd_info = (struct nvkmd_info) {
+      /* nouveau reserves sparse address space with DRM_NOUVEAU_VM_BIND
+       * and binds into it, so the answer here is the chip's, which is
+       * what the feature check already asked. */
+      .has_sparse = true,
       .has_dma_buf = true,
       .has_get_vram_used = nouveau_ws_device_vram_used(ws_dev) != 0,
       .has_alloc_tiled = nouveau_ws_device_has_tiled_bo(ws_dev),
diff --git a/src/nouveau/vulkan/nvkmd/nvkmd.h b/src/nouveau/vulkan/nvkmd/nvkmd.h
index 5e56f4ed36c..8506d571ef9 100644
--- a/src/nouveau/vulkan/nvkmd/nvkmd.h
+++ b/src/nouveau/vulkan/nvkmd/nvkmd.h
@@ -115,6 +115,13 @@ enum nvkmd_bind_op {
  */
 
 struct nvkmd_info {
+   /* Whether the kernel-mode driver can reserve sparse address space and
+    * bind into it. NVK otherwise derives sparseBinding from the 3D class
+    * alone, which is a statement about the *chip*; whether the address
+    * space can express a sparse reservation is a statement about the
+    * driver underneath, and the two need not agree.
+    */
+   bool has_sparse;
    bool has_dma_buf;
    bool has_get_vram_used;
    bool has_alloc_tiled;
-- 
2.43.0

