@@ -275,11 +275,14 @@ nvkmd_horizon_create_pdev(struct vk_object_base *log_obj,
    pdev->base.drm.render_dev = 0;
    pdev->base.drm.primary_dev = 0;
 
-   /* Sync types are decision D11 and belong to milestone item 8. Until
-    * then the pdev advertises none, which is a build-visible gap
-    * rather than a silently wrong answer.
+   /* One binary sync type over syncpoints (decision D11, resolved in
+    * nvkmd_horizon_sync.c). The runtime's vk_sync_timeline emulation
+    * goes on top of it for timeline semaphores, which is what NVK does
+    * on every backend whose kernel driver has no timeline of its own.
