diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_sync.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_sync.c
new file mode 100644
index 00000000000..d85c49b1ff7
--- /dev/null
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_sync.c
@@ -0,0 +1,515 @@
+/*
+ * Copyright (c) mesa-nvk-horizon contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * The vk_sync type for Horizon — decision D11, native over syncpoints.
+ *
+ * WHAT IT IS. A *binary* sync backed by a channel fence: a syncpoint id
+ * and a threshold. The runtime's vk_sync_timeline emulation goes on top
+ * for timeline semaphores, which is what NVK does on every backend whose
+ * kernel driver has no timeline of its own.
+ *
+ * WHY NOT THE RUNTIME'S EMULATION ALONE (D11's other arm). The emulation
+ * needs a binary sync type underneath regardless; the question was only
+ * whether *that* should be a syncpoint fence or a CPU-only event. A
+ * syncpoint fence is what a submit actually produces, so anything else
+ * would mean a second bookkeeping layer over the same hardware counter.
+ *
+ * WHY THE TIMEOUT IS CONVERTED HERE (decision D8). vk_sync waits take an
+ * *absolute* deadline in nanoseconds, built by the runtime from
+ * os_time_get_nano(). On this platform that clock was measured to be the
+ * real-time clock — t_ostime saw TIME_MONOTONIC return epoch seconds —
+ * so an absolute deadline moves if the console's date changes.
+ *
+ * The deadline is therefore turned into a *relative* duration exactly
+ * once, here, at the moment the wait starts, and horizon_gpu is given
+ * that duration. horizon_gpu waits with libnx's own tick-based sleep,
+ * which is monotonic in hardware. A date change during the wait then
+ * cannot move the deadline, because by then there is no deadline left to
+ * move — only a remaining duration. That is the whole of D8's practical
+ * consequence, handled in one place rather than everywhere a wait
+ * happens.
+ *
+ * WHY THERE IS A CONDITION VARIABLE (decision D16). A wait can arrive
+ * before there is anything to wait on: a fence created unsignalled, or
+ * one thread entering vkWaitForFences while another is still building
+ * the submit that will signal it. This type advertises CPU_WAIT and
+ * CPU_SIGNAL together, so that is a pattern Vulkan permits rather than
+ * a misuse to reject, and the wait has to be able to *observe* the
+ * object acquiring a fence rather than sample its state once.
+ *
+ * It used to sample once and report VK_TIMEOUT — instantly, even when
+ * asked to wait forever. The condvar is what turns that sample into an
+ * observation: signal(), set_fence() and move() broadcast it, and the
+ * waiter re-checks and either proceeds to the fence or keeps waiting.
+ *
+ * The two decisions meet in the chunking at
+ * NVK_HORIZON_SYNC_WAIT_CHUNK_NS, because cnd_timedwait wants back the
+ * absolute deadline D8 just got rid of.
+ */
+
+#include "nvkmd_horizon.h"
+
+#include "vk_device.h"
+#include "vk_log.h"
+#include "vk_sync.h"
+
+#include "util/log.h"
+#include "util/macros.h"
+#include "util/os_time.h"
+
+#include <inttypes.h>
+
+static struct nvk_horizon_sync *
+to_horizon_sync(struct vk_sync *sync)
+{
+   assert(sync->type == &nvk_horizon_sync_type);
+   return container_of(sync, struct nvk_horizon_sync, base);
+}
+
+/* How long a single cnd_timedwait is allowed to be while waiting for a
+ * sync to acquire a fence at all (decision D16).
+ *
+ * It is a *chunk*, not the timeout, and the reason is decision D8 again.
+ * cnd_timedwait takes an absolute TIME_UTC deadline, and on this
+ * platform that clock is the real-time clock — t_ostime measured it —
+ * so handing it the caller's whole deadline would reintroduce exactly
+ * what D8 was closed by removing: a wait whose end moves when the
+ * console's date does.
+ *
+ * Waiting in bounded chunks and subtracting each expired one from a
+ * remaining *duration* keeps the deadline relative. A date change can
+ * then perturb at most the chunk in flight, never the total. This is
+ * the same shape horizon/channel/channel.c uses for the same reason,
+ * with the same 100 ms figure.
+ *
+ * It costs nothing in wake-up latency: a concurrent signal or submit
+ * broadcasts, which ends the chunk immediately. The chunk only bounds
+ * how coarsely a *timeout* is noticed, and a wait shorter than one
+ * chunk is not rounded up to it — see the min() at the call site.
+ */
+#define NVK_HORIZON_SYNC_WAIT_CHUNK_NS UINT64_C(100000000) /* 100 ms */
+
+/* One bounded wait on `sync->cond`, with `sync->mutex` held.
+ *
+ * The absolute deadline handed to cnd_timedwait is built here, from
+ * now, and never survives the call — which is what keeps the chunking
+ * above meaningful.
+ */
+static int
+nvk_horizon_sync_cond_wait_chunk(struct nvk_horizon_sync *sync,
+                                 uint64_t chunk_ns)
+{
+   struct timespec ts;
+
+   if (timespec_get(&ts, TIME_UTC) != TIME_UTC)
+      return thrd_error;
+
+   /* No overflow check on the seconds carry: chunk_ns is bounded by
+    * NVK_HORIZON_SYNC_WAIT_CHUNK_NS, so `ns` is below 1.1e9 and the
+    * carry is 0 or 1. The bound is the check.
+    */
+   assert(chunk_ns <= NVK_HORIZON_SYNC_WAIT_CHUNK_NS);
+   uint64_t ns = (uint64_t)ts.tv_nsec + chunk_ns;
+   ts.tv_sec += (time_t)(ns / UINT64_C(1000000000));
+   ts.tv_nsec = (long)(ns % UINT64_C(1000000000));
+
+   return cnd_timedwait(&sync->cond, &sync->mutex, &ts);
+}
+
+static VkResult
+nvk_horizon_sync_init(struct vk_device *device,
+                      struct vk_sync *_sync,
+                      uint64_t initial_value)
+{
+   struct nvk_horizon_sync *sync = to_horizon_sync(_sync);
+
+   /* A binary sync: initial_value is 0 or 1 and nothing else is legal.
+    * There is no fence yet either way — one arrives when a submit
+    * signals this object.
+    */
+   if (mtx_init(&sync->mutex, mtx_plain) != thrd_success) {
+      return vk_errorf(device, VK_ERROR_OUT_OF_HOST_MEMORY,
+                       "nvkmd_horizon: mtx_init for a vk_sync failed");
+   }
+   if (cnd_init(&sync->cond) != thrd_success) {
+      mtx_destroy(&sync->mutex);
+      return vk_errorf(device, VK_ERROR_OUT_OF_HOST_MEMORY,
+                       "nvkmd_horizon: cnd_init for a vk_sync failed");
+   }
+
+   sync->state = initial_value ? NVK_HORIZON_SYNC_SIGNALLED
+                               : NVK_HORIZON_SYNC_RESET;
+   sync->fence = (horizon_gpu_fence) { 0, 0 };
+   sync->chan = NULL;
+   /* Timeline use starts the counter at initial_value; binary use passes
+    * 0 or 1 and never reads these back. */
+   sync->signalled_value = initial_value;
+   sync->passed_value = initial_value;
+
+   return VK_SUCCESS;
+}
+
+static void
+nvk_horizon_sync_finish(struct vk_device *device, struct vk_sync *_sync)
+{
+   struct nvk_horizon_sync *sync = to_horizon_sync(_sync);
+
+   /* The fence is two integers and the channel is borrowed from the
+    * context that signalled it, so these two are the only owned things.
+    * Destroyed in the reverse of the order init created them.
+    *
+    * The runtime does not destroy a sync that still has a waiter, so
+    * there is nobody to wake first: vk_sync_destroy is called from the
+    * object's destructor, and a VkFence or VkSemaphore being waited on
+    * while it is destroyed is invalid usage, not a case to defend.
+    */
+   cnd_destroy(&sync->cond);
+   mtx_destroy(&sync->mutex);
+}
+
+static VkResult
+nvk_horizon_sync_signal(struct vk_device *device,
+                        struct vk_sync *_sync,
+                        uint64_t value)
+{
+   struct nvk_horizon_sync *sync = to_horizon_sync(_sync);
+
+   /* A CPU-side signal, which is what vkSignalSemaphore and an
+    * already-signalled VkFence need. It does not touch the syncpoint:
+    * incrementing one from the CPU needs an ioctl horizon_gpu does not
+    * expose yet (extension 3 of the six Phase 4 step 1 enumerated), and
+    * nothing here requires the GPU to observe a CPU signal — the GPU
+    * only ever waits on fences this backend produced itself.
+    */
+   mtx_lock(&sync->mutex);
+   sync->state = NVK_HORIZON_SYNC_SIGNALLED;
+   /* Timeline use: a CPU signal moves the counter to `value`. Binary use
+    * passes 0, which leaves both alone. */
+   sync->signalled_value = MAX2(sync->signalled_value, value);
+   sync->passed_value = MAX2(sync->passed_value, value);
+   /* This is the transition a waiter on a never-submitted sync is
+    * blocked for. Broadcast, not signal: several threads may legally be
+    * waiting on one VkFence. */
+   cnd_broadcast(&sync->cond);
+   mtx_unlock(&sync->mutex);
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvk_horizon_sync_reset(struct vk_device *device, struct vk_sync *_sync)
+{
+   struct nvk_horizon_sync *sync = to_horizon_sync(_sync);
+
+   /* No broadcast: reset makes the object *less* reachable, so there is
+    * no waiter it could release. One blocked here stays blocked, which
+    * is correct — resetting a fence somebody is waiting on does not
+    * satisfy their wait. */
+   mtx_lock(&sync->mutex);
+   sync->state = NVK_HORIZON_SYNC_RESET;
+   sync->fence = (horizon_gpu_fence) { 0, 0 };
+   sync->chan = NULL;
+   /* Reset is a binary operation — the runtime never resets a timeline —
+    * so the counter goes back to where init leaves it. */
+   sync->signalled_value = 0;
+   sync->passed_value = 0;
+   mtx_unlock(&sync->mutex);
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvk_horizon_sync_move(struct vk_device *device,
+                      struct vk_sync *_dst, struct vk_sync *_src)
+{
+   struct nvk_horizon_sync *dst = to_horizon_sync(_dst);
+   struct nvk_horizon_sync *src = to_horizon_sync(_src);
+
+   /* Two locks, taken in address order so two concurrent moves between
+    * the same pair cannot deadlock by taking them in opposite orders.
+    * dst == src is not a case the runtime produces, but locking a mutex
+    * twice would hang rather than misbehave visibly, so it is excluded
+    * explicitly.
+    */
+   assert(dst != src);
+   struct nvk_horizon_sync *first = dst < src ? dst : src;
+   struct nvk_horizon_sync *second = dst < src ? src : dst;
+   mtx_lock(&first->mutex);
+   mtx_lock(&second->mutex);
+
+   /* Everything except the vk_sync header, which the runtime owns and
+    * has already initialised in the destination, and the mutex and
+    * condvar, which belong to the *object* rather than to the payload
+    * being moved into it. A struct copy would overwrite dst's live
+    * primitives with src's — including the one currently held on this
+    * very line — and destroy them in finish() as if they were dst's own.
+    */
+   struct vk_sync saved_base = *_dst;
+   mtx_t saved_mutex = dst->mutex;
+   cnd_t saved_cond = dst->cond;
+   *dst = *src;
+   dst->base = saved_base;
+   dst->mutex = saved_mutex;
+   dst->cond = saved_cond;
+
+   src->state = NVK_HORIZON_SYNC_RESET;
+   src->fence = (horizon_gpu_fence) { 0, 0 };
+   src->chan = NULL;
+   src->signalled_value = 0;
+   src->passed_value = 0;
+
+   /* A payload landed in dst, so anyone waiting on it may now be able
+    * to proceed. src became RESET, which releases nobody. */
+   cnd_broadcast(&dst->cond);
+
+   mtx_unlock(&second->mutex);
+   mtx_unlock(&first->mutex);
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvk_horizon_sync_wait(struct vk_device *device,
+                      struct vk_sync *_sync,
+                      uint64_t wait_value,
+                      enum vk_sync_wait_flags wait_flags,
+                      uint64_t abs_timeout_ns)
+{
+   struct nvk_horizon_sync *sync = to_horizon_sync(_sync);
+
+   /* The absolute-to-relative conversion described in the header. Done
+    * once, before anything blocks, so a clock that moves afterwards
+    * cannot move the deadline.
+    */
+   uint64_t remaining_ns;
+   if (abs_timeout_ns == OS_TIMEOUT_INFINITE) {
+      remaining_ns = HORIZON_GPU_NO_TIMEOUT;
+   } else {
+      uint64_t now = os_time_get_nano();
+      remaining_ns = abs_timeout_ns > now ? abs_timeout_ns - now : 0;
+   }
+
+   horizon_gpu_channel *chan;
+   horizon_gpu_fence fence;
+
+   mtx_lock(&sync->mutex);
+   for (;;) {
+      if (sync->state == NVK_HORIZON_SYNC_SIGNALLED) {
+         mtx_unlock(&sync->mutex);
+         return VK_SUCCESS;
+      }
+
+      /* Timeline use (nvkmd_horizon.h): a value already known to have
+       * completed needs no wait at all. `wait_value` is 0 for binary
+       * use, and passed_value starts at 0, so this is never taken
+       * there. */
+      if (wait_value != 0 && sync->passed_value >= wait_value) {
+         mtx_unlock(&sync->mutex);
+         return VK_SUCCESS;
+      }
+
+      if (sync->state == NVK_HORIZON_SYNC_PENDING)
+         break;
+
+      /* NVK_HORIZON_SYNC_RESET: nothing submitted and nothing signalled
+       * (decision D16).
+       *
+       * This used to return VK_TIMEOUT here and now blocks, because the
+       * old reasoning — "this can only ever become signalled by someone
+       * else, so waiting is waiting for the deadline" — had the right
+       * premise and the wrong conclusion. Someone else *is* allowed to
+       * signal it, or to submit with it: this type advertises CPU_WAIT
+       * and CPU_SIGNAL together, and Vulkan lets one thread wait on a
+       * VkFence another thread is about to use. Reporting a timeout
+       * that has not happened turned that legal pattern into a spurious
+       * failure, and did it instantly even for an infinite wait.
+       *
+       * So: block for the transition, in chunks, until the deadline the
+       * caller actually asked for.
+       */
+      if (remaining_ns == 0) {
+         mtx_unlock(&sync->mutex);
+         return VK_TIMEOUT;
+      }
+
+      uint64_t chunk_ns = NVK_HORIZON_SYNC_WAIT_CHUNK_NS;
+      if (remaining_ns != HORIZON_GPU_NO_TIMEOUT && remaining_ns < chunk_ns)
+         chunk_ns = remaining_ns;
+
+      int r = nvk_horizon_sync_cond_wait_chunk(sync, chunk_ns);
+      if (r == thrd_timedout) {
+         /* Only an expired chunk is subtracted. A broadcast that turns
+          * out to be spurious costs nothing but a re-check, which is
+          * what the loop is for. */
+         if (remaining_ns != HORIZON_GPU_NO_TIMEOUT)
+            remaining_ns -= chunk_ns;
+      } else if (r != thrd_success) {
+         mtx_unlock(&sync->mutex);
+         return vk_errorf(device, VK_ERROR_DEVICE_LOST,
+                          "nvkmd_horizon: cnd_timedwait on a vk_sync "
+                          "failed: %d", r);
+      }
+   }
+
+   /* VK_SYNC_WAIT_PENDING asks only that the operation has been
+    * submitted, not that it has completed — and reaching here means it
+    * has, because that is the condition the loop above exits on.
+    */
+   if (wait_flags & VK_SYNC_WAIT_PENDING) {
+      mtx_unlock(&sync->mutex);
+      return VK_SUCCESS;
+   }
+
+   /* Snapshot and release: the fence wait below can last the whole
+    * remaining timeout, and holding the mutex across it would block the
+    * very signal or submit this object exists to observe. Both fields
+    * are immutable while the state is PENDING — only reset(), move()
+    * and set_fence() change them, and none of those is legal on a sync
+    * with a wait outstanding.
+    */
+   chan = sync->chan;
+   fence = sync->fence;
+   mtx_unlock(&sync->mutex);
+
+   /* channel_wait_fence rather than fence_wait: it re-checks the
+    * channel's error notifier while waiting, so a faulted channel
+    * yields CHANNEL_LOST instead of an eternal timeout.
+    */
+   horizon_gpu_result res =
+      horizon_gpu_channel_wait_fence(chan, fence, remaining_ns);
+   if (res.status == HORIZON_GPU_ERR_TIMEOUT)
+      return VK_TIMEOUT;
+   if (res.status != HORIZON_GPU_OK) {
+      return vk_errorf(device, nvkmd_horizon_result(res),
+                       "horizon_gpu_channel_wait_fence(%" PRIu32 ", %" PRIu32
+                       ") failed: status %d, nv 0x%08" PRIx32,
+                       fence.syncpt_id, fence.threshold,
+                       (int)res.status, res.nv);
+   }
+
+   mtx_lock(&sync->mutex);
+   sync->state = NVK_HORIZON_SYNC_SIGNALLED;
+   /* The fence covers every timeline value up to the one it carries.
+    * Re-read rather than snapshotted: a CPU signal may have raised it
+    * while the fence wait was running. */
+   sync->passed_value = MAX2(sync->passed_value, sync->signalled_value);
+   cnd_broadcast(&sync->cond);
+   mtx_unlock(&sync->mutex);
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvk_horizon_sync_get_value(struct vk_device *device,
+                           struct vk_sync *_sync,
+                           uint64_t *value)
+{
+   struct nvk_horizon_sync *sync = to_horizon_sync(_sync);
+
+   /* Present because nvk_mem_stream calls it (see nvkmd_horizon.h), and
+    * a missing entry here is a call through a NULL pointer rather than
+    * an error the caller could handle.
+    */
+   mtx_lock(&sync->mutex);
+
+   if (sync->state == NVK_HORIZON_SYNC_SIGNALLED) {
+      /* A CPU-side signal completes everything asked of this object. */
+      sync->passed_value = MAX2(sync->passed_value, sync->signalled_value);
+      *value = sync->passed_value;
+      mtx_unlock(&sync->mutex);
+      return VK_SUCCESS;
+   }
+
+   if (sync->state == NVK_HORIZON_SYNC_PENDING) {
+      /* A zero timeout makes channel_wait_fence a poll: it reads the
+       * syncpoint once, finds the deadline already past and reports
+       * TIMEOUT. Used rather than horizon_gpu_fence_poll because this
+       * form also notices a faulted channel, and because it needs no
+       * device pointer — a channel does not hand one out.
+       *
+       * The mutex is held across it, unlike the blocking wait above:
+       * with a zero timeout this is one syncpoint read and returns, so
+       * it cannot hold off a concurrent signal for any measurable time.
+       */
+      horizon_gpu_result res =
+         horizon_gpu_channel_wait_fence(sync->chan, sync->fence, 0);
+      if (res.status == HORIZON_GPU_OK) {
+         sync->passed_value = MAX2(sync->passed_value, sync->signalled_value);
+         sync->state = NVK_HORIZON_SYNC_SIGNALLED;
+         /* Poll or not, this observed the transition, so anyone blocked
+          * on it is entitled to hear about it. */
+         cnd_broadcast(&sync->cond);
+      } else if (res.status != HORIZON_GPU_ERR_TIMEOUT) {
+         VkResult vkr =
+            vk_errorf(device, nvkmd_horizon_result(res),
+                      "horizon_gpu_channel_wait_fence(%" PRIu32 ", %"
+                      PRIu32 ", poll) failed: status %d, nv 0x%08" PRIx32,
+                      sync->fence.syncpt_id, sync->fence.threshold,
+                      (int)res.status, res.nv);
+         mtx_unlock(&sync->mutex);
+         return vkr;
+      }
+   }
+
+   *value = sync->passed_value;
+   mtx_unlock(&sync->mutex);
+   return VK_SUCCESS;
+}
+
+const struct vk_sync_type nvk_horizon_sync_type = {
+   .size = sizeof(struct nvk_horizon_sync),
+   .features = VK_SYNC_FEATURE_BINARY |
+               VK_SYNC_FEATURE_GPU_WAIT |
+               /* The runtime's timeline emulation requires this of the
+                * type it is built on (vk_sync_timeline.c:51-60), and
+                * vk_sync.c:74 requires GPU_WAIT alongside it. Both
+                * checks are asserts, so leaving it out was silent in
+                * this NDEBUG build and an abort in vkCreateDevice in a
+                * debug one.
+                *
+                * It is also true: nvkmd_horizon_ctx_wait takes a
+                * wait_count and waits on every entry, so more than one
+                * sync in a submit is a case it already handles.
+                */
+               VK_SYNC_FEATURE_GPU_MULTI_WAIT |
+               VK_SYNC_FEATURE_CPU_WAIT |
+               VK_SYNC_FEATURE_CPU_RESET |
+               VK_SYNC_FEATURE_CPU_SIGNAL |
+               VK_SYNC_FEATURE_WAIT_PENDING,
+   .init = nvk_horizon_sync_init,
+   .finish = nvk_horizon_sync_finish,
+   .signal = nvk_horizon_sync_signal,
+   .reset = nvk_horizon_sync_reset,
+   .move = nvk_horizon_sync_move,
+   .wait = nvk_horizon_sync_wait,
+   .get_value = nvk_horizon_sync_get_value,
+   /* No import/export: there is no dma-buf, no sync file and no fd on
+    * this platform to carry one through. wait_many is left to the
+    * runtime's emulation over wait(), which is correct and is not on
+    * any path this phase measures.
+    */
+};
+
+void
+nvk_horizon_sync_set_fence(struct vk_sync *_sync,
+                           horizon_gpu_channel *chan,
+                           horizon_gpu_fence fence,
+                           uint64_t signal_value)
+{
+   struct nvk_horizon_sync *sync = to_horizon_sync(_sync);
+
+   mtx_lock(&sync->mutex);
+   sync->chan = chan;
+   sync->fence = fence;
+   sync->signalled_value = signal_value;
+   sync->state = NVK_HORIZON_SYNC_PENDING;
+   /* The other transition a waiter blocks for (D16): a thread already
+    * inside vkWaitForFences when this submit happens must now move on
+    * to waiting for the fence itself, rather than sit out its whole
+    * timeout on a sync that has one. */
+   cnd_broadcast(&sync->cond);
+   mtx_unlock(&sync->mutex);
+}
