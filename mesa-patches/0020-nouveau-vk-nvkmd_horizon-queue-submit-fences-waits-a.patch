 /*
  * The Horizon OS kernel-mode-driver backend.
@@ -54,6 +57,19 @@ struct nvkmd_horizon_pdev {
     */
    simple_mtx_t mutex;
    uint32_t dev_refcnt;
+
+   /* NULL-terminated, as nvkmd_pdev::sync_types wants. Owned here so
+    * the list outlives no one and is not a global.
+    *
+    * Two entries, not one. NVK advertises KHR_timeline_semaphore and
+    * timelineSemaphore unconditionally, so a timeline type has to be in
+    * this list or vkCreateSemaphore fails to find one for every timeline
+    * semaphore an application asks for. The syncpoint fence is binary,
+    * so the timeline is the runtime's emulation over it — which is what
+    * the nouveau backend does too when the kernel has no timeline.
+    */
+   struct vk_sync_timeline_type timeline_sync_type;
+   const struct vk_sync_type *sync_types[3];
 };
 
 NVKMD_DECL_SUBCLASS(pdev, horizon);
@@ -90,6 +106,95 @@ struct nvkmd_horizon_va {
 
 NVKMD_DECL_SUBCLASS(va, horizon);
 
+struct nvkmd_horizon_ctx {
+   struct nvkmd_ctx base;
+
+   horizon_gpu_channel *chan;
+
+   /* The fence of the most recent submit on this channel. Every submit
+    * carries one syncpoint increment, so this is "when everything
+    * submitted so far has completed" — which is exactly what a signal
+    * means.
+    */
+   horizon_gpu_fence last_fence;
+   bool has_fence;
+};
+
+NVKMD_DECL_SUBCLASS(ctx, horizon);
+
+/* The vk_sync type — decision D11, native over syncpoints. See
+ * nvkmd_horizon_sync.c for why, and for how D8's clock question is
+ * handled in one place.
+ */
+enum nvk_horizon_sync_state {
+   NVK_HORIZON_SYNC_RESET,
+   NVK_HORIZON_SYNC_PENDING,
+   NVK_HORIZON_SYNC_SIGNALLED,
+};
+
+struct nvk_horizon_sync {
+   struct vk_sync base;
+
+   /* Every field below is shared state, and this type advertises
+    * CPU_WAIT alongside CPU_SIGNAL — so Vulkan permits one thread to
+    * wait on this object while another submits with it or signals it,
+    * and the wait has to be able to observe that transition rather than
+    * sample it once.
+    *
+    * `cond` is broadcast whenever the state becomes reachable to a
+    * waiter: on a CPU signal, on a submit attaching a fence, and on a
+    * move that lands a payload here. Not on reset, which makes the
+    * object *less* reachable and has no waiter to release.
+    *
+    * mtx_t/cnd_t rather than simple_mtx_t because a waiter has to
+    * suspend on a condition, which simple_mtx has no counterpart for.
+    * The primitives are verified on this platform rather than assumed:
+    * t_threads exercises cnd_wait, cnd_signal, cnd_broadcast and
+    * cnd_timedwait against their deadlines and passed 67/67 on
+    * console.
+    */
+   mtx_t mutex;
+   cnd_t cond;
+
+   enum nvk_horizon_sync_state state;
+   horizon_gpu_fence fence;
+   /* Borrowed from the context that signalled this object; waits go
+    * through the channel so a faulted one is reported rather than
+    * waited on forever.
+    */
+   horizon_gpu_channel *chan;
+
+   /* Timeline bookkeeping.
+    *
+    * nvk_mem_stream_init creates its stream sync on sync_types[0] with
+    * VK_SYNC_IS_TIMELINE and then calls vk_sync_get_value() on it. On
+    * nouveau that type is a DRM syncobj, which is binary *and* timeline;
+    * here it is this one, which is binary. The runtime's check is an
+    * assert and this is a -DNDEBUG build, so the mismatch does not
+    * surface as an error — vk_sync_get_value calls type->get_value with
+    * no NULL check, and a missing one is a jump to zero.
+    *
+    * `signalled` is the timeline value `fence` will complete; `passed`
+    * is the largest value known to have completed. Every signal on one
+    * of these comes from one channel and syncpoints are monotonic, so
+    * the latest fence covers every earlier value and one pair is enough.
+    */
+   uint64_t signalled_value;
+   uint64_t passed_value;
+};
+
+extern const struct vk_sync_type nvk_horizon_sync_type;
+
+void nvk_horizon_sync_set_fence(struct vk_sync *sync,
+                                horizon_gpu_channel *chan,
+                                horizon_gpu_fence fence,
+                                uint64_t signal_value);
+
+VkResult nvkmd_horizon_create_ctx(struct nvkmd_dev *dev,
+                                  struct vk_object_base *log_obj,
+                                  enum nvkmd_engines engines,
+                                  struct nvkmd_ctx **ctx_out);
+
 VkResult nvkmd_horizon_create_pdev(struct vk_object_base *log_obj,
                                    enum nvk_debug debug_flags,
                                    struct nvkmd_pdev **pdev_out);
diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c
new file mode 100644
index 00000000000..a9643a4731b
--- /dev/null
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c
@@ -0,0 +1,375 @@
+/*
+ * Copyright (c) mesa-nvk-horizon contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "nvkmd_horizon.h"
+
+#include "util/stack_array.h"
+
+#include "vk_log.h"
+#include "vk_sync.h"
+
+#include "util/log.h"
+#include "util/macros.h"
+#include "util/os_time.h"
+#include "util/u_memory.h"
+
+#include <inttypes.h>
+
+static void
+nvkmd_horizon_ctx_destroy(struct nvkmd_ctx *_ctx)
+{
+   struct nvkmd_horizon_ctx *ctx = nvkmd_horizon_ctx(_ctx);
+
+   /* horizon_gpu_channel_destroy fails with ERR_BUSY while submits are
+    * in flight. nvkmd's contract is that the queue is idle before the
+    * context goes away — vkDestroyDevice waits — so waiting again here
+    * would be the unconditional stall rejected design 6 forbids. It is
+    * reported instead, because a busy channel at destroy time is a
+    * driver bug and should be visible.
+    */
+   horizon_gpu_result res = horizon_gpu_channel_destroy(ctx->chan);
+   if (res.status != HORIZON_GPU_OK) {
+      mesa_loge("horizon_gpu_channel_destroy failed: status %d, "
+                "nv 0x%08" PRIx32, (int)res.status, res.nv);
+      return;
+   }
+
+   FREE(ctx);
+}
+
+static VkResult
+nvkmd_horizon_ctx_wait(struct nvkmd_ctx *_ctx,
+                       struct vk_object_base *log_obj,
+                       uint32_t wait_count,
+                       const struct vk_sync_wait *waits)
+{
+   struct nvkmd_horizon_ctx *ctx = nvkmd_horizon_ctx(_ctx);
+
+   /* A GPU-side wait is what this should be: the channel should stall on
+    * the syncpoint rather than the CPU stalling on it. The methods that
+    * do that (the host's SYNCPOINT/SEMAPHORE acquire) are Phase 5 work —
+    * this backend has no command-stream builder yet, and inventing one
+    * here would be the wrong place for it.
+    *
+    * So the wait happens on the CPU, and that is stated rather than
+    * hidden. It is NOT the thing rejected design 6 forbids: this runs
+    * only when the application asked one submission to wait for another,
+    * never after every submit, and never to make something else appear
+    * to work.
+    */
+   for (uint32_t i = 0; i < wait_count; i++) {
+      const struct vk_sync_type *type = waits[i].sync->type;
+      assert(type->wait != NULL);
+
+      /* NULL device: the sync type's wait() uses it only to build a
+       * vk_errorf, and nvkmd has no vk_device to hand it — the layer
+       * below the driver deliberately does not know about one.
+       */
+      VkResult result = type->wait(NULL, waits[i].sync, waits[i].wait_value,
+                                   VK_SYNC_WAIT_COMPLETE,
+                                   OS_TIMEOUT_INFINITE);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_horizon_ctx_exec(struct nvkmd_ctx *_ctx,
+                       struct vk_object_base *log_obj,
+                       uint32_t exec_count,
+                       const struct nvkmd_ctx_exec *execs)
+{
+   struct nvkmd_horizon_ctx *ctx = nvkmd_horizon_ctx(_ctx);
+
+   if (exec_count == 0)
+      return VK_SUCCESS;
+
+   /* ONE SUBMIT, NOT A RUN OF THEM.
+    *
+    * An earlier version of this split the execs into runs whenever
+    * nvkmd's per-entry no_prefetch flag changed, because nvkmd carries
+    * that flag per entry and horizon_gpu_submit takes it per submit.
+    * That was Phase 4 step 1's "extension 2", and it turns out not to
+    * exist: horizon_gpu's only working submit mode,
+    * HORIZON_GPU_SUBMIT_DEFAULT, is already NOT_MAIN | NO_PREFETCH
+    * (submit.h:39). There is no prefetching alternative to select —
+    * the other value is the R3 experiment that failed on hardware — so
+    * every entry already gets the conservative behaviour, and an entry
+    * asking for no_prefetch = false simply does not get an
+    * optimisation. Splitting bought nothing but extra kickoffs.
+    *
+    * Removing it also removes a stack overflow. The runs were built in
+    * a fixed 16-element array, and the `incomplete` flag — an entry
+    * that ends mid-method, whose continuation must land in the same
+    * submit — suppressed the flush that capped it. Seventeen
+    * consecutive incomplete entries wrote spans[16] past the end of a
+    * stack array and then never matched the `n == ARRAY_SIZE(spans)`
+    * test again, so it kept going. Found by reading, not by running:
+    * NVK is unlikely to emit that many, which is what would have made
+    * it a bad bug rather than an obvious one.
+    *
+    * horizon_gpu_submit takes any number of spans and reports BUSY on a
+    * full ring rather than truncating, so there is nothing to cap.
+    */
+   STACK_ARRAY(horizon_gpu_cmd_span, spans, exec_count);
+   if (spans == NULL)
+      return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   for (uint32_t i = 0; i < exec_count; i++) {
+      /* A GPFIFO entry counts dwords, and nvkmd counts bytes. A size
+       * that is not a multiple of four would silently lose the last
+       * bytes of a push — the submit would succeed and the command
+       * stream would be truncated mid-method, which the GPU reports
+       * much later as a channel fault with no obvious cause. Refused
+       * here instead, where the cause is still in view.
+       */
+      if (execs[i].size_B % 4 != 0) {
+         STACK_ARRAY_FINISH(spans);
+         return vk_errorf(log_obj, VK_ERROR_UNKNOWN,
+                          "nvkmd_horizon: push %" PRIu32 " is %" PRIu32
+                          " bytes, not a whole number of dwords",
+                          i, execs[i].size_B);
+      }
+
+      /* The other two ways the same truncation happens, which the check
+       * above alone does not catch. Both are asserts in the nouveau
+       * backend (nvkmd_nouveau_ctx.c:198-199), where an assert is enough
+       * because that path hands the values to a kernel that validates
+       * them; here they go into a GPFIFO entry whose fields simply
+       * truncate.
+       *
+       * A GPFIFO entry carries the address in GP_ENTRY0_GET | ENTRY1_GET_HI
+       * with the low two bits unavailable, and the length as a 21-bit
+       * dword count (envytools gf100+ GPFIFO entry format). So an address
+       * that is not dword-aligned loses its low bits, and a push of 2^21
+       * dwords or more wraps its count — the GPU then executes a stream
+       * that ends mid-method and reports it much later as a channel fault
+       * with no obvious cause. That is exactly the failure this check
+       * exists to prevent, so it should cover all three doors, not one.
+       */
+      if (execs[i].addr % 4 != 0) {
+         STACK_ARRAY_FINISH(spans);
+         return vk_errorf(log_obj, VK_ERROR_UNKNOWN,
+                          "nvkmd_horizon: push %" PRIu32 " is at 0x%" PRIx64
+                          ", which is not dword-aligned", i, execs[i].addr);
+      }
+
+      if (execs[i].size_B >= (UINT32_C(1) << 23)) {
+         STACK_ARRAY_FINISH(spans);
+         return vk_errorf(log_obj, VK_ERROR_UNKNOWN,
+                          "nvkmd_horizon: push %" PRIu32 " is %" PRIu32
+                          " bytes, over the 8 MiB a GPFIFO entry's 21-bit "
+                          "dword count can express", i, execs[i].size_B);
+      }
+
+      spans[i].gpu_va = execs[i].addr;
+      spans[i].num_dwords = execs[i].size_B / 4;
+   }
+
+   horizon_gpu_fence fence;
+   horizon_gpu_result res =
+      horizon_gpu_submit(ctx->chan, spans, exec_count,
+                         HORIZON_GPU_SUBMIT_DEFAULT, &fence);
+   STACK_ARRAY_FINISH(spans);
+
+   if (res.status != HORIZON_GPU_OK) {
+      return vk_errorf(log_obj, nvkmd_horizon_result(res),
+                       "horizon_gpu_submit(%" PRIu32 " spans) failed: "
+                       "status %d, nv 0x%08" PRIx32,
+                       exec_count, (int)res.status, res.nv);
+   }
+
+   ctx->last_fence = fence;
+   ctx->has_fence = true;
+
+   /* No wait here. The submit is asynchronous and stays that way:
+    * rejected design 6 is a property held from the first line, not
+    * retrofitted.
+    */
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_horizon_ctx_bind(struct nvkmd_ctx *_ctx,
+                       struct vk_object_base *log_obj,
+                       uint32_t bind_count,
+                       const struct nvkmd_ctx_bind *binds)
+{
+   /* On a DRM backend a bind goes through the kernel's VM_BIND queue and
+    * is ordered against the channel's work. Horizon has no such queue:
+    * NVGPU_AS_IOCTL_MAP_BUFFER_EX is synchronous and takes effect when
+    * it returns. So a bind is performed immediately, through the same
+    * VA operations nvkmd_va exposes.
+    *
+    * That is stricter than the interface requires, not looser: the
+    * mapping is in place before this call returns, so anything
+    * submitted afterwards sees it.
+    */
+   for (uint32_t i = 0; i < bind_count; i++) {
+      const struct nvkmd_ctx_bind *b = &binds[i];
+      VkResult result;
+
+      if (b->op == NVKMD_BIND_OP_BIND) {
+         result = b->va->ops->bind_mem(b->va, log_obj, b->va_offset_B,
+                                       b->mem, b->mem_offset_B, b->range_B);
+      } else {
+         result = b->va->ops->unbind(b->va, log_obj, b->va_offset_B,
+                                     b->range_B);
+      }
+
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_horizon_ctx_signal(struct nvkmd_ctx *_ctx,
+                         struct vk_object_base *log_obj,
+                         uint32_t signal_count,
+                         const struct vk_sync_signal *signals)
+{
+   struct nvkmd_horizon_ctx *ctx = nvkmd_horizon_ctx(_ctx);
+
+   /* Every submit already carries one syncpoint increment, so the fence
+    * of the last one is exactly "when everything submitted so far has
+    * completed" — which is what these signals mean.
+    *
+    * With nothing submitted there is nothing to wait for, so a
+    * fence-only submit is issued rather than signalling on the CPU: the
+    * signal must still be ordered after any earlier work on this
+    * channel, and only the channel can say that.
+    */
+   if (!ctx->has_fence) {
+      horizon_gpu_fence fence;
+      horizon_gpu_result res =
+         horizon_gpu_submit(ctx->chan, NULL, 0,
+                            HORIZON_GPU_SUBMIT_DEFAULT, &fence);
+      if (res.status != HORIZON_GPU_OK) {
+         return vk_errorf(log_obj, nvkmd_horizon_result(res),
+                          "horizon_gpu_submit(fence only) failed: "
+                          "status %d, nv 0x%08" PRIx32,
+                          (int)res.status, res.nv);
+      }
+      ctx->last_fence = fence;
+      ctx->has_fence = true;
+   }
+
+   for (uint32_t i = 0; i < signal_count; i++) {
+      /* signal_value matters for a timeline: nvk_mem_stream signals its
+       * stream sync with a monotonically increasing push counter and
+       * then asks for it back through vk_sync_get_value. Dropping it
+       * left that counter at zero forever. */
+      nvk_horizon_sync_set_fence(signals[i].sync, ctx->chan,
+                                 ctx->last_fence, signals[i].signal_value);
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_horizon_ctx_flush(struct nvkmd_ctx *_ctx,
+                        struct vk_object_base *log_obj)
+{
+   /* Nothing to flush. horizon_gpu_submit appends the GPFIFO entries and
+    * kicks off in the same call, so work is running by the time exec()
+    * returns; there is no batching layer here to drain.
+    */
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_horizon_ctx_sync(struct nvkmd_ctx *_ctx,
+                       struct vk_object_base *log_obj)
+{
+   struct nvkmd_horizon_ctx *ctx = nvkmd_horizon_ctx(_ctx);
+
+   if (!ctx->has_fence)
+      return VK_SUCCESS;
+
+   /* This is the one place a CPU stall is unconditional, and it is
+    * where Vulkan says so: sync() is what vkQueueWaitIdle and
+    * vkDeviceWaitIdle are made of.
+    *
+    * No deadline: those two entry points have none. horizon_gpu
+    * implements "no timeout" as a bounded re-checking loop rather than
+    * an infinite kernel wait, and channel_wait_idle re-checks the error
+    * notifier, so a faulted channel ends this rather than hanging.
+    */
+   horizon_gpu_result res =
+      horizon_gpu_channel_wait_idle(ctx->chan, HORIZON_GPU_NO_TIMEOUT);
+   if (res.status != HORIZON_GPU_OK) {
+      return vk_errorf(log_obj, nvkmd_horizon_result(res),
+                       "horizon_gpu_channel_wait_idle failed: status %d, "
+                       "nv 0x%08" PRIx32, (int)res.status, res.nv);
+   }
+
+   return VK_SUCCESS;
+}
+
+const struct nvkmd_ctx_ops nvkmd_horizon_ctx_ops = {
+   .destroy = nvkmd_horizon_ctx_destroy,
+   .wait = nvkmd_horizon_ctx_wait,
+   .exec = nvkmd_horizon_ctx_exec,
+   .bind = nvkmd_horizon_ctx_bind,
+   .signal = nvkmd_horizon_ctx_signal,
+   .flush = nvkmd_horizon_ctx_flush,
+   .sync = nvkmd_horizon_ctx_sync,
+};
+
+VkResult
+nvkmd_horizon_create_ctx(struct nvkmd_dev *_dev,
+                         struct vk_object_base *log_obj,
+                         enum nvkmd_engines engines,
+                         struct nvkmd_ctx **ctx_out)
+{
+   struct nvkmd_horizon_dev *dev = nvkmd_horizon_dev(_dev);
+
+   struct nvkmd_horizon_ctx *ctx = CALLOC_STRUCT(nvkmd_horizon_ctx);
+   if (ctx == NULL)
+      return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   /* One GPFIFO channel per context. `engines` is not a channel
+    * property here: Horizon binds engines by emitting SET_OBJECT into
+    * the stream (known-risks R7), and horizon_gpu_channel_bind_engines
+    * does all five subchannels at once with the device's *queried*
+    * class numbers. There is no channel that can do 3D but not compute.
+    */
+   horizon_gpu_result res =
+      horizon_gpu_channel_create(dev->gpu, NULL, &ctx->chan);
+   if (res.status != HORIZON_GPU_OK) {
+      FREE(ctx);
+      return vk_errorf(log_obj, nvkmd_horizon_result(res),
+                       "horizon_gpu_channel_create failed: status %d, "
+                       "nv 0x%08" PRIx32, (int)res.status, res.nv);
+   }
+
+   /* Asynchronous: bind_engines submits and returns a fence rather than
+    * waiting for it. The next submit on this channel is ordered after
+    * it by the channel itself, so there is nothing to wait for here.
+    */
+   horizon_gpu_fence bind_fence;
+   res = horizon_gpu_channel_bind_engines(ctx->chan, &bind_fence);
+   if (res.status != HORIZON_GPU_OK) {
+      horizon_gpu_channel_destroy(ctx->chan);
+      FREE(ctx);
+      return vk_errorf(log_obj, nvkmd_horizon_result(res),
+                       "horizon_gpu_channel_bind_engines failed: status %d, "
+                       "nv 0x%08" PRIx32, (int)res.status, res.nv);
+   }
+
+   ctx->last_fence = bind_fence;
+   ctx->has_fence = true;
+
+   ctx->base.ops = &nvkmd_horizon_ctx_ops;
+   ctx->base.dev = _dev;
+
+   *ctx_out = &ctx->base;
+
+   return VK_SUCCESS;
+}
