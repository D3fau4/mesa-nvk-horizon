diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon.h b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon.h
new file mode 100644
index 00000000000..a87949b905d
--- /dev/null
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon.h
@@ -0,0 +1,88 @@
+/*
+ * Copyright (c) mesa-nvk-horizon contributors
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef NVKMD_HORIZON_H
+#define NVKMD_HORIZON_H 1
+
+#include "nvkmd/nvkmd.h"
+
+#include "horizon_gpu/channel.h"
+#include "horizon_gpu/device.h"
+#include "horizon_gpu/memory.h"
+#include "horizon_gpu/result.h"
+#include "horizon_gpu/submit.h"
+#include "horizon_gpu/sync.h"
+#include "horizon_gpu/vm.h"
+
+#include "util/simple_mtx.h"
+
+/*
+ * The Horizon OS kernel-mode-driver backend.
+ *
+ * WHAT IT TALKS TO. horizon_gpu, this project's Vulkan-free GPU layer
+ * over libnx and the `nv` system services. There is no DRM here: no
+ * render node, no /dev/dri, no nouveau uAPI and no GEM handles. Every
+ * object below is backed by an NvMap, a GPU address-space reservation
+ * or a GPFIFO channel, referenced by its own typed handle.
+ *
+ * ONE DEVICE PER PROCESS (decision D9). Horizon's `nv` session is
+ * per process: horizon_gpu_device_create() brings up nvInitialize, the
+ * fence, map and gpu services and one GPU address space, and the GM20B
+ * characteristics can only be queried once that is up. There is
+ * therefore no way to describe the physical device without opening it,
+ * which is what nouveau does by opening the render node a second time
+ * (nvkmd_nouveau_dev.c:40).
+ *
+ * So the pdev owns the horizon_gpu_device and every nvkmd_dev created
+ * from it shares that one, under a reference count. Vulkan permits
+ * several VkDevices from one VkPhysicalDevice; they share the GPU
+ * address space, which is harmless because every VA in it is handed
+ * out by horizon_gpu_vm_reserve() and no two reservations overlap.
+ */
+
+struct nvkmd_horizon_pdev {
+   struct nvkmd_pdev base;
+
+   horizon_gpu_device *gpu;
+   horizon_gpu_device_info gpu_info;
+
+   /* Guards refcnt. The pdev outlives every dev, so the device itself
+    * is only destroyed in nvkmd_horizon_pdev_destroy; the count exists
+    * to catch a dev outliving the pdev, which would be a driver bug
+    * rather than an application one.
+    */
+   simple_mtx_t mutex;
+   uint32_t dev_refcnt;
+};
+
+NVKMD_DECL_SUBCLASS(pdev, horizon);
+
+struct nvkmd_horizon_dev {
+   struct nvkmd_dev base;
+
+   /* Borrowed from the pdev; not owned. See the header comment. */
+   horizon_gpu_device *gpu;
+};
+
+NVKMD_DECL_SUBCLASS(dev, horizon);
+
+VkResult nvkmd_horizon_create_pdev(struct vk_object_base *log_obj,
+                                   enum nvk_debug debug_flags,
+                                   struct nvkmd_pdev **pdev_out);
+
+VkResult nvkmd_horizon_create_dev(struct nvkmd_pdev *pdev,
+                                  struct vk_object_base *log_obj,
+                                  struct nvkmd_dev **dev_out);
+
+/* horizon_gpu_result -> VkResult, in one place.
+ *
+ * The mapping is deliberately narrow: horizon_gpu reports what failed,
+ * and Vulkan has three shapes of failure a driver may return from these
+ * paths. Anything that is not out-of-memory and not a timeout is
+ * VK_ERROR_UNKNOWN rather than a guess, and the caller logs the
+ * horizon_gpu result alongside it so the real reason is not lost.
+ */
+VkResult nvkmd_horizon_result(horizon_gpu_result res);
+
+#endif /* NVKMD_HORIZON_H */
diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_dev.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_dev.c
new file mode 100644
index 00000000000..14696c089fa
--- /dev/null
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_dev.c
@@ -0,0 +1,158 @@
+/*
+ * Copyright (c) mesa-nvk-horizon contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "nvkmd_horizon.h"
+
+#include "vk_log.h"
+
+#include "util/log.h"
+#include "util/macros.h"
+#include "util/u_memory.h"
+
+#include <inttypes.h>
+
+static void
+nvkmd_horizon_dev_destroy(struct nvkmd_dev *_dev)
+{
+   struct nvkmd_horizon_dev *dev = nvkmd_horizon_dev(_dev);
+   struct nvkmd_horizon_pdev *pdev = nvkmd_horizon_pdev(_dev->pdev);
+
+   simple_mtx_destroy(&_dev->mems_mutex);
+
+   simple_mtx_lock(&pdev->mutex);
+   assert(pdev->dev_refcnt > 0);
+   pdev->dev_refcnt--;
+   simple_mtx_unlock(&pdev->mutex);
+
+   /* The horizon_gpu_device itself is not destroyed here: it is the
+    * pdev's, shared by every dev created from it (decision D9, see
+    * nvkmd_horizon.h).
+    */
+   FREE(dev);
+}
+
+static uint64_t
+nvkmd_horizon_dev_get_gpu_timestamp(struct nvkmd_dev *_dev)
+{
+   /* Milestone item 8. horizon_gpu has no GPU timestamp query yet —
+    * it is one of the six extensions Phase 4 step 1 enumerated — and
+    * the only caller is vkGetCalibratedTimestampsKHR, which NVK gates
+    * on VK_EXT_calibrated_timestamps. Returning zero here would be a
+    * wrong answer rather than a missing one, so this is deliberately
+    * unreachable until the extension exists.
+    */
+   UNREACHABLE("GPU timestamps are not implemented on Horizon yet");
+}
+
+static int
+nvkmd_horizon_dev_get_drm_fd(struct nvkmd_dev *_dev)
+{
+   /* No DRM, and nothing invented to look like one. */
+   return -1;
+}
+
+static VkResult
+nvkmd_horizon_dev_alloc_mem(struct nvkmd_dev *_dev,
+                            struct vk_object_base *log_obj,
+                            uint64_t size_B, uint64_t align_B,
+                            enum nvkmd_mem_flags flags,
+                            struct nvkmd_mem **mem_out)
+{
+   return vk_errorf(log_obj, VK_ERROR_FEATURE_NOT_PRESENT,
+                    "nvkmd_horizon: memory objects are milestone item 3");
+}
+
+static VkResult
+nvkmd_horizon_dev_alloc_va(struct nvkmd_dev *_dev,
+                           struct vk_object_base *log_obj,
+                           enum nvkmd_va_flags flags, uint8_t pte_kind,
+                           uint64_t size_B, uint64_t align_B,
+                           uint64_t fixed_addr, struct nvkmd_va **va_out)
+{
+   return vk_errorf(log_obj, VK_ERROR_FEATURE_NOT_PRESENT,
+                    "nvkmd_horizon: the VA heap is milestone item 4");
+}
+
+static VkResult
+nvkmd_horizon_dev_create_ctx(struct nvkmd_dev *_dev,
+                             struct vk_object_base *log_obj,
+                             enum nvkmd_engines engines,
+                             struct nvkmd_ctx **ctx_out)
+{
+   return vk_errorf(log_obj, VK_ERROR_FEATURE_NOT_PRESENT,
+                    "nvkmd_horizon: contexts are milestone item 6");
+}
+
+const struct nvkmd_dev_ops nvkmd_horizon_dev_ops = {
+   .destroy = nvkmd_horizon_dev_destroy,
+   .get_gpu_timestamp = nvkmd_horizon_dev_get_gpu_timestamp,
+   .get_drm_fd = nvkmd_horizon_dev_get_drm_fd,
+   .alloc_mem = nvkmd_horizon_dev_alloc_mem,
+   /* alloc_tiled_mem and import_dma_buf are left NULL on purpose:
+    * nvkmd_info says has_alloc_tiled and has_dma_buf are false, and
+    * nvkmd.h's inline wrappers assert on that before dispatching, so a
+    * caller that ignored the capability faults here rather than
+    * silently getting a wrong allocation.
+    */
+   .alloc_va = nvkmd_horizon_dev_alloc_va,
+   .create_ctx = nvkmd_horizon_dev_create_ctx,
+};
+
+VkResult
+nvkmd_horizon_create_dev(struct nvkmd_pdev *_pdev,
+                         struct vk_object_base *log_obj,
+                         struct nvkmd_dev **dev_out)
+{
+   struct nvkmd_horizon_pdev *pdev = nvkmd_horizon_pdev(_pdev);
+
+   struct nvkmd_horizon_dev *dev = CALLOC_STRUCT(nvkmd_horizon_dev);
+   if (dev == NULL)
+      return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   dev->base.ops = &nvkmd_horizon_dev_ops;
+   dev->base.pdev = _pdev;
+   dev->gpu = pdev->gpu;
+
+   /* The usable GPU VA range, taken from what the address space
+    * actually reported rather than from a constant. horizon_gpu returns
+    * two regions — small-page and big-page — and nvkmd wants one
+    * interval, so this is the span they cover between them.
+    *
+    * va_start is deliberately not zero: address zero has to stay
+    * unmapped so a null GPU pointer faults instead of reading whatever
+    * happens to be mapped there.
+    */
+   const horizon_gpu_va_region_info *small = &pdev->gpu_info.va_regions[0];
+   const horizon_gpu_va_region_info *big = &pdev->gpu_info.va_regions[1];
+
+   uint64_t start = MIN2(small->base, big->base);
+   uint64_t small_end = small->base + small->pages * small->page_size;
+   uint64_t big_end = big->base + big->pages * big->page_size;
+   uint64_t end = MAX2(small_end, big_end);
+
+   if (start == 0)
+      start = small->page_size;
+
+   if (start >= end) {
+      FREE(dev);
+      return vk_errorf(log_obj, VK_ERROR_INITIALIZATION_FAILED,
+                       "nvkmd_horizon: the address space reported an empty "
+                       "VA range (0x%" PRIx64 "..0x%" PRIx64 ")", start, end);
+   }
+
+   dev->base.va_start = start;
+   dev->base.va_end = end;
+
+   list_inithead(&dev->base.mems);
+   simple_mtx_init(&dev->base.mems_mutex, mtx_plain);
+
+   simple_mtx_lock(&pdev->mutex);
+   pdev->dev_refcnt++;
+   simple_mtx_unlock(&pdev->mutex);
+
+   *dev_out = &dev->base;
+
+   return VK_SUCCESS;
+}
diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_enumerate.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_enumerate.c
new file mode 100644
index 00000000000..dc0ef2b8b88
--- /dev/null
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_enumerate.c
@@ -0,0 +1,85 @@
+/*
+ * Copyright (c) mesa-nvk-horizon contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * Physical-device enumeration without DRM.
+ *
+ * The Vulkan runtime offers two hooks: try_create_for_drm, which walks
+ * drmGetDevices2 and calls back per device, and enumerate, which hands
+ * the whole job to the driver (vk_instance.h). Horizon has no DRM, so
+ * this uses the second one — nothing here fabricates a render node, a
+ * drmDevice or a file descriptor to satisfy the first.
+ *
+ * There is exactly one GPU: GM20B is part of the SoC. So enumeration is
+ * "open the nv services; if that works there is one device".
+ */
+
+#include "nvkmd_horizon.h"
+
+#include "nvk_instance.h"
+#include "nvk_physical_device.h"
+
+#include "util/log.h"
+#include "vk_alloc.h"
+#include "vk_log.h"
+#include "vk_physical_device.h"
+
+VkResult
+nvk_horizon_enumerate_physical_devices(struct vk_instance *_instance)
+{
+   struct nvk_instance *instance = (struct nvk_instance *)_instance;
+
+   struct nvkmd_pdev *nvkmd;
+   VkResult result = nvkmd_horizon_create_pdev(&instance->vk.base,
+                                               instance->debug_flags,
+                                               &nvkmd);
+   if (result != VK_SUCCESS) {
+      /* No GPU is not an error: a process that cannot reach the nv
+       * services simply has no Vulkan device, and Vulkan says that is
+       * an empty list rather than a failed call.
+       *
+       * Said out loud, though. Returning an empty list silently is
+       * what turned the first hardware run of the Phase 4 sequence
+       * into a console round trip: vkEnumeratePhysicalDevices returned
+       * VK_SUCCESS with a count of zero and nothing anywhere said why.
+       */
+      if (result == VK_ERROR_INCOMPATIBLE_DRIVER) {
+         mesa_logw("nvkmd_horizon: no GPU — the nv services could not "
+                   "be opened. A process without the nv permissions "
+                   "has no Vulkan device.");
+         return VK_SUCCESS;
+      }
+      return result;
+   }
+
+   struct vk_physical_device *pdev;
+   result = nvk_create_physical_device(_instance, nvkmd, &pdev);
+   if (result != VK_SUCCESS) {
+      /* nvk_create_physical_device owns nvkmd on success and destroys
+       * it on every failure path of its own, so there is nothing to
+       * free here.
+       */
+      if (result == VK_ERROR_INCOMPATIBLE_DRIVER) {
+         /* The GPU is there and NVK declined it. On this chip that is
+          * almost always nvk_is_conformant(), whose first line is
+          * "Tegra is not currently supported" — GM20B is
+          * NV_DEVICE_TYPE_SOC, so NVK refuses unless the application
+          * asks for it. Under NDEBUG that check prints nothing at all,
+          * which is exactly the case worth naming here.
+          */
+         mesa_logw("nvkmd_horizon: the GPU was found and NVK declined "
+                   "it (VK_ERROR_INCOMPATIBLE_DRIVER). NVK is not "
+                   "conformant on Tegra; set "
+                   "NVK_I_WANT_A_BROKEN_VULKAN_DRIVER=1 to proceed "
+                   "anyway.");
+         return VK_SUCCESS;
+      }
+      return result;
+   }
+
+   list_addtail(&pdev->link, &_instance->physical_devices.list);
+
+   return VK_SUCCESS;
+}
diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c
new file mode 100644
index 00000000000..dfb1bdbb6ef
--- /dev/null
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c
@@ -0,0 +1,304 @@
+/*
+ * Copyright (c) mesa-nvk-horizon contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "nvkmd_horizon.h"
+
+#include "vulkan/vulkan_core.h"
+#include "vk_log.h"
+
+#include "util/cache_ops.h"
+#include "util/log.h"
+#include "util/macros.h"
+#include "util/u_memory.h"
+
+#include "util/u_math.h"
+
+#include <inttypes.h>
+#include <string.h>
+
+VkResult
+nvkmd_horizon_result(horizon_gpu_result res)
+{
+   switch (res.status) {
+   case HORIZON_GPU_OK:
+      return VK_SUCCESS;
+   case HORIZON_GPU_ERR_OUT_OF_MEMORY:
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   case HORIZON_GPU_ERR_VA_EXHAUSTED:
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   case HORIZON_GPU_ERR_TIMEOUT:
+      return VK_TIMEOUT;
+   case HORIZON_GPU_ERR_CHANNEL_LOST:
+      return VK_ERROR_DEVICE_LOST;
+   case HORIZON_GPU_ERR_UNSUPPORTED:
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   default:
+      /* INVALID_ARG, OVERFLOW, NV, BUSY, LEAK and STATE are all driver
+       * bugs or service failures with no Vulkan equivalent. They are
+       * reported as unknown rather than mapped to a plausible-looking
+       * error, and every call site logs the horizon_gpu status and the
+       * libnx Result beside it so the real reason survives.
+       */
+      return VK_ERROR_UNKNOWN;
+   }
+}
+
+/* GM20B's chipset number, as NVK spells chipsets.
+ *
+ * nv_device_info::chipset is the NVIDIA chip id: 0x12b is GM20B, which
+ * is what `sm_for_chipset` in nv_device_info_chipset.c maps to SM 53 and
+ * what nouveau reports for a Tegra X1. It is derived here from the
+ * *queried* architecture and implementation rather than written down:
+ * horizon_gpu reports arch = 0x120 (NVGPU_GPU_ARCH_GM200) and impl = 0xb
+ * (NVGPU_GPU_IMPL_GM20B), and the chipset number is the two nibbles
+ * combined, exactly as Linux's nvgpu and nouveau agree.
+ */
+static uint16_t
+chipset_from_arch_impl(uint32_t arch, uint32_t impl)
+{
+   return (uint16_t)((arch & 0xff0) | (impl & 0xf));
+}
+
+static void
+nvkmd_horizon_pdev_destroy(struct nvkmd_pdev *_pdev)
+{
+   struct nvkmd_horizon_pdev *pdev = nvkmd_horizon_pdev(_pdev);
+
+   /* A dev outliving its pdev is a driver bug, not an application one:
+    * the Vulkan runtime destroys every VkDevice before the instance
+    * that owns the VkPhysicalDevice. Saying so is better than tearing
+    * down the nv session under a device that is still using it.
+    */
+   assert(pdev->dev_refcnt == 0);
+
+   horizon_gpu_result res = horizon_gpu_device_destroy(pdev->gpu);
+   if (res.status != HORIZON_GPU_OK) {
+      /* horizon_gpu_device_destroy fails with ERR_LEAK when a child
+       * object is still alive, and logs each non-zero counter itself.
+       * Nothing was torn down in that case, so the leak is reported
+       * and the device is deliberately not freed a second time.
+       */
+      mesa_loge("horizon_gpu_device_destroy failed: status %d, nv 0x%08" PRIx32,
+                (int)res.status, res.nv);
+   }
+
+   simple_mtx_destroy(&pdev->mutex);
+   FREE(pdev);
+}
+
+static uint64_t
+nvkmd_horizon_pdev_get_vram_used(struct nvkmd_pdev *_pdev)
+{
+   /* The Switch has no VRAM: GM20B is an SoC part and every allocation
+    * comes out of system memory, which is why nvkmd_info::
+    * has_get_vram_used is false and why nvk never calls this. Answering
+    * zero is the truth rather than a placeholder.
+    */
+   return 0;
+}
+
+static int
+nvkmd_horizon_pdev_get_drm_primary_fd(struct nvkmd_pdev *_pdev)
+{
+   /* There is no DRM here, and nothing is invented to pretend
+    * otherwise: no render node, no synthetic descriptor. -1 is what
+    * nvkmd defines as "no fd", and nvk_physical_device.c only uses the
+    * answer to fill drmHasPrimary, which stays false.
+    */
+   return -1;
+}
+
+const struct nvkmd_pdev_ops nvkmd_horizon_pdev_ops = {
+   .destroy = nvkmd_horizon_pdev_destroy,
+   .get_vram_used = nvkmd_horizon_pdev_get_vram_used,
+   .get_drm_primary_fd = nvkmd_horizon_pdev_get_drm_primary_fd,
+   .create_dev = nvkmd_horizon_create_dev,
+};
+
+static void
+fill_dev_info(struct nv_device_info *info,
+              const horizon_gpu_device_info *gpu)
+{
+   memset(info, 0, sizeof(*info));
+
+   /* GM20B is part of the Tegra X1 SoC, not a card on a bus. Saying so
+    * is what makes nv_device_uuid() skip the PCI fields and what tells
+    * nvk there is no VRAM heap.
+    */
+   info->type = NV_DEVICE_TYPE_SOC;
+   info->chipset = chipset_from_arch_impl(gpu->arch, gpu->impl);
+   info->device_id = 0;
+
+   /* chipname comes from the nv services ("gm20b"); it is the same
+    * string nouveau derives, so it is used rather than reconstructed.
+    */
+   snprintf(info->chipset_name, sizeof(info->chipset_name), "%s",
+            gpu->chipname);
+   snprintf(info->device_name, sizeof(info->device_name), "NVIDIA %s",
+            gpu->chipname);
+
+   info->gpc_count = gpu->num_gpc;
+   info->tpc_count = gpu->num_gpc * gpu->num_tpc_per_gpc;
+
+   /* Pure functions of the chipset, shared with the nouveau backend
+    * rather than copied (decision D10): they describe the chip.
+    */
+   info->sm = nv_device_info_sm_for_chipset(info->chipset);
+   info->max_warps_per_mp =
+      nv_device_info_max_warps_per_mp_for_sm(info->sm);
+   info->mp_per_tpc = nv_device_info_mp_per_tpc_for_chipset(info->chipset);
+   nv_device_info_init_shared_mem_sizes(info);
+
+   /* Engine classes, queried from the nv services rather than assumed
+    * from the chipset.
+    */
+   info->cls_copy = gpu->dma_copy_class;
+   info->cls_eng2d = gpu->twod_class;
+   info->cls_eng3d = gpu->threed_class;
+   info->cls_m2mf = gpu->inline_to_memory_class;
+   info->cls_compute = gpu->compute_class;
+   info->cls_gpfifo = gpu->gpfifo_class;
+
+   /* No VRAM and no BAR: an SoC part addressing system memory. nvk
+    * reads vram_size_B only when type != NV_DEVICE_TYPE_SOC.
+    */
+   info->vram_size_B = 0;
+   info->bar_size_B = 0;
+
+   /* The atom size for a non-coherent map: a CPU cache-maintenance
+    * property, not a GPU one.
+    *
+    * This used to be the services' compression page size, on the
+    * reasoning that it is the smallest unit the GPU's memory subsystem
+    * addresses coherently. That is the wrong quantity. nonCoherentAtomSize
+    * bounds what vkFlushMappedMemoryRanges and vkInvalidateMappedMemoryRanges
+    * touch, and those run `dc cvac` / `dc civac` on the CPU — so it has to
+    * be the cache write-back granule, which is what util_cache_granularity()
+    * reads out of CTR_EL0.CWG and what cache_ops.h says a Vulkan driver
+    * should report ("Vulkan drivers should return this as
+    * nonCoherentAtomSize", cache_ops.h:65). The nouveau backend uses
+    * exactly that (nvkmd_nouveau_pdev.c:113).
+    *
+    * The old value was not merely imprecise. GM20B reports a 0x20000
+    * compression page (measured: t_init on console, "compression_page=
+    * 0x20000"), and nvk_device_memory.c:461 rounds a flush range UP to
+    * this number before handing it to the cache ops. A 4 KiB allocation
+    * flushed with VK_WHOLE_SIZE therefore had `dc civac` run across
+    * 128 KiB — 124 KiB past the end of the object, which is a data abort
+    * if the pages beyond it are not mapped.
+    */
+   info->nc_atom_size_B = util_cache_granularity();
+
+   /* Tegra has no separate copy-engine queue exposed through `nv`; work
+    * goes through the one GPFIFO channel. Advertising a transfer queue
+    * would promise a second submission path that does not exist.
+    */
+   info->has_transfer_queue = false;
+
+   /* Zcull is queryable on Horizon but is not read here: it belongs to
+    * the channel, and nothing in Phase 4 uses it. has_zcull_info stays
+    * false, which is what nvk checks before touching zcull_info.
+    */
+   info->has_zcull_info = false;
+}
+
+VkResult
+nvkmd_horizon_create_pdev(struct vk_object_base *log_obj,
+                          enum nvk_debug debug_flags,
+                          struct nvkmd_pdev **pdev_out)
+{
+   struct nvkmd_horizon_pdev *pdev = CALLOC_STRUCT(nvkmd_horizon_pdev);
+   if (pdev == NULL)
+      return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   pdev->base.ops = &nvkmd_horizon_pdev_ops;
+   pdev->base.debug_flags = debug_flags;
+   simple_mtx_init(&pdev->mutex, mtx_plain);
+
+   /* Bringing up the nv services is what makes the GM20B facts
+    * queryable at all — there is no way to describe the device without
+    * opening it. Decision D9: the pdev owns this and every nvkmd_dev
+    * shares it.
+    */
+   horizon_gpu_result res = horizon_gpu_device_create(NULL, &pdev->gpu);
+   if (res.status != HORIZON_GPU_OK) {
+      VkResult vk_res = nvkmd_horizon_result(res);
+      simple_mtx_destroy(&pdev->mutex);
+      FREE(pdev);
+      /* Not a driver failure when the services are simply unavailable:
+       * a process without the nv permissions has no GPU, which is
+       * INCOMPATIBLE_DRIVER rather than an error to propagate.
+       */
+      if (vk_res == VK_ERROR_UNKNOWN)
+         return VK_ERROR_INCOMPATIBLE_DRIVER;
+      return vk_errorf(log_obj, vk_res,
+                       "horizon_gpu_device_create failed: status %d, "
+                       "nv 0x%08" PRIx32, (int)res.status, res.nv);
+   }
+
+   res = horizon_gpu_device_get_info(pdev->gpu, &pdev->gpu_info);
+   if (res.status != HORIZON_GPU_OK) {
+      horizon_gpu_device_destroy(pdev->gpu);
+      simple_mtx_destroy(&pdev->mutex);
+      FREE(pdev);
+      return vk_errorf(log_obj, nvkmd_horizon_result(res),
+                       "horizon_gpu_device_get_info failed: status %d, "
+                       "nv 0x%08" PRIx32, (int)res.status, res.nv);
+   }
+
+   fill_dev_info(&pdev->base.dev_info, &pdev->gpu_info);
+
+   /* What this backend can and cannot do. Each false is a statement
+    * about Horizon, not a gap left for later:
+    *
+    *   has_dma_buf        there is no dma-buf and no DRM to carry one.
+    *                      Sharing between processes on Horizon is a
+    *                      different mechanism entirely (Phase 6).
+    *   has_get_vram_used  there is no VRAM.
+    *   has_alloc_tiled    NvMap allocations carry no PTE kind of their
+    *                      own; the kind is a property of the *mapping*
+    *                      on this platform, applied at
+    *                      horizon_gpu_vm_map time.
+    *   has_map_fixed      NvMap gives back a CPU pointer of its own
+    *                      choosing; there is no mmap(MAP_FIXED).
+    *   has_overmap        follows from has_map_fixed.
+    *   has_compression    the services report a compression page size,
+    *                      but nothing has exercised compressed kinds on
+    *                      this chip yet, and claiming it before it is
+    *                      measured would corrupt images rather than
+    *                      fail.
+    */
+   pdev->base.kmd_info = (struct nvkmd_info) {
+      .has_dma_buf = false,
+      .has_get_vram_used = false,
+      .has_alloc_tiled = false,
+      .has_map_fixed = false,
+      .has_overmap = false,
+      .has_compression = false,
+   };
+
+   /* Bind alignment is the address space's big-page size: a mapping
+    * must start on one, because that is the granularity the GPU MMU
+    * fills. Queried, never assumed — as_big_page_size is what the
+    * address space was actually created with.
+    */
+   pdev->base.bind_align_B = pdev->gpu_info.as_big_page_size;
+
+   /* No DRM device numbers. nvk_physical_device.c only reads these to
+    * fill drmHasRender/drmHasPrimary, which stay false.
+    */
+   pdev->base.drm.render_dev = 0;
+   pdev->base.drm.primary_dev = 0;
+
+   /* Sync types are decision D11 and belong to milestone item 8. Until
+    * then the pdev advertises none, which is a build-visible gap
+    * rather than a silently wrong answer.
+    */
+   pdev->base.sync_types = NULL;
+
+   *pdev_out = &pdev->base;
+
+   return VK_SUCCESS;
+}
