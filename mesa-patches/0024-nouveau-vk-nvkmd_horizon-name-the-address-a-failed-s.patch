From b0a39f9e97860dd157cd8811e310b5f5de4f8430 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 28 Jul 2026 18:10:56 +0000
Subject: [PATCH 24/56] nouveau/vk: nvkmd_horizon, name the address a failed
 submit handed the GPU
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

An MMU fault is the one GPU failure that says nothing on its own here.
nvgpu's error notifier carries the fault type and nothing else, and libnx
exposes no ioctl for the faulting address, so "notifier 31" is all the
kernel will ever tell us. The hardware run of 2026-07-28 reached
vkQueueSubmit and stopped there with exactly that and no way to tell
which of the two live channels it was, let alone which address.

The addresses are ours, though, and so is the map they were meant to be
in. nvkmd_horizon_dev now keeps every live VA on a list, and a failed
submit walks it for each push it submitted, reporting one of three
answers: the VA and binding that contains it, that it is inside a
reservation with nothing bound there, or that no reservation covers it.

The middle answer is the diagnosis for a fault like this, on the spot,
instead of a console round trip per hypothesis.

The submit failure also names its channel now. Two channels are live
during vkQueueSubmit and the message named neither.

mesa-nvk-horizon: Phase 4 — diagnostics for the MMU-fault class of failure
Why: nvgpu's error notifier carries the fault type and nothing else, and
  libnx exposes no ioctl for the faulting address, so without a map of
  our own addresses every MMU fault costs a console round trip per
  hypothesis.
Evidence: the hardware run of 2026-07-28 reached vkQueueSubmit and
  stopped with "notifier 31" and no way to tell which of the two live
  channels faulted, let alone which address.
Upstream: no — this is the Horizon backend's own diagnostic.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 .../vulkan/nvkmd/horizon/nvkmd_horizon.h      |  32 ++++++
 .../vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c  |  31 +++++-
 .../vulkan/nvkmd/horizon/nvkmd_horizon_dev.c  |   4 +
 .../vulkan/nvkmd/horizon/nvkmd_horizon_va.c   | 104 ++++++++++++++++++
 4 files changed, 168 insertions(+), 3 deletions(-)

diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon.h b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon.h
index 63973504f6a..c82f838f654 100644
--- a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon.h
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon.h
@@ -79,6 +79,19 @@ struct nvkmd_horizon_dev {
 
    /* Borrowed from the pdev; not owned. See the header comment. */
    horizon_gpu_device *gpu;
+
+   /* Every live VA of this device, so a GPU address can be named.
+    *
+    * An MMU fault is the one GPU failure that says nothing useful on its
+    * own here: nvgpu's error notifier carries the fault *type* and libnx
+    * exposes no ioctl for the faulting address, so "notifier 31" is all
+    * the kernel will ever tell us. The addresses we handed the GPU are
+    * ours, though, and so is the map they were supposed to be in — this
+    * list is what lets a submit failure answer "was 0x… mapped, and by
+    * what" instead of leaving it to be deduced.
+    */
+   simple_mtx_t va_list_mutex;
+   struct list_head va_list;
 };
 
 NVKMD_DECL_SUBCLASS(dev, horizon);
@@ -102,10 +115,29 @@ struct nvkmd_horizon_va {
     */
    simple_mtx_t mutex;
    struct list_head bindings;
+
+   /* Link in nvkmd_horizon_dev::va_list. */
+   struct list_head dev_link;
 };
 
 NVKMD_DECL_SUBCLASS(va, horizon);
 
+/* Writes "0x<addr> is <where>" into `buf`: the VA and binding that
+ * contains `addr`, or that it is inside a reservation but not bound, or
+ * that no reservation covers it at all. Never fails and always
+ * NUL-terminates — it runs on an error path, where a second failure
+ * would cost the message that explains the first.
+ */
+void nvkmd_horizon_describe_addr(struct nvkmd_horizon_dev *dev,
+                                 uint64_t addr, char *buf, size_t buf_size);
+
+/* Logs every live reservation and what is bound in it, up to `max_lines`
+ * reservations, and says how many were dropped. For addresses this layer
+ * never sees — a buffer address NVK baked into a push — the map is what
+ * places them. */
+void nvkmd_horizon_dump_va_map(struct nvkmd_horizon_dev *dev,
+                               uint32_t max_lines);
+
 struct nvkmd_horizon_ctx {
    struct nvkmd_ctx base;
 
diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c
index a9643a4731b..df58208f702 100644
--- a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c
@@ -177,10 +177,35 @@ nvkmd_horizon_ctx_exec(struct nvkmd_ctx *_ctx,
    STACK_ARRAY_FINISH(spans);
 
    if (res.status != HORIZON_GPU_OK) {
+      /* Name every address this submit handed the GPU, and say where it
+       * sits in our own map.
+       *
+       * The reason this is here and not left to be deduced: an MMU fault
+       * is reported by nvgpu's error notifier as a *type* and nothing
+       * else, and libnx exposes no ioctl for the faulting address, so
+       * the kernel will never tell us which address was bad. What we can
+       * say is which addresses we submitted and whether each one was
+       * mapped — and "0x… is inside VA 0x… but NOTHING IS BOUND there"
+       * is the whole diagnosis, on the spot, instead of a console round
+       * trip per hypothesis.
+       */
+      for (uint32_t i = 0; i < exec_count; i++) {
+         char where[160];
+         nvkmd_horizon_describe_addr(nvkmd_horizon_dev(_ctx->dev),
+                                     execs[i].addr, where, sizeof(where));
+         mesa_loge("nvkmd_horizon: channel %p push %" PRIu32 "/%" PRIu32
+                   ": 0x%" PRIx64 " + 0x%" PRIx32 " bytes — %s",
+                   (void *)ctx->chan, i, exec_count, execs[i].addr,
+                   execs[i].size_B, where);
+      }
+
+      nvkmd_horizon_dump_va_map(nvkmd_horizon_dev(_ctx->dev), 64);
+
       return vk_errorf(log_obj, nvkmd_horizon_result(res),
-                       "horizon_gpu_submit(%" PRIu32 " spans) failed: "
-                       "status %d, nv 0x%08" PRIx32,
-                       exec_count, (int)res.status, res.nv);
+                       "horizon_gpu_submit(%" PRIu32 " spans) on channel %p "
+                       "failed: status %d, nv 0x%08" PRIx32,
+                       exec_count, (void *)ctx->chan,
+                       (int)res.status, res.nv);
    }
 
    ctx->last_fence = fence;
diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_dev.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_dev.c
index f53fd80a2b6..58bdefbde0c 100644
--- a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_dev.c
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_dev.c
@@ -20,6 +20,7 @@ nvkmd_horizon_dev_destroy(struct nvkmd_dev *_dev)
    struct nvkmd_horizon_pdev *pdev = nvkmd_horizon_pdev(_dev->pdev);
 
    simple_mtx_destroy(&_dev->mems_mutex);
+   simple_mtx_destroy(&dev->va_list_mutex);
 
    simple_mtx_lock(&pdev->mutex);
    assert(pdev->dev_refcnt > 0);
@@ -86,6 +87,9 @@ nvkmd_horizon_create_dev(struct nvkmd_pdev *_pdev,
    dev->base.pdev = _pdev;
    dev->gpu = pdev->gpu;
 
+   list_inithead(&dev->va_list);
+   simple_mtx_init(&dev->va_list_mutex, mtx_plain);
+
    /* The usable GPU VA range, taken from what the address space
     * actually reported rather than from a constant. horizon_gpu returns
     * two regions — small-page and big-page — and nvkmd wants one
diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_va.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_va.c
index 884e1cb85b1..e2c800f3f82 100644
--- a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_va.c
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_va.c
@@ -13,6 +13,7 @@
 #include "util/u_memory.h"
 
 #include <inttypes.h>
+#include <stdio.h>
 
 /*
  * nvkmd unbinds by (offset, range) and never hands back the object it
@@ -31,10 +32,109 @@ struct nvkmd_horizon_binding {
    horizon_gpu_mapping *mapping;
 };
 
+void
+nvkmd_horizon_describe_addr(struct nvkmd_horizon_dev *dev, uint64_t addr,
+                            char *buf, size_t buf_size)
+{
+   simple_mtx_lock(&dev->va_list_mutex);
+
+   list_for_each_entry(struct nvkmd_horizon_va, va, &dev->va_list, dev_link) {
+      if (addr < va->base.addr || addr >= va->base.addr + va->base.size_B)
+         continue;
+
+      const uint64_t off = addr - va->base.addr;
+
+      simple_mtx_lock(&va->mutex);
+      list_for_each_entry(struct nvkmd_horizon_binding, b, &va->bindings,
+                          link) {
+         if (off >= b->va_offset_B && off < b->va_offset_B + b->range_B) {
+            snprintf(buf, buf_size,
+                     "inside VA 0x%" PRIx64 "+0x%" PRIx64 ", bound at "
+                     "+0x%" PRIx64 " for 0x%" PRIx64,
+                     va->base.addr, va->base.size_B, b->va_offset_B,
+                     b->range_B);
+            simple_mtx_unlock(&va->mutex);
+            simple_mtx_unlock(&dev->va_list_mutex);
+            return;
+         }
+      }
+      simple_mtx_unlock(&va->mutex);
+
+      /* The reservation exists and the address is in it, but nothing is
+       * bound there. This is the interesting answer: the GPU was given
+       * an address out of a range we own and never mapped. */
+      snprintf(buf, buf_size,
+               "inside VA 0x%" PRIx64 "+0x%" PRIx64 " at +0x%" PRIx64
+               ", but NOTHING IS BOUND there",
+               va->base.addr, va->base.size_B, off);
+      simple_mtx_unlock(&dev->va_list_mutex);
+      return;
+   }
+
+   simple_mtx_unlock(&dev->va_list_mutex);
+   snprintf(buf, buf_size, "in NO reservation of this device");
+}
+
+void
+nvkmd_horizon_dump_va_map(struct nvkmd_horizon_dev *dev, uint32_t max_lines)
+{
+   /* The whole map, not just the addresses nvkmd was handed. A submit
+    * carries addresses this layer never sees — vkCmdFillBuffer writes to
+    * a buffer address baked into the push by NVK — so naming only the
+    * push leaves half the candidates unaccounted for. With the map
+    * printed, any address from any source can be placed by reading.
+    */
+   uint32_t shown = 0, total = 0;
+
+   simple_mtx_lock(&dev->va_list_mutex);
+   list_for_each_entry(struct nvkmd_horizon_va, va, &dev->va_list, dev_link) {
+      total++;
+      if (shown >= max_lines)
+         continue;
+      shown++;
+
+      simple_mtx_lock(&va->mutex);
+      uint32_t nbind = 0;
+      list_for_each_entry(struct nvkmd_horizon_binding, b, &va->bindings,
+                          link) {
+         mesa_loge("nvkmd_horizon: map  VA 0x%" PRIx64 "+0x%" PRIx64
+                   " page 0x%" PRIx32 "  bound +0x%" PRIx64 " for 0x%" PRIx64,
+                   va->base.addr, va->base.size_B,
+                   horizon_gpu_va_range_page_size(va->range),
+                   b->va_offset_B, b->range_B);
+         nbind++;
+      }
+      if (nbind == 0) {
+         mesa_loge("nvkmd_horizon: map  VA 0x%" PRIx64 "+0x%" PRIx64
+                   " page 0x%" PRIx32 "  (nothing bound)",
+                   va->base.addr, va->base.size_B,
+                   horizon_gpu_va_range_page_size(va->range));
+      }
+      simple_mtx_unlock(&va->mutex);
+   }
+   simple_mtx_unlock(&dev->va_list_mutex);
+
+   /* Say what was dropped. A truncated map that does not admit it reads
+    * as a complete one, and the missing line is exactly the one that
+    * would have explained the fault. */
+   if (total > shown) {
+      mesa_loge("nvkmd_horizon: map  ... %" PRIu32 " more reservation(s) "
+                "not shown of %" PRIu32, total - shown, total);
+   } else {
+      mesa_loge("nvkmd_horizon: map  %" PRIu32 " reservation(s), all shown",
+                total);
+   }
+}
+
 static void
 nvkmd_horizon_va_free(struct nvkmd_va *_va)
 {
    struct nvkmd_horizon_va *va = nvkmd_horizon_va(_va);
+   struct nvkmd_horizon_dev *dev = nvkmd_horizon_dev(_va->dev);
+
+   simple_mtx_lock(&dev->va_list_mutex);
+   list_del(&va->dev_link);
+   simple_mtx_unlock(&dev->va_list_mutex);
 
    /* Freeing a VA that still has memory bound is nvkmd's ordinary path,
     * not a caller error: nvkmd_horizon_mem_free releases the VA its
@@ -307,6 +407,10 @@ nvkmd_horizon_alloc_va(struct nvkmd_dev *_dev,
    list_inithead(&va->bindings);
    simple_mtx_init(&va->mutex, mtx_plain);
 
+   simple_mtx_lock(&dev->va_list_mutex);
+   list_addtail(&va->dev_link, &dev->va_list);
+   simple_mtx_unlock(&dev->va_list_mutex);
+
    *va_out = &va->base;
 
    return VK_SUCCESS;
-- 
