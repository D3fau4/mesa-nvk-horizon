 NVKMD_DECL_SUBCLASS(dev, horizon);
@@ -248,11 +276,113 @@ struct nvkmd_horizon_ctx {
    horizon_gpu_fence last_fence;
    bool has_fence;
 
+   /* Guards last_fence/has_fence, which are read from threads that do
+    * not own this context: nvkmd_horizon_defer.c snapshots them from
+    * whichever thread called vkFreeMemory or vkDestroyImage.
+    *
+    * The alternative — horizon_gpu_channel_last_fence() — is the same
+    * number, but horizon_gpu_channel keeps no lock of its own
+    * (horizon/channel/channel.c reads chan->shadow_target unlocked
