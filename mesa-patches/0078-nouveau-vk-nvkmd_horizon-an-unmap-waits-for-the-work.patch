 NVKMD_DECL_SUBCLASS(ctx, horizon);
 
+/*
+ * DEFERRED UNMAP — nvkmd_horizon_defer.c.
+ *
+ * An unmap takes effect the moment NVGPU_AS_IOCTL_UNMAP_BUFFER returns,
+ * and the GPU runs behind the CPU, so an unmap issued while a submit
+ * that references the address is still executing takes the pages out
+ * from under it. On a DRM backend the kernel's VM_BIND queue orders the
+ * unbind after the channel's work; this platform has no such queue, so
+ * the ordering is built here.
+ */
+struct nvkmd_horizon_deferred_unmap {
+   struct list_head link;
+
+   /* Identity only — compared against, never dereferenced. The VA may
+    * already be freed by the time this entry completes. */
+   const struct nvkmd_horizon_va *va;
+   uint64_t va_offset_B;
+   uint64_t range_B;
+
+   horizon_gpu_mapping *mapping;
+
+   /* The reference the binding held, dropped after the unmap and never
+    * before it. NULL for a memory object's own VA — see
+    * nvkmd_horizon_va_bind_mem for why that exception is not optional. */
+   struct nvkmd_mem *mem;
+
+   uint32_t fence_count;
+   struct {
+      /* NULL once the context that owned it is gone, which means
+       * nothing can execute on it any more. */
+      horizon_gpu_channel *chan;
+      horizon_gpu_fence fence;
+   } fences[];
+};
+
+void nvkmd_horizon_dev_register_ctx(struct nvkmd_horizon_dev *dev,
+                                    struct nvkmd_horizon_ctx *ctx);
+void nvkmd_horizon_dev_unregister_ctx(struct nvkmd_horizon_dev *dev,
+                                      struct nvkmd_horizon_ctx *ctx);
+
+/* Unmaps `mapping` once every channel that could still reach it has
+ * passed the fence it was at when this was called, dropping `mem` after
+ * the unmap. Takes ownership of both.
+ *
+ * `block` waits for that moment; otherwise the entry is queued and the
+ * work happens at a later reap. Never fails: on an allocation failure it
+ * falls back to blocking, which is slower and never wrong.
+ */
+void nvkmd_horizon_defer_unmap(struct nvkmd_horizon_dev *dev,
+                               const struct nvkmd_horizon_va *va,
+                               uint64_t va_offset_B, uint64_t range_B,
+                               horizon_gpu_mapping *mapping,
+                               struct nvkmd_mem *mem, bool block);
+
+/* Completes every queued unmap whose fences have passed. Non-blocking,
+ * and cheap when there is nothing queued.
+ *
+ * NOT TO BE CALLED FROM THE SUBMIT PATH: completing an entry drops a
+ * memory reference, which may be the last one, which runs
+ * nvkmd_horizon_mem_free -> nvkmd_va_free -> the blocking drain below.
+ * On the submit path that would be a CPU stall behind the queue, which
+ * is rejected design 6.
+ */
+void nvkmd_horizon_dev_reap_unmaps(struct nvkmd_horizon_dev *dev);
+
+/* Completes every queued unmap of `va` overlapping [off, off+range),
+ * waiting for its fences. `va` NULL matches every entry, and a `range`
+ * of zero with `va` non-NULL matches all of that VA's entries. */
+void nvkmd_horizon_dev_drain_unmaps(struct nvkmd_horizon_dev *dev,
+                                    const struct nvkmd_horizon_va *va,
+                                    uint64_t va_offset_B, uint64_t range_B);
+
+/* Drops every reference to `chan` from queued entries, after waiting for
+ * their fences on it. Called before the channel is destroyed so no entry
+ * is left holding a dangling pointer. */
+void nvkmd_horizon_dev_retire_channel(struct nvkmd_horizon_dev *dev,
+                                      horizon_gpu_channel *chan);
+
+/* One line at device destroy, or nothing at all if nothing was ever
+ * deferred. */
+void nvkmd_horizon_dev_report_unmaps(struct nvkmd_horizon_dev *dev);
+
 /* The vk_sync type — decision D11, native over syncpoints. See
  * nvkmd_horizon_sync.c for why, and for how D8's clock question is
  * handled in one place.
diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c
