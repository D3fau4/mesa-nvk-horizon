diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_defer.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_defer.c
new file mode 100644
index 0000000..78cf307
--- /dev/null
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_defer.c
@@ -0,0 +1,548 @@
+/*
+ * Copyright (c) mesa-nvk-horizon contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "nvkmd_horizon.h"
+
+#include "util/list.h"
+#include "util/log.h"
+#include "util/macros.h"
+#include "util/os_time.h"
+#include "util/u_memory.h"
+
+#include <assert.h>
+#include <inttypes.h>
+
+/*
+ * ORDERING AN UNMAP AGAINST THE WORK THAT CAN STILL REACH IT.
+ *
+ * horizon_gpu_vm_unmap issues NVGPU_AS_IOCTL_UNMAP_BUFFER and the pages
+ * are gone when it returns. The GPU runs behind the CPU, so an unmap
+ * issued while a submit that references the address is still executing
+ * removes that submit's pages mid-flight. On every other nvkmd backend
+ * the unbind goes through the kernel's VM_BIND queue and comes out
+ * ordered after the channel's work; NVGPU has no such queue, so the
+ * ordering has to be built, and horizon_gpu says whose job that is in
+ * the imperative: "The caller must ensure submits referencing the VA
+ * have retired" (horizon_gpu/vm.h).
+ *
+ * WHAT IS WAITED ON. Every live context's channel, not just one. Two are
+ * live on this device during a vkQueueSubmit — the queue's exec context
+ * and nvk_upload_queue's — and either can have referenced the memory, so
+ * ordering against only one of them would be the same bug, halved. A
+ * context created after the snapshot cannot have referenced the address
+ * because it did not exist, and no future submit may reference it
+ * because the caller has told us the binding is finished, so one
+ * snapshot is enough and there is nothing to re-snapshot.
+ *
+ * WHY NOT horizon_gpu_channel_add_retirement, which already exists and
+ * does exactly this shape of thing. Four reasons, and the first is
+ * decisive: it appends to chan->retire[] with no lock, and may realloc
+ * it, while horizon_gpu_channel_reap walks and compacts the same array
+ * from inside every horizon_gpu_submit — registering from a
+ * vkDestroyImage thread would corrupt it. Then: the callback runs from
+ * inside the submit path and "must not submit", while ours calls an
+ * unmap ioctl and drops a memory reference that can re-enter
+ * nvkmd_va_free; there is no cancellation path, so a lost channel's
+ * horizon_gpu_channel_destroy runs the callback against an owner that
+ * may be gone; and nothing runs at all on a lost channel until destroy,
+ * which is when the unmap is most needed. Explicit polling has none of
+ * those properties.
+ *
+ * THE FAST PATH IS THE CONFORMANT ONE. VUID-vkFreeMemory-memory-00677
+ * and VUID-vkDestroyImage-image-01000 both require every submitted
+ * command that refers to the object to have completed before the call,
+ * so in an application that obeys Vulkan every fence below is already
+ * signalled, nothing is ever queued, and the unmap happens inline
+ * exactly as it did before this file existed. What is bought is that an
+ * application which does not obey it — or a driver-internal free that
+ * races the GPU — waits instead of faulting.
+ */
+
+/* How long a blocking drain waits for one fence before giving up and
+ * reporting. Run 26 measured 3022 us from submit to fence for three
+ * fullscreen draws, and t_vk_submits measures 100-137 us for an empty
+ * submit; its calibrated compute jobs are the longest thing this project
+ * has run, at tens of milliseconds. Two seconds is far above any of
+ * them and far below the ~30 s that tests/README.md calls a hang, so it
+ * separates "the GPU is busy" from "the GPU is never coming back"
+ * without having to guess at either. */
+#define NVKMD_HORIZON_DRAIN_TIMEOUT_NS UINT64_C(2000000000)
+
+void
+nvkmd_horizon_dev_register_ctx(struct nvkmd_horizon_dev *dev,
+                               struct nvkmd_horizon_ctx *ctx)
+{
+   simple_mtx_lock(&dev->defer_mutex);
+   list_addtail(&ctx->dev_link, &dev->ctxs);
+   simple_mtx_unlock(&dev->defer_mutex);
+}
+
+void
+nvkmd_horizon_dev_unregister_ctx(struct nvkmd_horizon_dev *dev,
+                                 struct nvkmd_horizon_ctx *ctx)
+{
+   simple_mtx_lock(&dev->defer_mutex);
+   list_del(&ctx->dev_link);
+   simple_mtx_unlock(&dev->defer_mutex);
+}
+
+/* True when nothing on `chan` can reach the mapping any more.
+ *
+ * LOST IS CHECKED BEFORE THE FENCE, and that order is the decision.
+ * horizon_gpu is emphatic that a reached threshold on a faulted channel
+ * proves nothing about the work, because nvgpu's recovery force-
+ * increments the syncpoint — so a *wait* must keep reporting
+ * CHANNEL_LOST, and it does. But the question here is not whether the
+ * work ran. It is whether the GPU can still reach this address, and a
+ * lost channel never executes again (docs/architecture.md § 6: it is
+ * marked lost and every later submit fails fast). Deferring for ever
+ * instead would strand the mapping, the memory object behind it and the
+ * reservation for the life of the process — the leak patch 0043 exists
+ * to prevent, and the "device destroy refused: live mem=" shape that
+ * 0058 measured.
+ *
+ * The residual assumption, which this patch does not prove: nvgpu stops
+ * the channel before it delivers the notifier. That is nvgpu's contract.
+ */
+static bool
+fence_passed(struct nvkmd_horizon_dev *dev, horizon_gpu_channel *chan,
+             horizon_gpu_fence fence, bool *out_lost)
+{
+   if (chan == NULL)
+      return true;
+
+   if (horizon_gpu_channel_is_lost(chan)) {
+      *out_lost = true;
+      return true;
+   }
+
+   /* No threshold arithmetic here, deliberately. horizon_gpu_fence_poll
+    * compares with horizon_gpu_syncpt_reached, which is wrap-safe and
+    * host-tested (tests/host/h_syncpt_math.c); open-coding the
+    * comparison would be a second copy of the one piece of arithmetic
+    * this project forbids getting wrong. */
+   bool signalled = false;
+   horizon_gpu_result res = horizon_gpu_fence_poll(dev->gpu, fence,
+                                                   &signalled);
+   if (horizon_gpu_failed(res)) {
+      /* Not passed. Of the two ways to be wrong about a syncpoint that
+       * cannot be read, the one that does not unmap is the safe one —
+       * the same choice, for the same reason, that
+       * docs/synchronization.md § 9.1 makes for a degraded channel. */
+      mesa_loge("nvkmd_horizon: horizon_gpu_fence_poll(syncpt %" PRIu32
+                ", threshold %" PRIu32 ") failed: status %d, "
+                "nv 0x%08" PRIx32, fence.syncpt_id, fence.threshold,
+                (int)res.status, res.nv);
+      return false;
+   }
+
+   return signalled;
+}
+
+/* Blocking form. HORIZON_GPU_ERR_CHANNEL_LOST means proceed, for the
+ * reason above — it is not a failure here even though it is one
+ * everywhere else. */
+static bool
+fence_wait_passed(struct nvkmd_horizon_dev *dev, horizon_gpu_channel *chan,
+                  horizon_gpu_fence fence, bool *out_lost)
+{
+   if (fence_passed(dev, chan, fence, out_lost))
+      return true;
+
+   horizon_gpu_result res =
+      horizon_gpu_channel_wait_fence(chan, fence,
+                                     NVKMD_HORIZON_DRAIN_TIMEOUT_NS);
+   if (res.status == HORIZON_GPU_ERR_CHANNEL_LOST) {
+      *out_lost = true;
+      return true;
+   }
+   if (horizon_gpu_failed(res)) {
+      mesa_loge("nvkmd_horizon: waiting for syncpt %" PRIu32 " to reach %"
+                PRIu32 " before an unmap failed: status %d, nv 0x%08" PRIx32
+                " — the mapping is kept rather than removed under work "
+                "that may still be running",
+                fence.syncpt_id, fence.threshold, (int)res.status, res.nv);
+      return false;
+   }
+
+   return true;
+}
+
+/* Runs the unmap and drops the reference. Called with NO lock held: the
+ * unref may be the last one, and nvkmd_mem_unref re-enters
+ * nvkmd_horizon_mem_free -> nvkmd_va_free -> the drain below.
+ *
+ * Returns false when the unmap failed and the entry must be kept. */
+static bool
+deferred_unmap_run(struct nvkmd_horizon_dev *dev,
+                   struct nvkmd_horizon_deferred_unmap *e)
+{
+   horizon_gpu_result res = horizon_gpu_vm_unmap(e->mapping);
+   if (horizon_gpu_failed(res)) {
+      /* Patch 0043's rule, one level along: horizon_gpu_vm_unmap leaves
+       * the mapping alive when it fails, precisely so it can be retried,
+       * and this entry is now the only pointer to it. Dropping the entry
+       * would make the mapping unreachable, the VA unreleasable and the
+       * memory behind it lost for the process's lifetime. It stays
+       * queued and is retried at the next reap. */
+      mesa_loge("nvkmd_horizon: deferred unmap at +0x%" PRIx64 " for 0x%"
+                PRIx64 " failed: status %d, nv 0x%08" PRIx32
+                " — kept queued for retry",
+                e->va_offset_B, e->range_B, (int)res.status, res.nv);
+      return false;
+   }
+
+   if (e->mem != NULL)
+      nvkmd_mem_unref(e->mem);
+
+   FREE(e);
+   return true;
+}
+
+/* Does this entry match the (va, offset, range) selector? A NULL va
+ * matches everything; a non-NULL va with range 0 matches all of that
+ * VA's entries. */
+static bool
+entry_selected(const struct nvkmd_horizon_deferred_unmap *e,
+               const struct nvkmd_horizon_va *va,
+               uint64_t va_offset_B, uint64_t range_B)
+{
+   if (va == NULL)
+      return true;
+   if (e->va != va)
+      return false;
+   if (range_B == 0)
+      return true;
+
+   /* Overlap, not containment: a rebind at an offset whose unmap is
+    * still queued has to wait for exactly the entries in its way. */
+   return e->va_offset_B < va_offset_B + range_B &&
+          va_offset_B < e->va_offset_B + e->range_B;
+}
+
+/* The one loop both the reap and the drain are made of.
+ *
+ * Entries are spliced off the device list under the lock and processed
+ * with it released, which is what makes nvkmd_mem_unref's re-entry into
+ * nvkmd_va_free safe: the re-entrant call takes the lock and sees a list
+ * that no longer holds the entries being worked on. Anything not
+ * completed goes back.
+ */
+static void
+process_unmaps(struct nvkmd_horizon_dev *dev, bool block,
+               const struct nvkmd_horizon_va *va,
+               uint64_t va_offset_B, uint64_t range_B)
+{
+   struct list_head taken, keep;
+   list_inithead(&taken);
+   list_inithead(&keep);
+
+   simple_mtx_lock(&dev->defer_mutex);
+   if (list_is_empty(&dev->deferred_unmaps)) {
+      simple_mtx_unlock(&dev->defer_mutex);
+      return;
+   }
+   list_for_each_entry_safe(struct nvkmd_horizon_deferred_unmap, e,
+                            &dev->deferred_unmaps, link) {
+      if (!entry_selected(e, va, va_offset_B, range_B))
+         continue;
+      list_del(&e->link);
+      list_addtail(&e->link, &taken);
+   }
+   simple_mtx_unlock(&dev->defer_mutex);
+
+   uint32_t completed = 0, lost = 0;
+   uint64_t blocked_ns = 0;
+
+   list_for_each_entry_safe(struct nvkmd_horizon_deferred_unmap, e,
+                            &taken, link) {
+      list_del(&e->link);
+
+      bool ready = true, was_lost = false;
+      const uint64_t t0 = block ? os_time_get_nano() : 0;
+
+      for (uint32_t i = 0; i < e->fence_count && ready; i++) {
+         ready = block
+            ? fence_wait_passed(dev, e->fences[i].chan, e->fences[i].fence,
+                                &was_lost)
+            : fence_passed(dev, e->fences[i].chan, e->fences[i].fence,
+                           &was_lost);
+      }
+
+      if (block) {
+         const uint64_t dt = os_time_get_nano() - t0;
+         if (dt > blocked_ns)
+            blocked_ns = dt;
+      }
+
+      if (!ready || !deferred_unmap_run(dev, e)) {
+         list_addtail(&e->link, &keep);
+         continue;
+      }
+
+      completed++;
+      if (was_lost)
+         lost++;
+   }
+
+   simple_mtx_lock(&dev->defer_mutex);
+   list_splicetail(&keep, &dev->deferred_unmaps);
+   dev->defer_completed += completed;
+   dev->defer_lost += lost;
+   if (blocked_ns > dev->defer_blocked_ns_max)
+      dev->defer_blocked_ns_max = blocked_ns;
+   simple_mtx_unlock(&dev->defer_mutex);
+
+   if (lost > 0) {
+      mesa_loge("nvkmd_horizon: %" PRIu32 " deferred unmap(s) went ahead "
+                "because their channel was lost — the work that referenced "
+                "them was abandoned, not completed", lost);
+   }
+}
+
+void
+nvkmd_horizon_dev_reap_unmaps(struct nvkmd_horizon_dev *dev)
+{
+   process_unmaps(dev, false /* block */, NULL, 0, 0);
+}
+
+void
+nvkmd_horizon_dev_drain_unmaps(struct nvkmd_horizon_dev *dev,
+                               const struct nvkmd_horizon_va *va,
+                               uint64_t va_offset_B, uint64_t range_B)
+{
+   process_unmaps(dev, true /* block */, va, va_offset_B, range_B);
+}
+
+void
+nvkmd_horizon_dev_retire_channel(struct nvkmd_horizon_dev *dev,
+                                 horizon_gpu_channel *chan)
+{
+   /* Everything first, blocking: horizon_gpu_channel_destroy refuses
+    * with ERR_BUSY while submits are in flight, so by the time a channel
+    * is being destroyed its fences have passed and this completes rather
+    * than waits. */
+   nvkmd_horizon_dev_drain_unmaps(dev, NULL, 0, 0);
+
+   /* Whatever survived that — an unmap that failed and is queued for
+    * retry — must stop pointing at a channel that is about to go away.
+    * A NULL channel reads as "nothing can execute on it any more", which
+    * is exactly true of one that has been destroyed. */
+   simple_mtx_lock(&dev->defer_mutex);
+   list_for_each_entry(struct nvkmd_horizon_deferred_unmap, e,
+                       &dev->deferred_unmaps, link) {
+      for (uint32_t i = 0; i < e->fence_count; i++) {
+         if (e->fences[i].chan == chan)
+            e->fences[i].chan = NULL;
+      }
+   }
+   simple_mtx_unlock(&dev->defer_mutex);
+}
+
+/* Allocates an entry with room for exactly the contexts this device has,
+ * and fills it in — both under one hold of defer_mutex, so the count
+ * cannot change between sizing and filling. There is deliberately no
+ * fixed cap: an entry with room for fewer channels than exist would be
+ * an entry that completes while an unrecorded channel is still running,
+ * which is the bug this file exists to prevent.
+ *
+ * NULL only on an allocation failure. The caller then has nowhere to
+ * record the fences and must wait for them instead.
+ */
+static struct nvkmd_horizon_deferred_unmap *
+alloc_and_snapshot(struct nvkmd_horizon_dev *dev,
+                   const struct nvkmd_horizon_va *va,
+                   uint64_t va_offset_B, uint64_t range_B,
+                   horizon_gpu_mapping *mapping, struct nvkmd_mem *mem)
+{
+   simple_mtx_lock(&dev->defer_mutex);
+
+   uint32_t n_ctxs = 0;
+   list_for_each_entry(struct nvkmd_horizon_ctx, ctx, &dev->ctxs, dev_link)
+      n_ctxs++;
+
+   struct nvkmd_horizon_deferred_unmap *e =
+      calloc(1, sizeof(*e) + n_ctxs * sizeof(e->fences[0]));
+   if (e == NULL) {
+      simple_mtx_unlock(&dev->defer_mutex);
+      return NULL;
+   }
+
+   e->va = va;
+   e->va_offset_B = va_offset_B;
+   e->range_B = range_B;
+   e->mapping = mapping;
+   e->mem = mem;
+
+   list_for_each_entry(struct nvkmd_horizon_ctx, ctx, &dev->ctxs, dev_link) {
+      assert(e->fence_count < n_ctxs);
+      simple_mtx_lock(&ctx->fence_mutex);
+      if (ctx->has_fence) {
+         e->fences[e->fence_count].chan = ctx->chan;
+         e->fences[e->fence_count].fence = ctx->last_fence;
+         e->fence_count++;
+      }
+      simple_mtx_unlock(&ctx->fence_mutex);
+   }
+
+   simple_mtx_unlock(&dev->defer_mutex);
+   return e;
+}
+
+/* Waits until nothing on any live channel can still reach an address of
+ * this device, without recording anything. Reached only when an entry
+ * could not be allocated, so there is nowhere to put a snapshot and the
+ * only remaining way to be correct is to wait now.
+ *
+ * defer_mutex is held across the waits, which is normally the wrong
+ * thing to do. It is right here: with no memory to record the fences in,
+ * letting go of the list would mean waiting on a set of channels that
+ * could have changed underneath us. On an out-of-memory path, correct
+ * and slow beats clever.
+ */
+static void
+wait_for_all_channels(struct nvkmd_horizon_dev *dev)
+{
+   simple_mtx_lock(&dev->defer_mutex);
+   const uint64_t t0 = os_time_get_nano();
+
+   list_for_each_entry(struct nvkmd_horizon_ctx, ctx, &dev->ctxs, dev_link) {
+      simple_mtx_lock(&ctx->fence_mutex);
+      const bool has = ctx->has_fence;
+      horizon_gpu_channel *chan = ctx->chan;
+      const horizon_gpu_fence fence = ctx->last_fence;
+      simple_mtx_unlock(&ctx->fence_mutex);
+
+      if (has) {
+         bool was_lost = false;
+         fence_wait_passed(dev, chan, fence, &was_lost);
+      }
+   }
+
+   const uint64_t dt = os_time_get_nano() - t0;
+   if (dt > dev->defer_blocked_ns_max)
+      dev->defer_blocked_ns_max = dt;
+   simple_mtx_unlock(&dev->defer_mutex);
+}
+
+void
+nvkmd_horizon_defer_unmap(struct nvkmd_horizon_dev *dev,
+                          const struct nvkmd_horizon_va *va,
+                          uint64_t va_offset_B, uint64_t range_B,
+                          horizon_gpu_mapping *mapping,
+                          struct nvkmd_mem *mem, bool block)
+{
+   /* Allocated even when blocking, so the fences can be copied out and
+    * waited on with the device lock released. Out of memory is not
+    * reportable here — every caller is a destroy path that returns void
+    * — so it falls through to the lock-held wait instead. */
+   struct nvkmd_horizon_deferred_unmap *e =
+      alloc_and_snapshot(dev, va, va_offset_B, range_B, mapping, mem);
+
+   if (e != NULL) {
+      bool ready = true, was_lost = false;
+      uint64_t blocked_ns = 0;
+
+      const uint64_t t0 = block ? os_time_get_nano() : 0;
+      for (uint32_t i = 0; i < e->fence_count && ready; i++) {
+         ready = block
+            ? fence_wait_passed(dev, e->fences[i].chan, e->fences[i].fence,
+                                &was_lost)
+            : fence_passed(dev, e->fences[i].chan, e->fences[i].fence,
+                           &was_lost);
+      }
+      if (block)
+         blocked_ns = os_time_get_nano() - t0;
+
+      if (!ready) {
+         /* Only reachable without `block`: the blocking form returns
+          * false solely on a wait that failed outright, which leaves the
+          * mapping queued for a later attempt just the same. */
+         simple_mtx_lock(&dev->defer_mutex);
+         list_addtail(&e->link, &dev->deferred_unmaps);
+         dev->defer_queued++;
+         if (blocked_ns > dev->defer_blocked_ns_max)
+            dev->defer_blocked_ns_max = blocked_ns;
+         simple_mtx_unlock(&dev->defer_mutex);
+         return;
+      }
+
+      /* Every fence has passed, which is what a conformant application
+       * always produces: complete inline, exactly as this code did
+       * before the deferral existed. */
+      if (blocked_ns > 0) {
+         simple_mtx_lock(&dev->defer_mutex);
+         if (blocked_ns > dev->defer_blocked_ns_max)
+            dev->defer_blocked_ns_max = blocked_ns;
+         simple_mtx_unlock(&dev->defer_mutex);
+      }
+      FREE(e);
+   } else {
+      wait_for_all_channels(dev);
+   }
+
+   horizon_gpu_result res = horizon_gpu_vm_unmap(mapping);
+   if (horizon_gpu_failed(res)) {
+      /* horizon_gpu_vm_unmap leaves the mapping alive when it fails so
+       * it can be retried, and after this call nothing else points at
+       * it. Queue it so a later reap retries; if even that allocation
+       * fails, say plainly that the mapping is now unreachable rather
+       * than let it disappear quietly. */
+      mesa_loge("nvkmd_horizon: horizon_gpu_vm_unmap(+0x%" PRIx64 ") failed: "
+                "status %d, nv 0x%08" PRIx32, va_offset_B,
+                (int)res.status, res.nv);
+
+      struct nvkmd_horizon_deferred_unmap *retry =
+         calloc(1, sizeof(*retry));
+      if (retry != NULL) {
+         retry->va = va;
+         retry->va_offset_B = va_offset_B;
+         retry->range_B = range_B;
+         retry->mapping = mapping;
+         retry->mem = mem;
+         retry->fence_count = 0;   /* nothing left to wait for */
+         simple_mtx_lock(&dev->defer_mutex);
+         list_addtail(&retry->link, &dev->deferred_unmaps);
+         dev->defer_queued++;
+         simple_mtx_unlock(&dev->defer_mutex);
+         return;
+      }
+
+      mesa_loge("nvkmd_horizon: and it could not be queued for retry — the "
+                "mapping at +0x%" PRIx64 " is unreachable for the life of "
+                "the process", va_offset_B);
+   }
+
+   if (mem != NULL)
+      nvkmd_mem_unref(mem);
+}
+
+void
+nvkmd_horizon_dev_report_unmaps(struct nvkmd_horizon_dev *dev)
+{
+   uint32_t pending = 0;
+   list_for_each_entry(struct nvkmd_horizon_deferred_unmap, e,
+                       &dev->deferred_unmaps, link) {
+      (void)e;
+      pending++;
+   }
+
+   /* Nothing to say when nothing was ever deferred, which is the
+    * conformant case and should not print a line. */
+   if (dev->defer_queued == 0 && pending == 0)
+      return;
+
+   mesa_logi("nvkmd_horizon: deferred unmaps: %" PRIu32 " queued, %" PRIu32
+             " completed, %" PRIu32 " on a lost channel, %" PRIu32
+             " still pending; longest wait %" PRIu64 " us",
+             dev->defer_queued, dev->defer_completed, dev->defer_lost,
+             pending, dev->defer_blocked_ns_max / 1000);
+
+   if (pending > 0) {
+      mesa_loge("nvkmd_horizon: %" PRIu32 " unmap(s) never completed — their "
+                "mappings, memory and reservations are leaked for the life "
+                "of the process", pending);
+   }
+}
