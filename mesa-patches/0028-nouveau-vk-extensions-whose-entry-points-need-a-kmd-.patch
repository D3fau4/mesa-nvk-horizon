From ad77459e63babe4ef7e9c3518b4876bfdcca6445 Mon Sep 17 00:00:00 2001
From: mesa-nvk-horizon <mesa-nvk-horizon@localhost>
Date: Tue, 4 Aug 2026 16:05:09 +0000
Subject: [PATCH 28/56] nouveau/vk: extensions whose entry points need a kmd
 operation follow it

mesa-nvk-horizon: Phase 5 item 3 (off-screen images)
Why: nvk_get_device_extensions advertises KHR_external_memory_fd,
  EXT_external_memory_dma_buf and EXT_map_memory_placed unconditionally.
  Each is implemented by an nvkmd operation that nvkmd_info already says
  may be absent -- import_dma_buf and export_dma_buf behind has_dma_buf,
  and overmap behind has_overmap. On a backend where those flags are
  false the ops table entries are NULL, and the dispatchers do not check:
  nvkmd_dev_import_dma_buf calls dev->ops->import_dma_buf directly
  (nvkmd.c:154-160), and nvkmd_mem_overmap asserts only on the map flags
  (nvkmd.h:520-526). An application that enables an advertised extension
  and uses it therefore jumps through a null pointer.
Evidence: read at MESA_COMMIT against a backend with has_dma_buf = false,
  has_map_fixed = false and has_overmap = false. vkGetMemoryFdKHR reaches
  nvkmd_mem_export_dma_buf; vkAllocateMemory with VkImportMemoryFdInfoKHR
  reaches nvkmd_dev_import_dma_buf (nvk_device_memory.c:219, guarded only
  by the application having chained the struct); vkUnmapMemory2KHR with
  VK_MEMORY_UNMAP_RESERVE_BIT_EXT reaches nvkmd_mem_overmap
  (nvk_device_memory.c:415). All three entries are NULL there.
Upstream: yes -- the pattern already exists in this function.
  EXT_image_drm_format_modifier is gated on kmd_info.has_alloc_tiled and
  has been since the flag was added; these three were left flat true. On
  nouveau every one of the flags is true, so nothing changes there.

The third argument becomes the whole nvkmd_info rather than the one bool
it carried, because three more capabilities are now consulted and
threading three more bools through would say less.

VK_EXT_map_memory_placed's features move with it. They were stated flat
in nvk_get_device_features, which would otherwise report the features of
an extension the same physical device does not support.

Cross build: libnvk.a builds. RUN ON A CONSOLE 2026-08-04: t_vk_caps
52/52 checks the gate in both directions -- the three extensions
absent, EXT_image_drm_format_modifier present, and no sparse feature
advertised.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/nouveau/vulkan/nvk_physical_device.c | 36 ++++++++++++++++++------
 1 file changed, 28 insertions(+), 8 deletions(-)

diff --git a/src/nouveau/vulkan/nvk_physical_device.c b/src/nouveau/vulkan/nvk_physical_device.c
index 19f267a2ed5..93452db41a0 100644
--- a/src/nouveau/vulkan/nvk_physical_device.c
+++ b/src/nouveau/vulkan/nvk_physical_device.c
@@ -115,9 +115,25 @@ nvk_has_astc(const struct nv_device_info *info)
 static void
 nvk_get_device_extensions(const struct nvk_instance *instance,
                           const struct nv_device_info *info,
-                          bool has_tiled_bos,
+                          const struct nvkmd_info *kmd_info,
                           struct vk_device_extension_table *ext)
 {
+   /* Extensions whose entry points reach a kmd operation that not every
+    * backend has. The nvkmd_info flags already say which operations
+    * exist; before this they only reached one extension, and the rest
+    * were unconditional true -- correct on nouveau, where all of them
+    * are implemented, and a way to advertise an extension that cannot
+    * work on a backend where they are not.
+    *
+    * dma-buf import and export are nvkmd_dev_import_dma_buf and
+    * nvkmd_mem_export_dma_buf. Placed maps are nvkmd_mem_map with
+    * NVKMD_MEM_MAP_FIXED, and VK_MEMORY_UNMAP_RESERVE_BIT_EXT is
+    * nvkmd_mem_overmap, which follows the same capability.
+    */
+   const bool has_tiled_bos = kmd_info->has_alloc_tiled;
+   const bool has_dma_buf = kmd_info->has_dma_buf;
+   const bool has_map_placed = kmd_info->has_map_fixed &&
+                               kmd_info->has_overmap;
    *ext = (struct vk_device_extension_table) {
       .KHR_8bit_storage = true,
       .KHR_16bit_storage = true,
@@ -141,7 +157,7 @@ nvk_get_device_extensions(const struct nvk_instance *instance,
       .KHR_external_fence = true,
       .KHR_external_fence_fd = true,
       .KHR_external_memory = true,
-      .KHR_external_memory_fd = true,
+      .KHR_external_memory_fd = has_dma_buf,
       .KHR_external_semaphore = true,
       .KHR_external_semaphore_fd = true,
       .KHR_format_feature_flags2 = true,
@@ -244,7 +260,7 @@ nvk_get_device_extensions(const struct nvk_instance *instance,
       .EXT_extended_dynamic_state = true,
       .EXT_extended_dynamic_state2 = true,
       .EXT_extended_dynamic_state3 = true,
-      .EXT_external_memory_dma_buf = true,
+      .EXT_external_memory_dma_buf = has_dma_buf,
       .EXT_global_priority = true,
       .EXT_global_priority_query = true,
       .EXT_graphics_pipeline_library = true,
@@ -260,7 +276,7 @@ nvk_get_device_extensions(const struct nvk_instance *instance,
       .EXT_legacy_vertex_attributes = true,
       .EXT_line_rasterization = true,
       .EXT_load_store_op_none = true,
-      .EXT_map_memory_placed = true,
+      .EXT_map_memory_placed = has_map_placed,
       .EXT_memory_budget = true,
       .EXT_multi_draw = true,
       .EXT_mutable_descriptor_type = true,
@@ -690,10 +706,14 @@ nvk_get_device_features(const struct nv_device_info *info,
       /* VK_EXT_legacy_vertex_attributes */
       .legacyVertexAttributes = true,
 
-      /* VK_EXT_map_memory_placed */
-      .memoryMapPlaced = true,
+      /* VK_EXT_map_memory_placed. Gated on the extension rather than
+       * stated flat, because the extension is now gated on a kmd
+       * capability: a backend without placed maps would otherwise
+       * report the features of an extension it does not support.
+       */
+      .memoryMapPlaced = supported_extensions->EXT_map_memory_placed,
       .memoryMapRangePlaced = false,
-      .memoryUnmapReserve = true,
+      .memoryUnmapReserve = supported_extensions->EXT_map_memory_placed,
 
       /* VK_EXT_multi_draw */
       .multiDraw = true,
@@ -1474,7 +1494,7 @@ nvk_create_physical_device(struct vk_instance *_instance,
 
    struct vk_device_extension_table supported_extensions;
    nvk_get_device_extensions(instance, &nvkmd->dev_info,
-                             nvkmd->kmd_info.has_alloc_tiled,
+                             &nvkmd->kmd_info,
                              &supported_extensions);
 
    struct vk_features supported_features;
-- 
