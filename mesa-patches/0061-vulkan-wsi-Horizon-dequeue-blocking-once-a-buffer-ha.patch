From 1a592cb0188fab67767ba98a712c811c4fce496e Mon Sep 17 00:00:00 2001
From: mesa-nvk-horizon <mesa-nvk-horizon@localhost>
Date: Wed, 5 Aug 2026 13:29:40 +0000
Subject: [PATCH 61/81] vulkan/wsi: Horizon, dequeue blocking once a buffer has
 been released
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

mesa-nvk-horizon: Phase 6 item 7 (nwindowDequeueBuffer /
 nwindowQueueBuffer)
Why: patch 0059 added NO_INIT to the set of dequeue results the acquire
 retries, on the strength of a two-image swapchain answering with it.
 Retrying was not enough: the acquire then spun until its deadline and
 returned VK_TIMEOUT instead, because an async dequeue on a two-buffer
 queue never succeeds however long you ask.
 The reason is the mode, not the retry. libnx passes the producer's
 `async` flag as true when it has a release event to wait on and false
 when it does not, and the two are not interchangeable: async mode asks
 the queue to keep a buffer in reserve so the producer never blocks,
 which a two-buffer queue cannot do. So the non-blocking mode is what
 probes — it is what lets a zero timeout answer VK_NOT_READY truthfully
 — and the blocking mode is what asks once the release event says a
 buffer has come back. That is libnx's own loop, and it is what works
 with two.
 The blocking call is only ever made after the event has fired, so it
 does not sit in the binder call waiting for something that has not
 happened.
Evidence: HARDWARE. t_vk_swapchain on the owner's console, 2026-08-05,
 with 0059 in: "2 images, FIFO: vkAcquireNextImageKHR at frame 2 ->
 VK_TIMEOUT", and t_nwindow the same at frame 2 with
 MAKERESULT(Module_Libnx, LibnxError_Timeout) = 0x6359, its own
 one-second deadline. Both had accepted NO_INIT as retryable and
 exhausted the deadline retrying it
 (docs/hw-logs/t_nwindow-run2-blocking-dequeue-FAIL.log).
Upstream: no.
---
 src/vulkan/wsi/wsi_horizon.c | 30 +++++++++++++++++++++++++++---
 1 file changed, 27 insertions(+), 3 deletions(-)

diff --git a/src/vulkan/wsi/wsi_horizon.c b/src/vulkan/wsi/wsi_horizon.c
index 2438738..84c45ab 100644
--- a/src/vulkan/wsi/wsi_horizon.c
+++ b/src/vulkan/wsi/wsi_horizon.c
@@ -923,8 +923,24 @@ wsi_horizon_dequeue_would_block(Result rc)
                         LibnxBinderError_InvalidOperation);
 }
 
+/* `blocking` chooses between the BufferQueue's two dequeue modes, and
+ * the choice is not a preference.
+ *
+ * libnx passes the producer's `async` flag as true when it has a
+ * release event to wait on and false when it does not, and the two are
+ * not interchangeable: async mode asks the queue to keep a buffer in
+ * reserve so the producer never blocks, which a two-buffer queue cannot
+ * do. MEASURED — a two-image swapchain with both buffers queued answers
+ * an async dequeue with NO_INIT for as long as you keep asking, and no
+ * release ever arrives to it. Three buffers never reach the condition.
+ *
+ * So the non-blocking mode is used to *probe* — it is what makes a zero
+ * timeout answer VK_NOT_READY truthfully — and the blocking mode is
+ * used once the release event says a buffer has come back, which is
+ * what libnx's own loop does and what works with two.
+ */
 static Result
-wsi_horizon_try_dequeue(struct wsi_horizon_swapchain *chain,
+wsi_horizon_try_dequeue(struct wsi_horizon_swapchain *chain, bool blocking,
                         s32 *slot_out, NvMultiFence *fence_out)
 {
    NWindow *win = chain->window;
@@ -932,7 +948,7 @@ wsi_horizon_try_dequeue(struct wsi_horizon_swapchain *chain,
    NvMultiFence fence;
    memset(&fence, 0, sizeof(fence));
 
-   Result rc = bqDequeueBuffer(&win->bq, true, win->width, win->height,
+   Result rc = bqDequeueBuffer(&win->bq, !blocking, win->width, win->height,
                                (s32)win->format, win->usage, &slot, &fence);
    if (R_FAILED(rc))
       return rc;
@@ -1020,10 +1036,13 @@ wsi_horizon_acquire_zero_copy(struct wsi_horizon_swapchain *chain,
 {
    const uint64_t start_ns = os_time_get_nano();
 
+   bool blocking = false;
+
    for (;;) {
       s32 slot = -1;
       NvMultiFence fence;
-      Result rc = wsi_horizon_try_dequeue(chain, &slot, &fence);
+      Result rc = wsi_horizon_try_dequeue(chain, blocking, &slot, &fence);
+      blocking = false;
 
       if (R_SUCCEEDED(rc)) {
          struct wsi_horizon_image *image = &chain->images[slot];
@@ -1128,6 +1147,11 @@ wsi_horizon_acquire_zero_copy(struct wsi_horizon_swapchain *chain,
                    "0x%08x", erc);
          return VK_ERROR_OUT_OF_DATE_KHR;
       }
+
+      /* A buffer has come back. Ask for it in the mode a two-buffer
+       * queue will actually answer — see wsi_horizon_try_dequeue. The
+       * event fired, so this does not sit in the binder call. */
+      blocking = true;
    }
 }
 
