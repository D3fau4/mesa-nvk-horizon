From 699c6474f88339db6bc12841d7be246a3ebfe84e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 8 Aug 2026 13:10:38 +0000
Subject: [PATCH] vulkan/wsi: Horizon, four findings from the PR #8 review
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

mesa-nvk-horizon: Phase 6 item 7 (nwindowDequeueBuffer / nwindowQueueBuffer)
Why: an automated review raised four real defects in this backend. All
 four are fixed here; two of them change behaviour an application can
 see, so none was taken without the maintainer's decision.

1. async=false could overrun a finite timeout. It is the mode Android
   permits to block inside the server, and nothing here can bound how
   long: neither the deadline check at the top of the acquire loop nor
   0064's sleep can run until the call returns. Measured at 134-158 us
   on this compositor, which is evidence that it does not block, not
   that it cannot. It is now asked only when timeout_ns is UINT64_MAX —
   the one case with no deadline to overrun. A finite timeout gets
   async=true and the sleep, which is what t_nwindow's copy of the loop
   uses to present 90 of 90 frames on two buffers.

2. vkCreateSwapchainKHR evicted the window's current owner even when
   pCreateInfo->oldSwapchain did not name it. The spec asks for
   VK_ERROR_NATIVE_WINDOW_IN_USE_KHR there: a creation that fails must
   not destroy an existing swapchain's ability to present.
   wsi_horizon_claim_window now takes the resolved oldSwapchain and
   refuses instead, and the failure path frees the chain without calling
   release_window — the swapchain that has the window never lost it.

3. IMMEDIATE with two images silently became FIFO. swapInterval 0 is
   honoured only with three or more buffers registered, and the interval
   was computed after the count was fixed, so an application asking for
   IMMEDIATE with two images — a count the published capabilities allow
   — got interval 1 and VK_SUCCESS. Advertising a present mode obliges
   implementing it. minImageCount is a minimum and the implementation
   chooses the actual count, so IMMEDIATE now takes the third image.

4. A failed bqCancelBuffer still marked the slot FREE, in both
   release_slots and release_images. The queue still holds it, so the
   state stays ACQUIRED and release_images reports
   VK_ERROR_OUT_OF_DATE_KHR rather than returning VK_SUCCESS over a
   cancel that did not happen.

Cross build: green. Not verified on hardware.
---
 src/vulkan/wsi/wsi_horizon.c | 125 +++++++++++++++++++++++++++++------
 1 file changed, 104 insertions(+), 21 deletions(-)

diff --git a/src/vulkan/wsi/wsi_horizon.c b/src/vulkan/wsi/wsi_horizon.c
index 7d8e83a..9bfbde6 100644
--- a/src/vulkan/wsi/wsi_horizon.c
+++ b/src/vulkan/wsi/wsi_horizon.c
@@ -827,14 +827,34 @@ static void wsi_horizon_release_slots(struct wsi_horizon_swapchain *chain);
 
 /* Takes the window's registration for `chain`, evicting whoever had it.
  * Called with the surface unlocked; takes the lock itself. */
-static void
-wsi_horizon_claim_window(struct wsi_horizon_swapchain *chain)
+/* `old` is pCreateInfo->oldSwapchain resolved to this backend's type, or
+ * NULL. Returns VK_ERROR_NATIVE_WINDOW_IN_USE_KHR when the window
+ * already has a non-retired swapchain that `old` does not name.
+ *
+ * THAT CHECK WAS MISSING, and the eviction below happened regardless.
+ * The spec makes vkCreateSwapchainKHR fail with
+ * VK_ERROR_NATIVE_WINDOW_IN_USE_KHR when the surface's native window is
+ * already associated with a non-retired swapchain — a failed creation
+ * must not destroy the existing swapchain's ability to present, which
+ * is exactly what unconditional eviction did. Reported by Codex on
+ * PR #8, and right. t_vk_swapchain's section D already passed
+ * oldSwapchain, so it was legitimate either way and could not tell a
+ * conformant driver from this one; it now also checks that omitting
+ * oldSwapchain is refused and leaves the incumbent presenting. */
+static VkResult
+wsi_horizon_claim_window(struct wsi_horizon_swapchain *chain,
+                         struct wsi_horizon_swapchain *old)
 {
    struct wsi_horizon_surface *surface = chain->surface;
 
    simple_mtx_lock(&surface->lock);
 
    struct wsi_horizon_swapchain *prev = surface->owner;
+   if (prev != NULL && prev != chain && prev != old) {
+      simple_mtx_unlock(&surface->lock);
+      return VK_ERROR_NATIVE_WINDOW_IN_USE_KHR;
+   }
+
    if (prev != NULL && prev != chain) {
       /* Vulkan created this swapchain before destroying that one, which
        * is exactly what oldSwapchain means. The old one stops being
@@ -873,6 +893,7 @@ wsi_horizon_claim_window(struct wsi_horizon_swapchain *chain)
    chain->presentable = true;
 
    simple_mtx_unlock(&surface->lock);
+   return VK_SUCCESS;
 }
 
 /* Gives the window back, if this swapchain is still the one holding it. */
@@ -1001,7 +1022,15 @@ wsi_horizon_release_slots(struct wsi_horizon_swapchain *chain)
          image->have_release_fence ? &image->release_fence : NULL;
       Result rc = bqCancelBuffer(&chain->window->bq, (s32)i, fence);
       if (R_FAILED(rc)) {
-         mesa_logw("wsi_horizon: cancelling slot %u failed: 0x%08x", i, rc);
+         /* THE QUEUE STILL HOLDS IT, so this must not say otherwise.
+          * Marking it FREE after a failed cancel puts our bookkeeping
+          * and the BufferQueue's out of step; the slot is lost until
+          * nwindowReleaseBuffers reclaims it at teardown, which is a
+          * leak and not a corruption, but claiming it back is a lie
+          * either way. Reported by Codex on PR #8. */
+         mesa_logw("wsi_horizon: cancelling slot %u failed: 0x%08x — the "
+                   "slot stays ACQUIRED, the queue still has it", i, rc);
+         continue;
       }
       image->state = WSI_HORIZON_SLOT_FREE;
       image->have_release_fence = false;
@@ -1050,7 +1079,7 @@ wsi_horizon_acquire_zero_copy(struct wsi_horizon_swapchain *chain,
       Result rc = wsi_horizon_try_dequeue(chain, false /* libnx's mode */,
                                           &slot, &fence);
 
-      /* THE SECOND MODE, AND IT IS WHAT MAKES TWO IMAGES WORK.
+      /* THE SECOND MODE, AND ONLY WHERE IT CANNOT OVERRUN THE CALLER.
        *
        * Measured on hardware (2026-08-05) on a two-buffer window with
        * both buffers queued: async=true answered NO_INIT 78166 times
@@ -1062,13 +1091,20 @@ wsi_horizon_acquire_zero_copy(struct wsi_horizon_swapchain *chain,
        * it. FIFO is synchronous by definition, so async=false is the
        * mode that describes what a swapchain is doing.
        *
-       * Not asked when the caller passed a zero timeout. async=false is
-       * the mode Android allows to block inside the server; it did not
-       * on the window measured, but vkAcquireNextImageKHR(timeout = 0)
-       * must answer VK_NOT_READY promptly and that promise is not worth
-       * risking on one measurement.
+       * BUT IT IS THE MODE ANDROID PERMITS TO BLOCK IN THE SERVER, and
+       * nothing here can bound how long. Neither the deadline check at
+       * the top of this loop nor 0064's sleep can run until the call
+       * returns, so on any finite timeout it could overrun what
+       * vkAcquireNextImageKHR promised — and "measured at 134-158 us on
+       * this compositor" is evidence that it does not, not that it
+       * cannot. Reported by Codex on PR #8, and right.
+       *
+       * So it is asked only when the caller gave no deadline to
+       * overrun. A finite timeout gets async=true and the sleep, which
+       * is what t_nwindow's copy of this loop uses to present 90 of 90
+       * frames on two buffers.
        */
-      if (wsi_horizon_dequeue_would_block(rc) && timeout_ns != 0)
+      if (wsi_horizon_dequeue_would_block(rc) && timeout_ns == UINT64_MAX)
          rc = wsi_horizon_try_dequeue(chain, true /* FIFO's own mode */,
                                       &slot, &fence);
 
@@ -1271,6 +1307,7 @@ wsi_horizon_swapchain_release_images(struct wsi_swapchain *wsi_chain,
 {
    struct wsi_horizon_swapchain *chain =
       (struct wsi_horizon_swapchain *)wsi_chain;
+   VkResult result = VK_SUCCESS;
 
    for (uint32_t i = 0; i < count; i++) {
       const uint32_t index = indices[i];
@@ -1286,8 +1323,14 @@ wsi_horizon_swapchain_release_images(struct wsi_swapchain *wsi_chain,
             image->have_release_fence ? &image->release_fence : NULL;
          Result rc = bqCancelBuffer(&chain->window->bq, (s32)index, fence);
          if (R_FAILED(rc)) {
-            mesa_logw("wsi_horizon: releasing slot %u failed: 0x%08x",
+            /* Same as wsi_horizon_release_slots: the queue still holds
+             * it, so the state stays ACQUIRED and the error is
+             * reported rather than swallowed behind VK_SUCCESS. */
+            mesa_logw("wsi_horizon: releasing slot %u failed: 0x%08x — the "
+                      "slot stays ACQUIRED, the queue still has it",
                       index, rc);
+            result = VK_ERROR_OUT_OF_DATE_KHR;
+            continue;
          }
       }
 
@@ -1295,7 +1338,7 @@ wsi_horizon_swapchain_release_images(struct wsi_swapchain *wsi_chain,
       image->have_release_fence = false;
    }
 
-   return VK_SUCCESS;
+   return result;
 }
 
 /* ---- present ----------------------------------------------------- */
@@ -1695,8 +1738,30 @@ wsi_horizon_surface_create_swapchain(VkIcdSurfaceBase *icd_surface,
     * minimum must not produce a swapchain below the minimum — a
     * one-image swapchain has no buffer to render into while another is
     * on screen — and the reference only ever truncates downward. */
+   const VkPresentModeKHR present_mode =
+      wsi_swapchain_get_present_mode(wsi_device, pCreateInfo);
+
    uint32_t image_count = pCreateInfo->minImageCount;
    image_count = MAX2(image_count, WSI_HORIZON_MIN_IMAGES);
+
+   /* IMMEDIATE TAKES THE THIRD IMAGE RATHER THAN QUIETLY BECOMING FIFO.
+    *
+    * swapInterval 0 is honoured by the compositor only with three or
+    * more buffers registered; below that the system enforces 1. The
+    * swap interval used to be computed as `image_count >= 3 ? 0 : 1`
+    * *after* the count was fixed, so an application asking for
+    * IMMEDIATE with two images — a count the published capabilities
+    * allow — got swapInterval 1 and a success code, which is FIFO
+    * wearing another mode's name. Advertising a present mode obliges
+    * implementing it for every valid swapchain.
+    *
+    * minImageCount is a minimum and the implementation chooses the
+    * actual count, so raising it here is the conformant answer and
+    * needs no agreement from the application. Reported by Codex on
+    * PR #8. */
+   if (present_mode == VK_PRESENT_MODE_IMMEDIATE_KHR)
+      image_count = MAX2(image_count, 3);
+
    image_count = MIN2(image_count, WSI_HORIZON_MAX_IMAGES);
 
    const size_t size = sizeof(struct wsi_horizon_swapchain) +
@@ -1716,15 +1781,10 @@ wsi_horizon_surface_create_swapchain(VkIcdSurfaceBase *icd_surface,
    chain->format = format;
    chain->image_count = image_count;
 
-   /* IMMEDIATE means swapInterval 0, which libnx documents as honoured
-    * only with three or more buffers registered; below that the system
-    * enforces 1. Said here rather than left to be discovered from a
-    * frame rate that did not change. */
-   const VkPresentModeKHR present_mode =
-      wsi_swapchain_get_present_mode(wsi_device, pCreateInfo);
+   /* swapInterval 0 is IMMEDIATE; the image count that makes the
+    * compositor honour it was settled above. */
    chain->swap_interval =
-      (present_mode == VK_PRESENT_MODE_IMMEDIATE_KHR && image_count >= 3) ?
-      0 : 1;
+      present_mode == VK_PRESENT_MODE_IMMEDIATE_KHR ? 0 : 1;
 
    /* nvFenceInit is reference counted by libnx (NX_GENERATE_SERVICE_GUARD
     * in nvidia/fence.c), so taking a reference here is safe next to
@@ -1740,7 +1800,30 @@ wsi_horizon_surface_create_swapchain(VkIcdSurfaceBase *icd_surface,
    chain->holds_nv_fence = true;
 
    /* Take the window before creating anything that registers on it. */
-   wsi_horizon_claim_window(chain);
+   /* The window is claimed only if it is free or if oldSwapchain names
+    * whoever holds it; otherwise the existing swapchain keeps
+    * presenting and this creation fails, which is what the spec asks
+    * for. Everything above this point is undone on that path. */
+   struct wsi_horizon_swapchain *old = NULL;
+   if (pCreateInfo->oldSwapchain != VK_NULL_HANDLE) {
+      VK_FROM_HANDLE(wsi_swapchain, old_base, pCreateInfo->oldSwapchain);
+      /* Only this backend creates swapchains on a VI surface, so a
+       * handle that reached here is one of ours. */
+      old = (struct wsi_horizon_swapchain *)old_base;
+   }
+
+   result = wsi_horizon_claim_window(chain, old);
+   if (result != VK_SUCCESS) {
+      /* NOT fail_no_chain: that path calls wsi_horizon_release_window,
+       * and this swapchain never took the window — the one that has it
+       * is still presenting, which is the whole point of refusing. The
+       * nvFence reference taken above is dropped here, in reverse
+       * order, because nothing else will. */
+      if (chain->holds_nv_fence)
+         nvFenceExit();
+      vk_free(pAllocator, chain);
+      return result;
+   }
 
    /* Attempt 0 is zero-copy; attempt 1 is the copy fallback. Each one
     * either succeeds or says why it did not, and the images are
-- 
2.43.0

