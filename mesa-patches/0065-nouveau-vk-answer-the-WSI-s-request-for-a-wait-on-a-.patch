From c9c862962e3fad95a872a23318644d25ff05c520 Mon Sep 17 00:00:00 2001
From: mesa-nvk-horizon <mesa-nvk-horizon@localhost>
Date: Mon, 7 Sep 2026 05:08:52 +0000
Subject: [PATCH 65/66] nouveau/vk: answer the WSI's request for a wait on a
 foreign fence
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

mesa-nvk-horizon: Phase 6 item 8 (Correct fence-based synchronisation at
 acquire and present)
Why: the previous two patches are a mechanism with no wire between
 them. wsi_device::horizon::create_wait_sync is what the WSI backend
 calls and nvkmd_pdev_import_syncpt_fence is what does the work; this is
 the four lines in the middle, in the same file and the same shape as
 nvk_wsi_get_fence going the other way.
 .
 One judgement in it, and it is about which way to fail. An entry whose
 `valid` is false names no dependency — that is what the flag means on
 the export side — so it is dropped, and dropping it drops nothing. A
 valid one is never dropped: the count comes from the copy rather than
 from the caller, so a set of four with one blank imports three and not
 a truncated two. All of them blank is VK_ERROR_FEATURE_NOT_PRESENT,
 which is this interface's "there is nothing here" and sends the caller
 back to signalling its semaphore immediately — which for a buffer
 nobody is still reading is the right answer and not a fallback.
 .
 Still nothing calls it: the WSI backend that does is the next patch.
Evidence: NOT COMPILED. nvk_wsi.c reaches nil.h through
 nvk_descriptor_types.h, and NIL's header is generated by the Rust half
 of the build, so the host syntax check the two previous patches carry
 cannot be run on this file. What was checked instead is that every name
 it uses exists at the arities used: NVKMD_MAX_SYNCPT_FENCES and struct
 nvkmd_syncpt_fence (nvkmd.h), nvkmd_pdev_import_syncpt_fence (MUST_
 CHECK, and its result is returned), nvk_device_physical(dev)->nvkmd and
 &dev->vk (nvk_device.h:47,79 — the same two nvk_wsi_get_fence already
 uses), and struct vk_sync, forward-declared by wsi_common.h which this
 file includes. NO CROSS BUILD AND NO CONSOLE HAS RUN THIS.
Upstream: no — it implements a Horizon-only wsi_device hook against a
 Horizon-only nvkmd op.
---
 src/nouveau/vulkan/nvk_wsi.c | 56 ++++++++++++++++++++++++++++++++----
 1 file changed, 50 insertions(+), 6 deletions(-)

diff --git a/src/nouveau/vulkan/nvk_wsi.c b/src/nouveau/vulkan/nvk_wsi.c
index 16af6de..344002c 100644
--- a/src/nouveau/vulkan/nvk_wsi.c
+++ b/src/nouveau/vulkan/nvk_wsi.c
@@ -28,6 +28,10 @@ nvk_wsi_get_image_info(VkDevice device, VkImage image, VkDeviceMemory memory,
 static VkResult
 nvk_wsi_get_fence(VkDevice device, VkFence fence, uint64_t abs_timeout_ns,
                   struct wsi_horizon_fence *fence_out);
+static VkResult
+nvk_wsi_create_wait_sync(VkDevice device,
+                         const struct wsi_horizon_fence *fences,
+                         uint32_t fence_count, struct vk_sync **sync_out);
 #endif
 
 VkResult
@@ -54,6 +58,7 @@ nvk_init_wsi(struct nvk_physical_device *pdev)
 #ifdef VK_USE_PLATFORM_VI_NN
    pdev->wsi_device.horizon.get_image_info = nvk_wsi_get_image_info;
    pdev->wsi_device.horizon.get_fence = nvk_wsi_get_fence;
+   pdev->wsi_device.horizon.create_wait_sync = nvk_wsi_create_wait_sync;
 
    /* NOT set, and that is the whole of Fase D on this side.
     *
@@ -88,13 +93,14 @@ nvk_finish_wsi(struct nvk_physical_device *pdev)
 }
 
 #ifdef VK_USE_PLATFORM_VI_NN
-/* The two things Horizon's WSI backend cannot work out for itself.
+/* The three things Horizon's WSI backend cannot work out for itself.
  *
- * Both are queries about objects the driver owns — an image's layout and
- * the fence a submit will signal — asked through wsi_device rather than
- * by reaching into NVK, which is the same shape as wsi_device::win32 and
- * wsi_device::metal. Neither has anything Horizon-specific in it beyond
- * the two structures wsi_common.h declares for exactly this purpose.
+ * All three are about objects the driver owns — an image's layout, the
+ * fence a submit will signal, and a vk_sync to hang a foreign fence on —
+ * asked through wsi_device rather than by reaching into NVK, which is
+ * the same shape as wsi_device::win32 and wsi_device::metal. None has
+ * anything Horizon-specific in it beyond the two structures wsi_common.h
+ * declares for exactly this purpose.
  */
 
 static VkResult
@@ -181,4 +187,42 @@ nvk_wsi_get_fence(VkDevice _device, VkFence _fence, uint64_t abs_timeout_ns,
 
    return VK_SUCCESS;
 }
+
+static VkResult
+nvk_wsi_create_wait_sync(VkDevice _device,
+                         const struct wsi_horizon_fence *fences,
+                         uint32_t fence_count, struct vk_sync **sync_out)
+{
+   VK_FROM_HANDLE(nvk_device, dev, _device);
+
+   if (fences == NULL || fence_count > NVKMD_MAX_SYNCPT_FENCES)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   /* An entry that is not valid names no dependency at all — that is
+    * what wsi_horizon_fence::valid means going the other way — so it is
+    * dropped rather than refused, and dropping it drops nothing. What
+    * must never happen is dropping a VALID one, so the count comes from
+    * the copy and the whole set is refused nowhere.
+    *
+    * All of them invalid is FEATURE_NOT_PRESENT, which is this
+    * interface's "there is nothing here": the caller then signals its
+    * semaphore the way it did before, which for a buffer nobody is
+    * still reading is right.
+    */
+   struct nvkmd_syncpt_fence syncpts[NVKMD_MAX_SYNCPT_FENCES];
+   uint32_t count = 0;
+   for (uint32_t i = 0; i < fence_count; i++) {
+      if (!fences[i].valid)
+         continue;
+      syncpts[count].id = fences[i].syncpt_id;
+      syncpts[count].value = fences[i].threshold;
+      count++;
+   }
+
+   if (count == 0)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   return nvkmd_pdev_import_syncpt_fence(nvk_device_physical(dev)->nvkmd,
+                                         &dev->vk, syncpts, count, sync_out);
+}
 #endif /* VK_USE_PLATFORM_VI_NN */
