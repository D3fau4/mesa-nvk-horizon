From 8c60d1cdad453e43155f7831df5c2e0b0e5e87d1 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 28 Jul 2026 15:51:42 +0000
Subject: [PATCH 31/59] nouveau/vk: nvkmd_horizon, every memory object needs
 its own VA
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

NVK reads mem->va->addr directly, and not as a special case: an
ordinary buffer never gets a VA of its own, because nvk_CreateBuffer
allocates one only for sparse and capture/replay buffers
(nvk_buffer.c:119-121). Everything else takes the memory's:

    buffer->vk.device_address = mem->mem->va->addr + memoryOffset;
                                     -- nvk_buffer.c:271

nvkmd_horizon_alloc_mem left that field NULL, so the read is a null
dereference. It is not confined to vkBindBufferMemory either --
nvk_device.c:295 reads dev->zero_page->va->addr while vkCreateDevice is
still running, and nvk_cmd_buffer.c:195 and :261 read it for every push
and every upload.

The nouveau backend allocates the VA and binds the memory into it
inside its own alloc_mem (nvkmd_nouveau_mem.c:56-66). This backend has
to do the same. That a GPU VA on Horizon is an explicit reservation
rather than a side effect of creating a BO is exactly why it cannot be
inherited for free.

NVKMD_VA_GART because there is no VRAM on this device, so every
allocation is pinned system memory -- which is what the flag says and
what puts the reservation in the small-page half. PITCH kind because
this is the untiled path; alloc_tiled_mem is a separate op and is not
implemented here.

free() releases the VA before destroying the memory, and not merely for
symmetry: releasing the reservation unmaps what is bound in it, and
horizon_gpu_mem_destroy refuses with ERR_BUSY while any mapping of the
object is alive, so the other order would fail every free.

mesa-nvk-horizon: Phase 4 item 3 (memory objects) and item 5 (bind)
Why: nvkmd's memory objects are expected to carry a bound GPU VA, an
  invariant the nouveau backend establishes in alloc_mem and which
  nothing in nvkmd core re-establishes for a backend that does not.
Evidence: nvk_buffer.c:271, nvk_device.c:295 and nvk_cmd_buffer.c:195
  dereference mem->va with no NULL check; nvkmd_mem_init (nvkmd.c:66-83)
  leaves the field zeroed and never fills it.
Upstream: no — this is the Horizon backend's own allocator.
---
 .../vulkan/nvkmd/horizon/nvkmd_horizon_mem.c  | 54 +++++++++++++++++++
 1 file changed, 54 insertions(+)

diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_mem.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_mem.c
index 772234e..f6901f2 100644
--- a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_mem.c
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_mem.c
@@ -18,6 +18,14 @@ nvkmd_horizon_mem_free(struct nvkmd_mem *_mem)
 {
    struct nvkmd_horizon_mem *mem = nvkmd_horizon_mem(_mem);
 
+   /* The VA first, and not only for symmetry with alloc: releasing a
+    * horizon_gpu reservation unmaps what is bound in it, and
+    * horizon_gpu_mem_destroy refuses with ERR_BUSY while any mapping of
+    * the object is still alive. The other order would fail every free.
+    */
+   if (mem->base.va != NULL)
+      nvkmd_va_free(mem->base.va);
+
    horizon_gpu_result res = horizon_gpu_mem_destroy(mem->gpu_mem);
    if (res.status != HORIZON_GPU_OK) {
       /* ERR_BUSY here means a GPU mapping of this object is still
@@ -225,7 +233,53 @@ nvkmd_horizon_alloc_mem(struct nvkmd_dev *_dev,
                   horizon_gpu_mem_size(mem->gpu_mem),
                   _dev->pdev->bind_align_B);
 
+   /* EVERY nvkmd_mem CARRIES ITS OWN VA, BOUND AT OFFSET 0.
+    *
+    * This is not an optimisation and it is not optional. NVK reads
+    * mem->va->addr directly for any buffer that has no VA of its own,
+    * which is every ordinary buffer — only sparse and capture/replay
+    * buffers get one (nvk_buffer.c:119-121):
+    *
+    *     buffer->vk.device_address = mem->mem->va->addr + memoryOffset;
+    *                                      -- nvk_buffer.c:271
+    *
+    * so leaving this NULL is a null dereference inside
+    * vkBindBufferMemory, and nvk_device_memory.c:278 reads the same
+    * field. The nouveau backend allocates and binds here for exactly
+    * this reason (nvkmd_nouveau_mem.c:56-66); this backend has to do
+    * the same thing, and the fact that a GPU VA on Horizon is an
+    * explicit reservation rather than a side effect of BO creation is
+    * precisely why it cannot be inherited for free.
+    *
+    * NVKMD_VA_GART: there is no VRAM on this device, so every
+    * allocation is pinned system memory, which is what the flag says
+    * and what puts the reservation in the small-page half. PITCH kind:
+    * this is the untiled path — alloc_tiled_mem is a separate op and
+    * is not implemented here.
+    */
+   const uint64_t va_align_B = MAX2(_dev->pdev->bind_align_B, align);
+
+   VkResult result =
+      nvkmd_dev_alloc_va(_dev, log_obj, NVKMD_VA_GART,
+                         HORIZON_GPU_PTE_KIND_PITCH, mem->base.size_B,
+                         va_align_B, 0 /* fixed_addr */, &mem->base.va);
+   if (result != VK_SUCCESS)
+      goto fail_gpu_mem;
+
+   result = nvkmd_va_bind_mem(mem->base.va, log_obj, 0 /* va_offset_B */,
+                              &mem->base, 0 /* mem_offset_B */,
+                              mem->base.size_B);
+   if (result != VK_SUCCESS)
+      goto fail_va;
+
    *mem_out = &mem->base;
 
    return VK_SUCCESS;
+
+fail_va:
+   nvkmd_va_free(mem->base.va);
+fail_gpu_mem:
+   horizon_gpu_mem_destroy(mem->gpu_mem);
+   FREE(mem);
+   return result;
 }
