From 424df28751722738834917463ce996f0f216ac5e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ra=C3=BAl=20=C3=81lvarez?= <raulwii2@gmail.com>
Date: Sat, 22 Aug 2026 18:49:28 +0200
Subject: [PATCH 48/56] nouveau/vk: clean only the command memory the CPU wrote
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

mesa-nvk-horizon: Phase 4 item 7 (submit)
Why: vkEndCommandBuffer cleans every chunk a command buffer owns over its
 whole length, and nvk_mem_stream_sync_chunks_to_gpu() cleans the current
 chunk over NVK_MEM_STREAM_MAX_ALLOC_SIZE, both regardless of how much of
 the chunk was written. On a DRM backend the maps are write-combined and
 coherent so nvkmd_mem_sync_to_gpu() returns without doing anything and the
 length is irrelevant. It is not a property of DRM that Mesa may assume:
 nvkmd_mem_sync_map_to_gpu() exists because a map need not be coherent, and
 where it is not — Horizon maps anything without NVKMD_MEM_COHERENT
 CPU-cached — each call is an armDCacheClean walking the range line by line,
 so the tail of a partly-filled 64 KiB chunk is cleaned on every submit.
 The bytes written are already tracked: nvk_cmd_push carries its own range
 and nvk_mem_stream carries chunk_alloc_B.
Evidence: measured on a Nintendo Switch (GM20B), Godot 4.0.5 template_release
 at 1280x720, per-viewport CPU render time over 240 frames per phase,
 before -> after: 2000 cubes / 1999 draws 8.55 -> 8.17 ms (-4.4%),
 800 cubes 3.82 -> 3.71 ms (-2.9%), 800 cubes + directional shadow
 8.47 -> 8.49 ms, 1200 sprites 4.25 -> 4.25 ms, idle 0.37 -> 0.38 ms.
 GPU time unchanged everywhere (2000 cubes 12.99 -> 12.94 ms). The effect is
 bounded by design — a command buffer's chunks are full but for the last —
 and one run per configuration, so only the two command-heavy phases are
 outside the noise.
Upstream: yes — it is a general improvement (clean what was written, not the
 allocation) with no Horizon conditional, and a no-op on a coherent backend.

used_B stays zero for a chunk the CPU never writes: nvk_cmd_indirect.c
allocates chunks a shader fills, and those need no clean at all.
---
 src/nouveau/vulkan/nvk_cmd_buffer.c | 11 +++++++++--
 src/nouveau/vulkan/nvk_cmd_draw.c   |  1 +
 src/nouveau/vulkan/nvk_cmd_pool.c   |  5 +++++
 src/nouveau/vulkan/nvk_cmd_pool.h   | 13 +++++++++++++
 src/nouveau/vulkan/nvk_mem_stream.c |  7 ++++++-
 5 files changed, 34 insertions(+), 3 deletions(-)

diff --git a/src/nouveau/vulkan/nvk_cmd_buffer.c b/src/nouveau/vulkan/nvk_cmd_buffer.c
index 85520d3527c..4e14e339521 100644
--- a/src/nouveau/vulkan/nvk_cmd_buffer.c
+++ b/src/nouveau/vulkan/nvk_cmd_buffer.c
@@ -199,6 +199,9 @@ nvk_cmd_buffer_flush_push(struct nvk_cmd_buffer *cmd, bool incomplete)
       };
       util_dynarray_append(&cmd->pushes, push);
 
+      cmd->push_mem->used_B = MAX2(cmd->push_mem->used_B,
+                                   mem_offset + push.range);
+
       cmd->prev_subc = NVC0_FIFO_SUBC_FROM_PKHDR(cmd->push.last_hdr_dw);
    }
 
@@ -263,6 +266,8 @@ nvk_cmd_buffer_upload_alloc(struct nvk_cmd_buffer *cmd,
       *ptr = (char *)cmd->upload_mem->mem->map + offset;
 
       cmd->upload_offset = offset + size;
+      cmd->upload_mem->used_B = MAX2(cmd->upload_mem->used_B,
+                                     cmd->upload_offset);
 
       return VK_SUCCESS;
    }
@@ -378,8 +383,10 @@ nvk_BeginCommandBuffer(VkCommandBuffer commandBuffer,
 static void
 flush_mem_list(struct nvk_cmd_buffer *cmd, struct list_head *mem_list)
 {
-   list_for_each_entry_safe(struct nvk_cmd_mem, mem, mem_list, link)
-      nvkmd_mem_sync_map_to_gpu(mem->mem, 0, mem->mem->size_B);
+   list_for_each_entry_safe(struct nvk_cmd_mem, mem, mem_list, link) {
+      if (mem->used_B > 0)
+         nvkmd_mem_sync_map_to_gpu(mem->mem, 0, mem->used_B);
+   }
 }
 
 VKAPI_ATTR VkResult VKAPI_CALL
diff --git a/src/nouveau/vulkan/nvk_cmd_draw.c b/src/nouveau/vulkan/nvk_cmd_draw.c
index d8afc1cd771..14c02367af6 100644
--- a/src/nouveau/vulkan/nvk_cmd_draw.c
+++ b/src/nouveau/vulkan/nvk_cmd_draw.c
@@ -5678,6 +5678,7 @@ nvk_cmd_begin_cond_render_copy_engine(struct nvk_cmd_buffer *cmd,
        */
       assert(cmd->cond_render_mem->mem->size_B > 32);
       memset(cmd->cond_render_mem->mem->map, 0x00, 32);
+      cmd->cond_render_mem->used_B = MAX2(cmd->cond_render_mem->used_B, 32);
    }
    const uint64_t tmp_addr = cmd->cond_render_mem->mem->va->addr;
 
diff --git a/src/nouveau/vulkan/nvk_cmd_pool.c b/src/nouveau/vulkan/nvk_cmd_pool.c
index 7297e94272d..fbabd31f06b 100644
--- a/src/nouveau/vulkan/nvk_cmd_pool.c
+++ b/src/nouveau/vulkan/nvk_cmd_pool.c
@@ -153,6 +153,11 @@ nvk_cmd_pool_alloc_mem(struct nvk_cmd_pool *pool, bool force_gart,
       memset(mem->mem->map, 0xF1, mem->mem->size_B);
    }
 
+   /* Recycled chunks come back from the free list carrying the previous
+    * user's watermark; the trash fill above is not a write the GPU reads.
+    */
+   mem->used_B = 0;
+
    *mem_out = mem;
    return VK_SUCCESS;
 }
diff --git a/src/nouveau/vulkan/nvk_cmd_pool.h b/src/nouveau/vulkan/nvk_cmd_pool.h
index 6d556ef3952..d1268f94f79 100644
--- a/src/nouveau/vulkan/nvk_cmd_pool.h
+++ b/src/nouveau/vulkan/nvk_cmd_pool.h
@@ -17,6 +17,19 @@ struct nvkmd_mem;
 struct nvk_cmd_mem {
    struct nvkmd_mem *mem;
 
+   /** Bytes written by the CPU, from the start of the chunk.
+    *
+    * Only this much has to be made visible to the GPU. On a KMD whose maps
+    * are coherent the distinction costs nothing, because the sync is a
+    * no-op; on one that maps command memory CPU-cached it is the difference
+    * between cleaning what was written and cleaning the whole 64 KiB chunk
+    * on every vkEndCommandBuffer.
+    *
+    * Zero for a chunk the CPU never wrote — nvk_cmd_indirect.c allocates
+    * chunks that only a shader writes.
+    */
+   uint32_t used_B;
+
    /** Link in nvk_cmd_pool::free_bos or nvk_cmd_buffer::bos */
    struct list_head link;
 };
diff --git a/src/nouveau/vulkan/nvk_mem_stream.c b/src/nouveau/vulkan/nvk_mem_stream.c
index b59160ece87..16f90772a5e 100644
--- a/src/nouveau/vulkan/nvk_mem_stream.c
+++ b/src/nouveau/vulkan/nvk_mem_stream.c
@@ -201,8 +201,13 @@ nvk_mem_stream_sync_chunks_to_gpu(struct nvk_mem_stream *stream)
    if (stream->chunk != NULL) {
       assert(stream->chunk->idle_time_point <= stream->next_time_point);
       if (stream->chunk->idle_time_point == stream->next_time_point) {
+         /* chunk_alloc_B is how far into this chunk the stream has handed
+          * memory out, which is exactly how far the CPU may have written.
+          * The chunks on the recycle list below are full by construction —
+          * that is why they were retired — so those still go in whole.
+          */
          nvkmd_mem_sync_map_to_gpu(stream->chunk->mem, 0,
-                                   NVK_MEM_STREAM_MAX_ALLOC_SIZE);
+                                   stream->chunk_alloc_B);
       }
    }
 
