diff --git a/src/vulkan/wsi/wsi_common.h b/src/vulkan/wsi/wsi_common.h
index 196d17d..60bcea1 100644
--- a/src/vulkan/wsi/wsi_common.h
+++ b/src/vulkan/wsi/wsi_common.h
@@ -50,6 +50,46 @@ struct wsi_interface;
 struct vk_instance;
 struct vk_queue;
 
+/** What Horizon's display block needs to know about an image's memory.
+ *
+ * Filled in by the driver through wsi_device::horizon::get_image_info.
+ * Everything here is a fact about the allocation, not a request: the
+ * WSI backend validates it and declines to scan the image out if it
+ * does not fit what an NvGraphicBuffer can express.
+ */
+struct wsi_horizon_image_info {
+   /** The window system's name for the memory — Horizon's NvMap id. */
+   uint32_t scanout_id;
+   /** Where the image starts inside that object, and how big it is. */
+   uint64_t offset_B;
+   uint64_t size_B;
+   /** Distance between rows of GOBs, in bytes. */
+   uint32_t row_stride_B;
+   /** log2 of the block height, in GOBs. */
+   uint32_t block_height_log2;
+   /** The page-table entry kind the image is mapped with. */
+   uint8_t pte_kind;
+   /** False for a pitch-linear image. */
+   bool block_linear;
+   /** True when the GOB's internal sector ordering is the one this
+    * platform's display block reads.
+    *
+    * A boolean and not the layout itself, because naming the layout
+    * would mean naming the driver's own enumeration in an interface the
+    * driver implements. The driver knows which of its layouts the
+    * display can read; the WSI knows what to do when the answer is no.
+    */
+   bool gob_layout_is_display;
+};
+
+/** A syncpoint fence, as Horizon's compositor consumes them. */
+struct wsi_horizon_fence {
+   uint32_t syncpt_id;
+   uint32_t threshold;
+   /** False when there is nothing to wait for. */
+   bool valid;
+};
+
 struct driOptionCache;
 
 /* Sized from the LAST enumerator of VkIcdWsiPlatform, not from the last
@@ -172,6 +212,36 @@ struct wsi_device {
       void (*encode_drawable_present)(VkCommandBuffer cmd, void *drawable);
    } metal;
 
+   struct {
+      /** How this image's memory looks to Horizon's display block.
+       *
+       * The WSI backend needs the image's layout to decide whether the
+       * compositor can scan it out as it stands, and the layout is the
+       * driver's to describe: vkGetImageSubresourceLayout is invalid
+       * usage on a VK_IMAGE_TILING_OPTIMAL image, which every
+       * renderable image here is.
+       *
+       * VK_ERROR_FEATURE_NOT_PRESENT means "this image cannot be
+       * presented directly". That is an ordinary answer — the backend
+       * turns it into a copy and logs the reason — and not a failure.
+       */
+      VkResult (*get_image_info)(VkDevice device, VkImage image,
+                                 VkDeviceMemory memory,
+                                 struct wsi_horizon_image_info *info_out);
+
+      /** The syncpoint fence `fence` will be signalled by.
+       *
+       * `abs_timeout_ns` bounds a wait for the fence's *submission*, not
+       * for its completion; handing the compositor a fence it can wait
+       * on itself is the whole reason this exists.
+       * wsi_horizon_fence::valid is false when there is nothing to wait
+       * for.
+       */
+      VkResult (*get_fence)(VkDevice device, VkFence fence,
+                            uint64_t abs_timeout_ns,
+                            struct wsi_horizon_fence *fence_out);
+   } horizon;
+
 
    bool sw;
 
