+// Copyright (c) mesa-nvk-horizon contributors
+// SPDX-License-Identifier: MIT
+
+//! The parts of `std::io` this crate actually used.
+//!
+//! `MemStream` and `NirInstrPrinter` call `open_memstream`, `fflush` and
+//! `fseek` through the C bindings and report whether the C call failed.
+//! No Rust code here reads or writes anything, so what `std::io` was
+//! supplying is a `Result` alias and a way to say "the C call failed".
+//! Both are reproduced here so the crate does not need an operating
+//! system to say so.
+
+use core::fmt;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ErrorKind {
+    /// The C call failed and set errno; the value is not carried,
+    /// because nothing in this crate ever looked at it.
+    Other,
+    InvalidInput,
+}
+
+#[derive(Debug, Clone)]
+pub struct Error {
+    kind: ErrorKind,
+    msg: &'static str,
+}
+
+impl Error {
+    pub fn new(kind: ErrorKind, msg: &'static str) -> Self {
+        Error { kind, msg }
+    }
+
+    /// Named after the std function it replaces, so the call sites read
+    /// the same. The errno value itself is deliberately not captured:
+    /// no caller in this crate inspects it, and reading errno from Rust
+    /// would be a second C dependency for no gain.
+    pub fn last_os_error() -> Self {
+        Error {
+            kind: ErrorKind::Other,
+            msg: "C library call failed",
+        }
+    }
+
+    pub fn kind(&self) -> ErrorKind {
+        self.kind
+    }
+}
+
+impl fmt::Display for Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{}", self.msg)
+    }
+}
+
+pub type Result<T> = core::result::Result<T, Error>;
