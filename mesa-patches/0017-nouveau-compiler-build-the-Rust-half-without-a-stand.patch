diff --git a/src/nouveau/compiler/nak/lib.rs b/src/nouveau/compiler/nak/lib.rs
index 55cb3e1..cebd70e 100644
--- a/src/nouveau/compiler/nak/lib.rs
+++ b/src/nouveau/compiler/nak/lib.rs
@@ -1,6 +1,79 @@
 // Copyright © 2023 Collabora, Ltd.
 // SPDX-License-Identifier: MIT
 
+#![no_std]
+// A Vulkan driver for a platform with no operating-system runtime has no
+// `std` to link: `aarch64-nintendo-switch-freestanding` is a tier-3 target
+// whose spec says `"std": false`, and Rust's `horizon` support in `std` is
+// the 3DS's, reached through the unix PAL this target does not have. What
+// these crates actually use from `std` is `core` and `alloc` under another
+// name; the handful of genuinely operating-system uses are replaced
+// individually.
+//
+// `#[macro_use]` so `vec!` and `format!` keep working crate-wide, as they
+// do through the std prelude.
+#[macro_use]
+extern crate alloc;
+
+// hashbrown, under the name Meson gives the host-machine build of it:
+// two targets in one project cannot share a name, and the native build
+// (which indexmap uses) already has `hashbrown`. Aliased here so the
+// `use hashbrown::…` in the sources reads the way it should.
+extern crate hashbrown_host as hashbrown;
+
+
+
+/// `eprint!`/`eprintln!` without `std`.
+///
+/// NAK writes debug output to stderr in twenty-one places, every one of
+/// them behind a NAK_DEBUG flag. What `std`'s macros ultimately do is
+/// write(2) to file descriptor 2, and that is available here — newlib
+/// provides it, and libnx wires it to whatever the process has open.
+/// So the macros are reproduced rather than the call sites rewritten.
+///
+/// A short-write or an error is ignored, exactly as `eprintln!` ignores
+/// them: this is debug output, and failing to print it must not change
+/// what the compiler does.
+#[doc(hidden)]
+pub fn __write_stderr(s: &str) {
+    extern "C" {
+        fn write(fd: i32, buf: *const core::ffi::c_void, n: usize) -> isize;
+    }
+    if !s.is_empty() {
+        unsafe {
+            write(2, s.as_ptr() as *const core::ffi::c_void, s.len());
+        }
+    }
+}
+
+macro_rules! eprint {
+    ($($arg:tt)*) => {
+        $crate::__write_stderr(&alloc::format!($($arg)*))
+    };
+}
+
+macro_rules! eprintln {
+    () => { $crate::__write_stderr("\n") };
+    ($($arg:tt)*) => {{
+        let mut s = alloc::format!($($arg)*);
+        s.push('\n');
+        $crate::__write_stderr(&s)
+    }};
+}
+
+
+/// `FxHashMap`/`FxHashSet` without `std`.
+///
+/// rustc-hash defines these two aliases only under its `std` feature,
+/// because there they are `std::collections::HashMap` with a different
+/// hasher — and `alloc` has no hash map at all. hashbrown is the same
+/// implementation `std` itself uses, so pairing it with rustc-hash's
+/// `FxBuildHasher` gives back exactly what the aliases meant, with the
+/// same API and the same hash function.
+pub type FxHashMap<K, V> =
+    hashbrown::HashMap<K, V, rustc_hash::FxBuildHasher>;
+pub type FxHashSet<T> = hashbrown::HashSet<T, rustc_hash::FxBuildHasher>;
+
 mod api;
 mod assign_regs;
 mod builder;
