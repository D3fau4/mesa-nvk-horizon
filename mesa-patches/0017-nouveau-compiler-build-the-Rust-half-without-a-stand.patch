diff --git a/src/nouveau/rust_runtime/lib.rs b/src/nouveau/rust_runtime/lib.rs
new file mode 100644
index 0000000..5a691b3
--- /dev/null
+++ b/src/nouveau/rust_runtime/lib.rs
@@ -0,0 +1,83 @@
+// Copyright (c) mesa-nvk-horizon contributors
+// SPDX-License-Identifier: MIT
+
+//! The one Rust staticlib in a driver built without `std`.
+//!
+//! Rust requires exactly one `#[global_allocator]` and one
+//! `#[panic_handler]` per linked artefact, and emits both into every
+//! `--crate-type staticlib` it produces. Mesa builds NAK and NIL as two
+//! staticlibs, which works with `std` because `std` supplies the shim
+//! and the archive member holding it is simply not pulled in a second
+//! time. Without `std` each archive defines the shim itself, beside the
+//! code that uses it, and the two collide:
+//!
+//! ```text
+//! ld: libnil.a(...): multiple definition of `__rustc::__rust_alloc';
+//!     libnak_rs.a(...): first defined here
+//! ```
+//!
+//! So NAK and NIL become rlibs and this crate is the staticlib. It adds
+//! no code of its own: it names the two crates so the linker keeps
+//! them, and supplies the two items only a whole program can decide.
+
+#![no_std]
+
+extern crate alloc;
+
+// Not unused. A staticlib only pulls in an upstream rlib that something
+// references, and nothing in *this* crate calls NAK or NIL — the callers
+// are on the C side. Naming them here is what puts their code, and their
+// `#[no_mangle]` entry points, into the archive.
+// nak_rs, not nak: Meson derives a Rust crate's name from its target
+// name, and the target that builds nak/lib.rs is called 'nak_rs' — 'nak'
+// is the C archive around it.
+extern crate nak_rs;
+extern crate nil;
+
+use core::alloc::{GlobalAlloc, Layout};
+
+extern "C" {
+    /// The C library's aligned allocator. Every allocation in the
+    /// driver already goes through this one on the C side, so routing
+    /// Rust's through it too means one heap and one set of statistics
+    /// rather than two.
+    fn memalign(alignment: usize, size: usize) -> *mut u8;
+    fn free(ptr: *mut u8);
+    fn abort() -> !;
+}
+
+struct CLibAlloc;
+
+unsafe impl GlobalAlloc for CLibAlloc {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        // memalign() requires a power-of-two alignment that is a
+        // multiple of sizeof(void *); Layout guarantees the first, and
+        // the second is why the alignment is raised rather than passed
+        // through. A null return is what GlobalAlloc expects on
+        // failure, so no check is needed here.
+        let align = if layout.align() < core::mem::size_of::<usize>() {
+            core::mem::size_of::<usize>()
+        } else {
+            layout.align()
+        };
+        unsafe { memalign(align, layout.size()) }
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, _layout: Layout) {
+        unsafe { free(ptr) }
+    }
+}
+
+#[global_allocator]
+static ALLOCATOR: CLibAlloc = CLibAlloc;
+
+/// The target's panic strategy is `abort`, so this is only ever reached
+/// through `panic!` itself and never through unwinding. It ends the
+/// process rather than returning, which is what `abort` means, and it
+/// does not try to print: a panic in a shader compiler on a console has
+/// no terminal to print to, and the alternative — allocating a message
+/// while the program is already failing — is worse than silence.
+#[panic_handler]
+fn panic(_info: &core::panic::PanicInfo) -> ! {
+    unsafe { abort() }
+}
