+      nvk_horizon_sync_set_fence(signals[i].sync, ctx->chan, &ctx->meter,
                                  ctx->last_fence, signals[i].signal_value);
    }
 
@@ -405,6 +608,13 @@ nvkmd_horizon_create_ctx(struct nvkmd_dev *_dev,
                        "nv 0x%08" PRIx32, (int)res.status, res.nv);
    }
 
+   /* Before the first submit, so the meter's channel pointer is right,
+    * and deliberately before bind_engines: that submit happens once at
+    * creation and counting it would put a sample into a window nothing
+    * else is in yet.
+    */
+   nvkmd_horizon_meter_init(&ctx->meter, ctx->chan);
+
    /* Asynchronous: bind_engines submits and returns a fence rather than
     * waiting for it. The next submit on this channel is ordered after
     * it by the channel itself, so there is nothing to wait for here.
@@ -412,6 +622,9 @@ nvkmd_horizon_create_ctx(struct nvkmd_dev *_dev,
    horizon_gpu_fence bind_fence;
