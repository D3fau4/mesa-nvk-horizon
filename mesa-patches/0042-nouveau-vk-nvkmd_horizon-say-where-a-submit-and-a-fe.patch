+   /* Borrowed from the same context, on the same terms as `chan`, and
+    * NULL for exactly the same reason: nothing has submitted with this
+    * object yet. A wait folds its split into whichever meter the submit
+    * that will signal it belongs to. */
+   struct nvkmd_horizon_meter *meter;
+   /* When that submit attached the fence, by os_time_get_nano. Zero
+    * when there is no fence. Only the meter reads it. */
+   uint64_t fence_set_ns;
+
    /* Timeline bookkeeping.
     *
     * nvk_mem_stream_init creates its stream sync on sync_types[0] with
@@ -241,9 +327,26 @@ extern const struct vk_sync_type nvk_horizon_sync_type;
 
