 /* The channel fence this sync will be signalled by, for a consumer
  * outside the GPU — the display block, which can wait on a syncpoint
  * itself. `abs_timeout_ns` bounds a wait for the sync to become
diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c
index e7eb770fa16..07f8c05f7da 100644
--- a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c
@@ -13,15 +13,200 @@
 #include "util/log.h"
 #include "util/macros.h"
 #include "util/os_time.h"
+#include "util/u_debug.h"
 #include "util/u_memory.h"
 
 #include <inttypes.h>
 
+/* ---- the submit and fence-wait meter ------------------------------
+ *
+ * State and rationale in nvkmd_horizon.h. The code is here because the
+ * context owns the state; nvkmd_horizon_sync.c folds into it through
+ * the four entry points below.
+ */
+
+/* How much of a window one line covers. One second, the same figure the
+ * WSI acquire meter uses, so the two can be read side by side against
+ * the same frames. */
+#define NVKMD_HORIZON_METER_PERIOD_NS UINT64_C(1000000000)
+
+/* b - a, or 0. Guarded rather than reasoned about: os_time_get_nano is
+ * the real-time clock on this platform (decision D8, t_ostime measured
+ * it), so a console whose date moves mid-window would otherwise turn one
+ * bad sample into a mean of several centuries. */
+static uint64_t
+nvkmd_horizon_meter_since(uint64_t a, uint64_t b)
+{
+   return b > a ? b - a : 0;
+}
+
+/* Reports the window and starts a new one, if it is old enough or the
+ * meter is being torn down. Called with `m->mutex` held: the numbers in
+ * one line have to be a consistent set, and a sample folded in between
+ * the print and the reset would be lost rather than carried over. */
+static void
+nvkmd_horizon_meter_report_locked(struct nvkmd_horizon_meter *m,
+                                  uint64_t now_ns, bool final)
+{
+   if (m->window_start_ns == 0)
+      return;
+
+   const uint64_t window_ns =
+      nvkmd_horizon_meter_since(m->window_start_ns, now_ns);
+   if (!final && window_ns < NVKMD_HORIZON_METER_PERIOD_NS)
+      return;
+
+   const uint64_t window_ms = window_ns / 1000000u;
+
+   mesa_logi("nvkmd_horizon: channel %p over %" PRIu64 " ms: %" PRIu32
+             " submit(s); %" PRIu32 " CPU wait(s) for another channel "
+             "totalling %" PRIu64 " us, %" PRIu32 " wait(s) skipped as "
+             "already ordered by this channel",
+             (void *)m->chan, window_ms, m->submits, m->ctx_waits,
+             m->ctx_wait_ns / 1000u, m->ctx_waits_skipped);
+
+   /* Means beside the count they were computed from — a mean with no
+    * denominator next to it is not a measurement anybody can check. */
+   if (m->fence_waits > 0) {
+      mesa_logi("nvkmd_horizon: channel %p over %" PRIu64 " ms: %" PRIu32
+                " fence wait(s) blocked, mean %" PRIu64 " us (max %" PRIu64
+                "), of which %" PRIu64 " us before a fence existed and %"
+                PRIu64 " us on the syncpoint; mean fence age when the wait "
+                "returned %" PRIu64 " us",
+                (void *)m->chan, window_ms, m->fence_waits,
+                m->fence_wait_ns / m->fence_waits / 1000u,
+                m->max_fence_wait_ns / 1000u,
+                m->before_fence_ns / m->fence_waits / 1000u,
+                (m->fence_wait_ns - m->before_fence_ns) / m->fence_waits
+                   / 1000u,
+                m->fence_age_ns / m->fence_waits / 1000u);
+   } else {
+      mesa_logi("nvkmd_horizon: channel %p over %" PRIu64 " ms: no fence "
+                "wait blocked", (void *)m->chan, window_ms);
+   }
+
+   /* `enabled` and `chan` survive; everything the window accumulated
+    * does not, so the next line is about the next second rather than
+    * about the whole session. */
+   m->window_start_ns = 0;
+   m->submits = 0;
+   m->ctx_waits = 0;
+   m->ctx_waits_skipped = 0;
+   m->ctx_wait_ns = 0;
+   m->fence_waits = 0;
+   m->fence_wait_ns = 0;
+   m->before_fence_ns = 0;
+   m->max_fence_wait_ns = 0;
+   m->fence_age_ns = 0;
+}
+
+void
+nvkmd_horizon_meter_init(struct nvkmd_horizon_meter *m,
+                         horizon_gpu_channel *chan)
+{
+   /* The context is CALLOC_STRUCTed, so every counter is already zero;
+    * only the two things zero is the wrong value for are set here. */
+   simple_mtx_init(&m->mutex, mtx_plain);
+   m->chan = chan;
+   m->enabled = debug_get_bool_option("MESA_VK_NVKMD_HORIZON_SUBMIT_STATS",
+                                      false);
+}
+
+void
+nvkmd_horizon_meter_finish(struct nvkmd_horizon_meter *m)
+{
+   if (m->enabled) {
+      simple_mtx_lock(&m->mutex);
+      /* Whatever the last window collected, reported rather than
+       * dropped: a run shorter than a second would otherwise print
+       * nothing at all, and so would the tail of every longer one. */
+      nvkmd_horizon_meter_report_locked(m, os_time_get_nano(), true);
+      simple_mtx_unlock(&m->mutex);
+   }
+   simple_mtx_destroy(&m->mutex);
+}
+
+void
+nvkmd_horizon_meter_submit(struct nvkmd_horizon_meter *m)
+{
+   if (m == NULL || !m->enabled)
+      return;
+
+   const uint64_t now_ns = os_time_get_nano();
+
+   simple_mtx_lock(&m->mutex);
+   if (m->window_start_ns == 0)
+      m->window_start_ns = now_ns;
+   m->submits++;
+   nvkmd_horizon_meter_report_locked(m, now_ns, false);
+   simple_mtx_unlock(&m->mutex);
+}
+
+void
+nvkmd_horizon_meter_ctx_wait(struct nvkmd_horizon_meter *m,
+                             bool skipped, uint64_t ns)
+{
+   if (m == NULL || !m->enabled)
+      return;
+
+   const uint64_t now_ns = os_time_get_nano();
+
+   simple_mtx_lock(&m->mutex);
+   if (m->window_start_ns == 0)
+      m->window_start_ns = now_ns;
+   if (skipped) {
+      m->ctx_waits_skipped++;
+   } else {
+      m->ctx_waits++;
+      m->ctx_wait_ns += ns;
+   }
+   nvkmd_horizon_meter_report_locked(m, now_ns, false);
+   simple_mtx_unlock(&m->mutex);
+}
+
+void
+nvkmd_horizon_meter_fence_wait(struct nvkmd_horizon_meter *m,
+                               uint64_t total_ns, uint64_t before_ns,
+                               uint64_t age_ns)
+{
+   if (m == NULL || !m->enabled)
+      return;
+
+   const uint64_t now_ns = os_time_get_nano();
+
+   /* The wait for a fence to exist happened inside the interval
+    * `total_ns` measures, so it cannot be the larger of the two.
+    * Clamped anyway: the reported split is a subtraction of these, and
+    * one underflow would print eighteen quintillion microseconds on the
+    * syncpoint. */
+   const uint64_t before_in_ns = before_ns < total_ns ? before_ns : total_ns;
+
+   simple_mtx_lock(&m->mutex);
+   if (m->window_start_ns == 0)
+      m->window_start_ns = now_ns;
+   m->fence_waits++;
+   m->fence_wait_ns += total_ns;
+   m->before_fence_ns += before_in_ns;
+   m->fence_age_ns += age_ns;
+   if (total_ns > m->max_fence_wait_ns)
+      m->max_fence_wait_ns = total_ns;
+   nvkmd_horizon_meter_report_locked(m, now_ns, false);
+   simple_mtx_unlock(&m->mutex);
+}
+
+/* ------------------------------------------------------------------ */
+
 static void
 nvkmd_horizon_ctx_destroy(struct nvkmd_ctx *_ctx)
 {
    struct nvkmd_horizon_ctx *ctx = nvkmd_horizon_ctx(_ctx);
 
+   /* First, and before the channel goes away: the last window is
+    * reported here, and the error path below returns without freeing
+    * the context, so anything left until after it would be lost in
+    * exactly the run that most wants explaining. */
+   nvkmd_horizon_meter_finish(&ctx->meter);
+
    /* horizon_gpu_channel_destroy fails with ERR_BUSY while submits are
     * in flight. nvkmd's contract is that the queue is idle before the
     * context goes away — vkDestroyDevice waits — so waiting again here
@@ -88,12 +273,20 @@ nvkmd_horizon_ctx_wait(struct nvkmd_ctx *_ctx,
        * which t_fault measured on hardware ("a submit to the lost
        * channel is refused").
        */
-      if (nvk_horizon_sync_is_pending_on(waits[i].sync, ctx->chan))
+      if (nvk_horizon_sync_is_pending_on(waits[i].sync, ctx->chan)) {
+         nvkmd_horizon_meter_ctx_wait(&ctx->meter, true, 0);
          continue;
+      }
 
       const struct vk_sync_type *type = waits[i].sync->type;
       assert(type->wait != NULL);
 
+      /* Timed unconditionally, two clock reads around a call that is
+       * about to block on another channel's work — the metered and
+       * unmetered paths stay the same code, and the cost is nothing
+       * beside what is being measured. */
+      const uint64_t start_ns = os_time_get_nano();
+
       /* NULL device: the sync type's wait() uses it only to build a
        * vk_errorf, and nvkmd has no vk_device to hand it — the layer
        * below the driver deliberately does not know about one.
@@ -101,6 +294,14 @@ nvkmd_horizon_ctx_wait(struct nvkmd_ctx *_ctx,
       VkResult result = type->wait(NULL, waits[i].sync, waits[i].wait_value,
                                    VK_SYNC_WAIT_COMPLETE,
                                    OS_TIMEOUT_INFINITE);
+
+      /* Folded before the result is checked: a wait that failed still
+       * spent the time, and dropping it would make a channel that is
+       * losing whole seconds to a faulted neighbour look idle. */
+      const uint64_t end_ns = os_time_get_nano();
+      nvkmd_horizon_meter_ctx_wait(&ctx->meter, false,
+                                   end_ns > start_ns ? end_ns - start_ns : 0);
+
       if (result != VK_SUCCESS)
