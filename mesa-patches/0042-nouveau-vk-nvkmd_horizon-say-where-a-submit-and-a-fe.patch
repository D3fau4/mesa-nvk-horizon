    }
@@ -241,6 +442,7 @@ nvkmd_horizon_ctx_exec(struct nvkmd_ctx *_ctx,
 
    ctx->last_fence = fence;
    ctx->has_fence = true;
+   nvkmd_horizon_meter_submit(&ctx->meter);
 
    /* No wait here. The submit is asynchronous and stays that way:
     * rejected design 6 is a property held from the first line, not
@@ -314,6 +516,7 @@ nvkmd_horizon_ctx_signal(struct nvkmd_ctx *_ctx,
       }
       ctx->last_fence = fence;
       ctx->has_fence = true;
+      nvkmd_horizon_meter_submit(&ctx->meter);
    }
 
    for (uint32_t i = 0; i < signal_count; i++) {
@@ -321,7 +524,7 @@ nvkmd_horizon_ctx_signal(struct nvkmd_ctx *_ctx,
        * stream sync with a monotonically increasing push counter and
        * then asks for it back through vk_sync_get_value. Dropping it
