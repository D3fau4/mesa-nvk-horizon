--- a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon.h
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon.h
@@ -160,6 +160,81 @@ void nvkmd_horizon_describe_addr(struct nvkmd_horizon_dev *dev,
 void nvkmd_horizon_dump_va_map(struct nvkmd_horizon_dev *dev,
                                uint32_t max_lines);
 
+/* WHERE A SUBMIT AND A FENCE WAIT ACTUALLY GO, measured from inside the
+ * application that is complaining about them.
+ *
+ * "vkWaitForFences took N milliseconds" is one number, and at least four
+ * different things this backend does produce it:
+ *
+ *   - the syncpoint genuinely reached its threshold that late, which is
+ *     the GPU taking that long;
+ *   - there was no fence to wait on yet, so the wait sat in the
+ *     condition variable of decision D16 until a submit attached one.
+ *     Time here means the caller waited for something nobody had
+ *     submitted, not that anything was slow;
+ *   - the submit that would have signalled it was itself blocked in
+ *     nvkmd_horizon_ctx_wait, doing on the CPU a wait belonging to
+ *     another channel, with the queue held behind it;
+ *   - the fence is far younger than the caller believes, so the wait is
+ *     not the pipelined one it was written to be. A mean age of one
+ *     millisecond under an application that thinks it is waiting for
+ *     work from three frames ago says the pipelining is not happening.
+ *
+ * From outside those are indistinguishable. This meter is the split.
+ * It is per context, so the exec channel and the upload channel report
+ * separately instead of averaging into each other — and a cross-channel
+ * wait therefore appears once as a CPU wait on the channel that
+ * performed it and once as a fence wait on the channel that owned the
+ * fence, which is two true statements about one event rather than
+ * double counting inside either line.
+ *
+ * Off unless MESA_VK_NVKMD_HORIZON_SUBMIT_STATS asks for it.
+ *
+ * GUARDED, unlike the WSI acquire meter it is modelled on. That one is
+ * safe unlocked because vkAcquireNextImageKHR externally synchronises
+ * its swapchain; nothing externally synchronises this. vkWaitForFences
+ * may run on any thread while a submit runs on another, and both fold
+ * samples in here.
+ */
+struct nvkmd_horizon_meter {
+   bool enabled;
+
+   /* The channel these numbers are about, so the line names it.
+    * Borrowed from the context this meter is embedded in, which cannot
+    * outlive it. */
+   horizon_gpu_channel *chan;
+
+   simple_mtx_t mutex;
+
+   /* When the window being accumulated into opened. Zero until the
+    * first metered event, which is what opens it. */
+   uint64_t window_start_ns;
+
+   uint32_t submits;
+
+   /* nvkmd_horizon_ctx_wait: the waits it performed on the CPU, and the
+    * ones it skipped because this channel had already ordered them. */
+   uint32_t ctx_waits;
+   uint32_t ctx_waits_skipped;
+   uint64_t ctx_wait_ns;
+
+   /* nvk_horizon_sync_wait, counting only the waits that blocked and
+    * then succeeded. A wait that found the sync already signalled cost
+    * nothing and would only dilute the mean; one that timed out
+    * measures the caller's patience rather than the fence, which is the
+    * same reason the WSI acquire meter counts only acquires that
+    * returned an image. */
+   uint32_t fence_waits;
+   uint64_t fence_wait_ns;
+   /* Of fence_wait_ns, the part spent before the sync had a fence at
+    * all. The rest was spent on the syncpoint. */
+   uint64_t before_fence_ns;
+   uint64_t max_fence_wait_ns;
+   /* Sum, over the same waits, of how old the fence was when the wait
+    * returned — measured from the submit that attached it. */
+   uint64_t fence_age_ns;
+};
+
 struct nvkmd_horizon_ctx {
    struct nvkmd_ctx base;
 
@@ -172,6 +247,8 @@ struct nvkmd_horizon_ctx {
     */
    horizon_gpu_fence last_fence;
    bool has_fence;
+
+   struct nvkmd_horizon_meter meter;
 };
 
 NVKMD_DECL_SUBCLASS(ctx, horizon);
