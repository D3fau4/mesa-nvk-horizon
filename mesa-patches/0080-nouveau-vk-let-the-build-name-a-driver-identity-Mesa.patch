From dfc9d4343afdecae637790e177391a2a42dd1685 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 10 Aug 2026 23:41:11 +0000
Subject: [PATCH 80/81] nouveau/vk: let the build name a driver identity Mesa's
 version cannot
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

mesa-nvk-horizon: Phase 7 item 1 (Mesa shader disk cache on Horizon)
Why: on a platform with no dynamic loader there is no ELF build id, so
 patch 0018 derives instance->driver_build_sha from PACKAGE_VERSION and
 MESA_GIT_SHA1. Both describe the pinned Mesa checkout. Neither
 describes the out-of-tree patch series or the platform layer, which
 together are most of this driver and can change the machine code a
 shader compiles to — NAK, NIL and nvkmd_horizon all live there.

 That was written down as an acceptable limitation, and while the
 identifier was only driverUUID and the pipeline cache UUID it was one:
 the cost of a stale UUID is an application reusing its own blob. It
 stops being acceptable the moment the identifier keys a shader *disk*
 cache, because then it decides whether binaries compiled by the
 previous build are handed to this one. That failure has no error path
 and no line in any log; it is a wrong render or an MMU fault, which is
 the class of bug this port has already spent hardware runs chasing.
Evidence: measured, on this tree. Two builds of the same pinned Mesa
 with a changed patch series produce an identical driver id today:

   $ git -C mesa log -1 --format=%H          # unchanged between builds
   ffa422e53d59a4938b38abd5c3fc319555da31dd
   $ grep -n 'PACKAGE_VERSION\|MESA_GIT_SHA1' src/nouveau/vulkan/nvk_instance.c
   222:   _mesa_blake3_update(&blake3_ctx, PACKAGE_VERSION, ...
   225:   _mesa_blake3_update(&blake3_ctx, MESA_GIT_SHA1, ...

 — the two inputs are the only ones, and neither reads mesa-patches/ or
 horizon/. nvk_physical_device.c:1349-1366 then formats that same value
 as the `timestamp` argument of disk_cache_create(), and
 disk_cache_compute_key() hashes it into every key, so the disk cache
 inherits the problem exactly.
Upstream: no — HORIZON_DRIVER_ID is named for the platform that needs
 it, and the mechanism only exists on the branch that runs when
 build_id_find_nhdr_for_addr() is unavailable. It is additive: an empty
 -Dhorizon-driver-id leaves every existing build byte for byte as it was.
---
 meson.build                       | 12 ++++++++++++
 meson.options                     | 13 +++++++++++++
 src/nouveau/vulkan/nvk_instance.c | 29 +++++++++++++++++++++++------
 3 files changed, 48 insertions(+), 6 deletions(-)

diff --git a/meson.build b/meson.build
index e387685..8e5e659 100644
--- a/meson.build
+++ b/meson.build
@@ -1167,6 +1167,18 @@ if with_shader_cache
   endif
 endif
 
+# The identity of a driver build that has no ELF build id to be identified
+# by. Horizon has no dynamic loader, so build_id_find_nhdr_for_addr() —
+# and therefore the usual source of driverUUID, the pipeline cache UUID
+# and the shader disk cache key — is unavailable, and what is left
+# (PACKAGE_VERSION, MESA_GIT_SHA1) describes Mesa and not the rest of the
+# driver. Whoever builds such a driver passes an identifier that covers
+# all of it; an empty option leaves the existing behaviour untouched.
+horizon_driver_id = get_option('horizon-driver-id')
+if horizon_driver_id != ''
+  pre_args += '-DHORIZON_DRIVER_ID="@0@"'.format(horizon_driver_id)
+endif
+
 # Check for GCC style builtins
 foreach b : ['bswap32', 'bswap64', 'clz', 'clzll', 'ctz', 'expect', 'ffs',
              'ffsll', 'popcount', 'popcountll', 'unreachable', 'types_compatible_p']
diff --git a/meson.options b/meson.options
index 099120b..1c5a1a9 100644
--- a/meson.options
+++ b/meson.options
@@ -819,6 +819,19 @@ option(
                 'uses it in place of libdrm and the nouveau winsys.'
 )
 
+option(
+  'horizon-driver-id',
+  type : 'string',
+  value : '',
+  description : 'Opaque identifier of the whole Horizon driver build — ' +
+                'the Mesa commit, the out-of-tree patch series and the ' +
+                'platform layer. Horizon has no dynamic loader, so there ' +
+                'is no ELF build id to derive driverUUID, the pipeline ' +
+                'cache UUID and the shader disk cache key from; without ' +
+                'this they would follow Mesa\'s version alone and would ' +
+                'not change when the port changes.'
+)
+
 option(
   'install-mesa-clc',
   type : 'boolean',
diff --git a/src/nouveau/vulkan/nvk_instance.c b/src/nouveau/vulkan/nvk_instance.c
index 0d8039f..c105a69 100644
--- a/src/nouveau/vulkan/nvk_instance.c
+++ b/src/nouveau/vulkan/nvk_instance.c
@@ -210,12 +210,25 @@ nvk_CreateInstance(const VkInstanceCreateInfo *pCreateInfo,
     * this build does know about itself.
     *
     * PACKAGE_VERSION is Mesa's version and MESA_GIT_SHA1 is the commit
-    * it was built from when the build system could work that out. That
-    * is coarser than a link-time build id: two builds of the same
-    * source with different local patches hash the same. It is recorded
-    * as a limitation rather than papered over with __DATE__, which
-    * would change the UUID on every rebuild of unchanged source and
-    * break reproducible builds.
+    * it was built from when the build system could work that out.
+    *
+    * NEITHER OF THEM DESCRIBES THE REST OF THE DRIVER, and on a platform
+    * that reaches this branch most of the driver is the rest: an
+    * out-of-tree patch series and a platform layer, both of which can
+    * change the machine code a shader compiles to while Mesa's version
+    * and commit stay exactly where they were. This was recorded as a
+    * limitation while the identifier was only a UUID. It stops being one
+    * the moment a shader *disk* cache reads it, because then a stale key
+    * is not a cosmetic mismatch — it is last build's binary handed to
+    * this build's hardware, with no error path and no line in any log.
+    *
+    * So HORIZON_DRIVER_ID is mixed in when the build system supplies
+    * one. It is an opaque string, and what it has to promise is only
+    * this: it changes when anything that can change generated code
+    * changes, and it does not change otherwise — which is why it is a
+    * digest of sources and not __DATE__, that being the thing that
+    * would break reproducible builds and cold-start the cache on every
+    * rebuild of unchanged source.
     */
    struct mesa_blake3 blake3_ctx;
    _mesa_blake3_init(&blake3_ctx);
@@ -224,6 +237,10 @@ nvk_CreateInstance(const VkInstanceCreateInfo *pCreateInfo,
 #ifdef MESA_GIT_SHA1
    _mesa_blake3_update(&blake3_ctx, MESA_GIT_SHA1,
                        sizeof(MESA_GIT_SHA1) - 1);
+#endif
+#ifdef HORIZON_DRIVER_ID
+   _mesa_blake3_update(&blake3_ctx, HORIZON_DRIVER_ID,
+                       sizeof(HORIZON_DRIVER_ID) - 1);
 #endif
    _mesa_blake3_final(&blake3_ctx, instance->driver_build_sha);
 #endif
-- 
