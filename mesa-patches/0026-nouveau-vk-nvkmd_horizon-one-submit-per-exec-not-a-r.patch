From fa6a04ba62ec4ecc053950e43749719a2423627e Mon Sep 17 00:00:00 2001
From: mesa-nvk-horizon <mesa-nvk-horizon@localhost>
Date: Tue, 28 Jul 2026 14:26:04 +0000
Subject: [PATCH 26/57] nouveau/vk: nvkmd_horizon, one submit per exec, not a
 run of them
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

nvkmd_horizon_ctx_exec split the execs into runs whenever nvkmd's
per-entry no_prefetch flag changed, because nvkmd carries that flag per
entry and horizon_gpu_submit takes it per submit. The split bought
nothing and cost a stack overflow.

It bought nothing because horizon_gpu's only working submit mode,
HORIZON_GPU_SUBMIT_DEFAULT, is already NOT_MAIN | NO_PREFETCH
(horizon/include/horizon_gpu/submit.h:39). There is no prefetching
alternative to select — the other value is the R3 experiment that
failed on hardware — so every entry already got the conservative
behaviour and an entry asking for no_prefetch = false simply did not
get an optimisation. Every submit passed SUBMIT_DEFAULT regardless of
the run's flag, which is the same answer the splitting was computing.

It cost a stack overflow because the runs were built in a fixed
16-element array, and `incomplete` — an entry that ends mid-method,
whose continuation must land in the same submit — suppressed the flush
that capped it:

    if (n > 0 && !must_continue && (flag_changed || n == 16)) { flush; }
    spans[n] = ...;  /* n may be 16 */
    n++;

Seventeen consecutive incomplete entries wrote past the end of the
array, and n was then 17, so the `n == 16` test never matched again and
it kept going. Found by reading rather than by running: NVK is unlikely
to emit that many in one exec, which is what would have made this a bad
bug rather than an obvious one.

horizon_gpu_submit takes any number of spans and reports BUSY on a full
ring rather than truncating, so there is nothing to cap. One submit,
one span array sized to exec_count, and the dword check kept.

This retires "extension 2" of the six that Phase 4 step 1 enumerated:
per-span submit flags are not needed, because there is only one flag
combination that works.

mesa-nvk-horizon: Phase 4 — audit before the second hardware run
Why: a fixed-size array whose bound could be suppressed by a flag.
Evidence: read from the code; no run has produced it. The behavioural
  half — that SUBMIT_DEFAULT is already NO_PREFETCH — is
  horizon/include/horizon_gpu/submit.h:39.
Upstream: no — this is the Horizon backend's own submit path.
---
 .../vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c  | 98 +++++++++----------
 1 file changed, 47 insertions(+), 51 deletions(-)

diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c
index 77fe102..f511a98 100644
--- a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c
@@ -5,6 +5,8 @@
 
 #include "nvkmd_horizon.h"
 
+#include "util/stack_array.h"
+
 #include "vk_log.h"
 #include "vk_sync.h"
 
@@ -86,44 +88,38 @@ nvkmd_horizon_ctx_exec(struct nvkmd_ctx *_ctx,
    if (exec_count == 0)
       return VK_SUCCESS;
 
-   /* nvkmd carries no_prefetch *per entry*; horizon_gpu_submit takes it
-    * *per submit*. That mismatch is extension 2 of the six Phase 4 step
-    * 1 enumerated, and it is resolved here rather than by changing
-    * horizon_gpu: consecutive entries that agree go in one submit, and a
-    * change of flag ends the run. Every entry therefore gets the flag it
-    * asked for, at the cost of one extra kickoff per change — which in
-    * practice is zero, because NVK sets no_prefetch for a whole push.
+   /* ONE SUBMIT, NOT A RUN OF THEM.
+    *
+    * An earlier version of this split the execs into runs whenever
+    * nvkmd's per-entry no_prefetch flag changed, because nvkmd carries
+    * that flag per entry and horizon_gpu_submit takes it per submit.
+    * That was Phase 4 step 1's "extension 2", and it turns out not to
+    * exist: horizon_gpu's only working submit mode,
+    * HORIZON_GPU_SUBMIT_DEFAULT, is already NOT_MAIN | NO_PREFETCH
+    * (submit.h:39). There is no prefetching alternative to select —
+    * the other value is the R3 experiment that failed on hardware — so
+    * every entry already gets the conservative behaviour, and an entry
+    * asking for no_prefetch = false simply does not get an
+    * optimisation. Splitting bought nothing but extra kickoffs.
+    *
+    * Removing it also removes a stack overflow. The runs were built in
+    * a fixed 16-element array, and the `incomplete` flag — an entry
+    * that ends mid-method, whose continuation must land in the same
+    * submit — suppressed the flush that capped it. Seventeen
+    * consecutive incomplete entries wrote spans[16] past the end of a
+    * stack array and then never matched the `n == ARRAY_SIZE(spans)`
+    * test again, so it kept going. Found by reading, not by running:
+    * NVK is unlikely to emit that many, which is what would have made
+    * it a bad bug rather than an obvious one.
     *
-    * `incomplete` means the entry ends mid-method and the next entry
-    * supplies the data, so the two must land in the same submit. It
-    * therefore forces the run to continue regardless of the flag.
+    * horizon_gpu_submit takes any number of spans and reports BUSY on a
+    * full ring rather than truncating, so there is nothing to cap.
     */
-   horizon_gpu_cmd_span spans[16];
-   uint32_t n = 0;
-   bool run_no_prefetch = execs[0].no_prefetch;
-   bool must_continue = false;
+   STACK_ARRAY(horizon_gpu_cmd_span, spans, exec_count);
+   if (spans == NULL)
+      return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
 
    for (uint32_t i = 0; i < exec_count; i++) {
-      const bool flag_changed = execs[i].no_prefetch != run_no_prefetch;
-
-      if (n > 0 && !must_continue &&
-          (flag_changed || n == ARRAY_SIZE(spans))) {
-         horizon_gpu_fence fence;
-         horizon_gpu_result res =
-            horizon_gpu_submit(ctx->chan, spans, n,
-                               HORIZON_GPU_SUBMIT_DEFAULT, &fence);
-         if (res.status != HORIZON_GPU_OK) {
-            return vk_errorf(log_obj, nvkmd_horizon_result(res),
-                             "horizon_gpu_submit(%" PRIu32 " spans) failed: "
-                             "status %d, nv 0x%08" PRIx32,
-                             n, (int)res.status, res.nv);
-         }
-         ctx->last_fence = fence;
-         ctx->has_fence = true;
-         n = 0;
-         run_no_prefetch = execs[i].no_prefetch;
-      }
-
       /* A GPFIFO entry counts dwords, and nvkmd counts bytes. A size
        * that is not a multiple of four would silently lose the last
        * bytes of a push — the submit would succeed and the command
@@ -132,33 +128,33 @@ nvkmd_horizon_ctx_exec(struct nvkmd_ctx *_ctx,
        * here instead, where the cause is still in view.
        */
       if (execs[i].size_B % 4 != 0) {
+         STACK_ARRAY_FINISH(spans);
          return vk_errorf(log_obj, VK_ERROR_UNKNOWN,
                           "nvkmd_horizon: push %" PRIu32 " is %" PRIu32
                           " bytes, not a whole number of dwords",
                           i, execs[i].size_B);
       }
 
-      spans[n].gpu_va = execs[i].addr;
-      spans[n].num_dwords = execs[i].size_B / 4;
-      n++;
-      must_continue = execs[i].incomplete;
+      spans[i].gpu_va = execs[i].addr;
+      spans[i].num_dwords = execs[i].size_B / 4;
    }
 
-   if (n > 0) {
-      horizon_gpu_fence fence;
-      horizon_gpu_result res =
-         horizon_gpu_submit(ctx->chan, spans, n,
-                            HORIZON_GPU_SUBMIT_DEFAULT, &fence);
-      if (res.status != HORIZON_GPU_OK) {
-         return vk_errorf(log_obj, nvkmd_horizon_result(res),
-                          "horizon_gpu_submit(%" PRIu32 " spans) failed: "
-                          "status %d, nv 0x%08" PRIx32,
-                          n, (int)res.status, res.nv);
-      }
-      ctx->last_fence = fence;
-      ctx->has_fence = true;
+   horizon_gpu_fence fence;
+   horizon_gpu_result res =
+      horizon_gpu_submit(ctx->chan, spans, exec_count,
+                         HORIZON_GPU_SUBMIT_DEFAULT, &fence);
+   STACK_ARRAY_FINISH(spans);
+
+   if (res.status != HORIZON_GPU_OK) {
+      return vk_errorf(log_obj, nvkmd_horizon_result(res),
+                       "horizon_gpu_submit(%" PRIu32 " spans) failed: "
+                       "status %d, nv 0x%08" PRIx32,
+                       exec_count, (int)res.status, res.nv);
    }
 
+   ctx->last_fence = fence;
+   ctx->has_fence = true;
+
    /* No wait here. The submit is asynchronous and stays that way:
     * rejected design 6 is a property held from the first line, not
     * retrofitted.
-- 
