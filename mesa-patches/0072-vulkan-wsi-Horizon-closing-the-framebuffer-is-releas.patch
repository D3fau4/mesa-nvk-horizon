 src/vulkan/wsi/wsi_horizon.c | 148 ++++++++++++++++++++++++++---------
 1 file changed, 111 insertions(+), 37 deletions(-)

diff --git a/src/vulkan/wsi/wsi_horizon.c b/src/vulkan/wsi/wsi_horizon.c
index d6b0552..2c033e9 100644
--- a/src/vulkan/wsi/wsi_horizon.c
+++ b/src/vulkan/wsi/wsi_horizon.c
@@ -855,6 +855,8 @@ wsi_horizon_fill_graphic_buffer(struct wsi_horizon_swapchain *chain,
 static void wsi_horizon_release_slots(struct wsi_horizon_swapchain *chain);
 
 /* Closes the copy fallback's framebuffer, if this swapchain has one.
+ * Returns true when it actually closed one — which is to say, when it
+ * has just disconnected the window's producer.
  *
  * IT IS A WINDOW OPERATION, NOT A PRIVATE ONE, and that is the whole
  * reason it has a name. libnx's framebufferClose calls
@@ -864,16 +866,28 @@ static void wsi_horizon_release_slots(struct wsi_horizon_swapchain *chain);
  * registered them. So it may only be called by the swapchain that
  * currently owns the window's registration, and the two callers below
  * are the two moments a swapchain stops owning it: eviction and
- * teardown. Both hold the surface lock.
- */
-static void
+ * release. Both hold the surface lock.
+ *
+ * THE TWO ASSERTIONS ARE THE POINT. That paragraph used to be the whole
+ * specification of a rule whose violation took the console down, and it
+ * was already inaccurate in the commit that introduced it: a third
+ * caller on vkCreateSwapchainKHR's failure path held no lock and tested
+ * nothing. It happened to be unreachable, which is not a property any
+ * later edit is obliged to preserve. Stated in code, the next caller
+ * that gets it wrong stops in a debug build instead of being argued
+ * about in a comment. */
+static bool
 wsi_horizon_close_framebuffer(struct wsi_horizon_swapchain *chain)
 {
+   simple_mtx_assert_locked(&chain->surface->lock);
+   assert(chain->surface->owner == chain);
+
    if (!chain->fb_created)
-      return;
+      return false;
 
    framebufferClose(&chain->fb);
    chain->fb_created = false;
+   return true;
 }
 
 /* Takes the window's registration for `chain`, evicting whoever had it.
@@ -940,22 +954,47 @@ wsi_horizon_claim_window(struct wsi_horizon_swapchain *chain,
        * synchronises only the swapchain it is given, so it may run
        * beside another thread's acquire and present on a different one.
        */
-      wsi_horizon_close_framebuffer(prev);
-
-      Result rc = nwindowReleaseBuffers(prev->window);
-      if (R_FAILED(rc)) {
-         mesa_logw("wsi_horizon: nwindowReleaseBuffers on the previous "
-                   "swapchain failed: 0x%08x", rc);
+      /* ONE DISCONNECT, NOT TWO. framebufferClose already performed the
+       * nwindowReleaseBuffers, so calling it again here is a second
+       * release of a window that has no producer left — and libnx
+       * answering that with a failure made the ordinary recreate path
+       * log a warning about a call that had nothing to do. The
+       * zero-copy path registers through nwindowConfigureBuffer and
+       * closes no framebuffer, so there the release below is the only
+       * one and it must stay. */
+      if (!wsi_horizon_close_framebuffer(prev)) {
+         Result rc = nwindowReleaseBuffers(prev->window);
+         if (R_FAILED(rc)) {
+            mesa_logw("wsi_horizon: nwindowReleaseBuffers on the previous "
+                      "swapchain failed: 0x%08x", rc);
+         }
       }
 
       /* The disconnect took them; this is the bookkeeping catching up,
        * so teardown does not try to cancel a slot the window no longer
-       * has. */
-      for (uint32_t i = 0; i < prev->image_count; i++) {
-         prev->images[i].state = WSI_HORIZON_SLOT_FREE;
-         prev->images[i].have_release_fence = false;
+       * has.
+       *
+       * ZERO-COPY ONLY, because "the disconnect took them" is a
+       * statement about BufferQueue slots and only the zero-copy path
+       * has any. On the copy fallback these entries are our own staging
+       * images: the BufferQueue never held them, nothing external gives
+       * them back, and flipping an ACQUIRED one to FREE would hand an
+       * image the application may still be rendering into to the next
+       * acquire, while Mesa's wsi_image::acquired still says it is
+       * held. wsi_horizon_release_slots already refuses to cancel slots
+       * on this path for the same reason; the two now agree.
+       *
+       * Not a live defect today — prev->presentable was cleared above,
+       * so every acquire on this swapchain returns
+       * VK_ERROR_OUT_OF_DATE_KHR before it can reach the free-slot
+       * search — which is why this is a guard and not a fix. */
+      if (prev->zero_copy) {
+         for (uint32_t i = 0; i < prev->image_count; i++) {
+            prev->images[i].state = WSI_HORIZON_SLOT_FREE;
+            prev->images[i].have_release_fence = false;
+         }
+         prev->slots_requested = 0;
       }
-      prev->slots_requested = 0;
    }
 
    surface->owner = chain;
@@ -979,7 +1018,20 @@ wsi_horizon_presentable(struct wsi_horizon_swapchain *chain)
    return ok;
 }
 
-/* Gives the window back, if this swapchain is still the one holding it. */
+/* Gives the window back, if this swapchain is still the one holding it.
+ *
+ * THIS IS THE ONLY PLACE A SWAPCHAIN RELEASES ITS OWN WINDOW, and the
+ * framebuffer close belongs here for that reason. Both halves of giving
+ * the window back — closing the copy fallback's Framebuffer and
+ * releasing the buffers — are window operations, so both belong under
+ * the one ownership test rather than beside it. Teardown and
+ * vkCreateSwapchainKHR's failure path both come through here, and
+ * neither can now take a lock, forget a test, or close a framebuffer
+ * that is no longer theirs, because there is no longer anywhere else to
+ * do it from. Eviction is the other case and is not this one: there a
+ * *different* swapchain is taking the window, so it closes the loser's
+ * framebuffer itself, under the same lock and while the loser is still
+ * the owner. */
 static void
 wsi_horizon_release_window(struct wsi_horizon_swapchain *chain)
 {
@@ -988,9 +1040,12 @@ wsi_horizon_release_window(struct wsi_horizon_swapchain *chain)
    simple_mtx_lock(&surface->lock);
 
    if (surface->owner == chain) {
-      Result rc = nwindowReleaseBuffers(chain->window);
-      if (R_FAILED(rc)) {
-         mesa_logw("wsi_horizon: nwindowReleaseBuffers failed: 0x%08x", rc);
+      /* One disconnect, not two — see wsi_horizon_claim_window. */
+      if (!wsi_horizon_close_framebuffer(chain)) {
+         Result rc = nwindowReleaseBuffers(chain->window);
+         if (R_FAILED(rc)) {
+            mesa_logw("wsi_horizon: nwindowReleaseBuffers failed: 0x%08x", rc);
+         }
       }
       surface->owner = NULL;
    }
@@ -1779,23 +1834,24 @@ wsi_horizon_swapchain_destroy(struct wsi_swapchain *wsi_chain,
     *
     * bqCancelBuffer is IPC and this holds a mutex across it, which is
     * worth doing here: the lock is per surface and only contended by
-    * swapchain creation and destruction, never per frame. */
-   /* The framebuffer is closed here too, and under the same test, for
-    * the reason wsi_horizon_close_framebuffer gives: closing it is a
-    * disconnect of whatever producer the window currently has. It used
-    * to happen below, outside the lock and with no ownership test at
-    * all, so destroying a superseded copy-fallback swapchain
+    * swapchain creation and destruction, never per frame.
+    *
+    * The framebuffer is closed by wsi_horizon_release_window below,
+    * under that function's own hold of this lock and its own ownership
+    * test, because closing it is a disconnect of whatever producer the
+    * window currently has and is therefore part of giving the window
+    * back rather than a step beside it. It used to happen here — and
+    * before that, outside the lock and with no ownership test at all,
+    * which is how destroying a superseded copy-fallback swapchain
     * disconnected the swapchain that had taken the window from it.
     *
     * A swapchain that is no longer the owner has no framebuffer left to
     * close: wsi_horizon_claim_window closed it at the moment it was
-    * evicted. So this is where every framebuffer is closed, exactly
-    * once, and always by the owner. */
+    * evicted. So every framebuffer is closed exactly once, and always
+    * by the owner. */
    simple_mtx_lock(&chain->surface->lock);
-   if (chain->surface->owner == chain) {
+   if (chain->surface->owner == chain)
       wsi_horizon_release_slots(chain);
-      wsi_horizon_close_framebuffer(chain);
-   }
    simple_mtx_unlock(&chain->surface->lock);
 
    wsi_horizon_release_window(chain);
@@ -1912,13 +1968,26 @@ wsi_horizon_init_fallback(struct wsi_horizon_swapchain *chain,
       return false;
    }
 
+   /* SET HERE, NOT AT THE END, so the flag means "a Framebuffer exists
+    * and somebody must close it" from the instant one does. It used to
+    * be set on the last line of this function, which left the two
+    * failures below to close it themselves — raw, unlocked, and testing
+    * no ownership, in the very function whose header says that closing
+    * a framebuffer is a window operation. Worse, they then returned
+    * false into a teardown that called nwindowReleaseBuffers on the
+    * window framebufferClose had just disconnected, so a legitimate
+    * failure path logged a spurious warning about the second release.
+    * With the flag set now, both simply return and the one release path
+    * closes it under the surface lock, exactly as every other exit
+    * does. */
+   chain->fb_created = true;
+
    /* A linear shadow buffer, so the copy above is a row memcpy and the
     * block-linear swizzle is libnx's problem rather than a second
     * implementation of it here. */
    rc = framebufferMakeLinear(&chain->fb);
    if (R_FAILED(rc)) {
       mesa_loge("wsi_horizon: framebufferMakeLinear failed: 0x%08x", rc);
-      framebufferClose(&chain->fb);
       *why = "the copy fallback could not make its framebuffer linear";
       return false;
    }
@@ -1935,12 +2004,10 @@ wsi_horizon_init_fallback(struct wsi_horizon_swapchain *chain,
    if (R_FAILED(rc)) {
       mesa_loge("wsi_horizon: nwindowSetSwapInterval(%u) failed: 0x%08x",
                 chain->swap_interval, rc);
-      framebufferClose(&chain->fb);
       *why = "the copy fallback could not set the window's swap interval";
       return false;
    }
 
-   chain->fb_created = true;
    return true;
 }
 
@@ -2248,10 +2315,17 @@ fail_images:
       result = VK_ERROR_INITIALIZATION_FAILED;
 
 fail_no_chain:
-   /* Still the owner on every path that reaches here: the window was
-    * claimed above and this swapchain has not been handed out, so
-    * nothing can have named it as an oldSwapchain and evicted it. */
-   wsi_horizon_close_framebuffer(chain);
+   /* Gives back whatever was taken, including the copy fallback's
+    * framebuffer if init_fallback got as far as creating one.
+    *
+    * This used to close the framebuffer itself, on the line above,
+    * holding no lock and testing no ownership — the third caller of a
+    * function documented as having exactly two, both locked. It was
+    * unreachable at the time, because fb_created was set on
+    * init_fallback's last line and so was never true here; that made it
+    * a trap rather than a defect, waiting for the next goto added above
+    * the claim. Ownership is now release_window's business and only
+    * release_window's, so there is nothing left here to get wrong. */
    wsi_horizon_release_window(chain);
    if (chain->holds_nv_fence)
       nvFenceExit();
