From a16200b5425134bfbb606447659e2c4891c572b4 Mon Sep 17 00:00:00 2001
From: mesa-nvk-horizon <mesa-nvk-horizon@localhost>
Date: Tue, 28 Jul 2026 14:53:31 +0000
Subject: [PATCH 28/59] nouveau/vk: nvkmd_horizon, name the number that decides
 a failed bind
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

horizon_gpu_vm_map requires both offsets to be aligned to the
*reservation's* page size (vm.h:59-63), and this backend reserves in
the big-page half for a block-linear kind and the small-page half
otherwise. So when a bind fails, the page size is the number that says
whether the offsets were legal — and it was the one thing the message
did not print. It now names the VA offset, the memory offset, the
range, the PTE kind and the page size.

mesa-nvk-horizon: Phase 4 — the mandatory Vulkan sequence
Why: the third hardware run failed at vkCreateDevice with
  VK_ERROR_UNKNOWN, which this backend returns for a horizon_gpu status
  with no Vulkan equivalent. Three sites can produce it and a failed
  bind is the likeliest; the message has to distinguish them without
  another console run.
Evidence: horizon/include/horizon_gpu/vm.h:59-63 for the alignment
  contract; nvkmd_horizon_pdev.c:270 sets bind_align_B to the big-page
  size.
Upstream: no — this is the Horizon backend's own VA path.
---
 .../vulkan/nvkmd/horizon/nvkmd_horizon_va.c    | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_va.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_va.c
index a163256..9376eb9 100644
--- a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_va.c
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_va.c
@@ -90,10 +90,22 @@ nvkmd_horizon_va_bind_mem(struct nvkmd_va *_va,
                          true /* gpu_cacheable */, &b->mapping);
    if (res.status != HORIZON_GPU_OK) {
       FREE(b);
+      /* The page size is in the message because it is the number that
+       * decides: horizon_gpu_vm_map requires both offsets to be
+       * aligned to the *reservation's* page size (vm.h:59-63), and a
+       * VA reserved in the big-page half rejects an offset that is
+       * only small-page aligned. Without it the reader has the two
+       * offsets and no way to tell whether they were legal.
+       */
       return vk_errorf(log_obj, nvkmd_horizon_result(res),
-                       "horizon_gpu_vm_map(+0x%" PRIx64 ", 0x%" PRIx64 ") "
-                       "failed: status %d, nv 0x%08" PRIx32,
-                       va_offset_B, range_B, (int)res.status, res.nv);
+                       "horizon_gpu_vm_map(va +0x%" PRIx64 ", mem +0x%"
+                       PRIx64 ", 0x%" PRIx64 " bytes, kind 0x%02x, page "
+                       "size 0x%" PRIx32 ") failed: status %d, "
+                       "nv 0x%08" PRIx32,
+                       va_offset_B, mem_offset_B, range_B,
+                       _va->pte_kind,
+                       horizon_gpu_va_range_page_size(va->range),
+                       (int)res.status, res.nv);
    }
 
    b->va_offset_B = va_offset_B;
-- 
