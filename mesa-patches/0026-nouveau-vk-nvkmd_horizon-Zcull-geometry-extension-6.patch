From fc203d8fa4692f2b294cf7bb046446023ab2ba47 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 28 Jul 2026 19:50:28 +0000
Subject: [PATCH 26/54] nouveau/vk: nvkmd_horizon, Zcull geometry (extension 6)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

has_zcull_info was hardcoded false, on the grounds that Zcull "belongs
to the channel and nothing in Phase 4 uses it". The query is a device
property, libnx caches it at nvGpuInit, and horizon_gpu already binds
Zcull context buffers -- so the only thing missing was the wrapper.
That is now three of the six extensions Phase 4 step 1 enumerated whose
absence turned out to be a missing wrapper rather than a missing
capability.

Mapped field by field on purpose. The Horizon struct and
drm_nouveau_get_zcull_info carry the same ten numbers in different
orders -- subregion_count is last in one and third from last in the
other -- so a struct copy would put a count where an alignment belongs
and nothing would complain.

ctxsw_size comes from nvGpuGetZcullCtxSize rather than the geometry
query, and ctxsw_align is the alignment horizon_gpu already binds Zcull
context buffers at. A failure leaves has_zcull_info false, which is what
NVK checks before touching the struct; nouveau lets this query fail too.

mesa-nvk-horizon: Phase 4 — extension 6 (Zcull geometry)
Why: has_zcull_info was hardcoded false while the query is a cached
  device property libnx exposes; the absence was a missing wrapper,
  not a missing capability.
Evidence: libnx caches the geometry at nvGpuInit; horizon_gpu already
  binds Zcull context buffers at the alignment reported here.
Upstream: no — this is the Horizon backend's own pdev info.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 .../vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c | 44 ++++++++++++++++---
 1 file changed, 38 insertions(+), 6 deletions(-)

diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c
index 199fa22db44..551144e0f3a 100644
--- a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c
@@ -119,7 +119,8 @@ const struct nvkmd_pdev_ops nvkmd_horizon_pdev_ops = {
 
 static void
 fill_dev_info(struct nv_device_info *info,
-              const horizon_gpu_device_info *gpu)
+              const horizon_gpu_device_info *gpu,
+              horizon_gpu_device *dev)
 {
    memset(info, 0, sizeof(*info));
 
@@ -197,11 +198,42 @@ fill_dev_info(struct nv_device_info *info,
     */
    info->has_transfer_queue = false;
 
-   /* Zcull is queryable on Horizon but is not read here: it belongs to
-    * the channel, and nothing in Phase 4 uses it. has_zcull_info stays
-    * false, which is what nvk checks before touching zcull_info.
+   /* Zcull geometry — extension 6 of the six Phase 4 step 1 enumerated.
+    *
+    * Mapped field by field on purpose. The ioctl and
+    * drm_nouveau_get_zcull_info carry the same ten numbers in different
+    * orders: subregion_count is last in the Horizon struct and third
+    * from last in nouveau's, so a struct copy would put a count where an
+    * alignment belongs and nothing would complain.
+    *
+    * ctxsw_size comes from nvGpuGetZcullCtxSize rather than the geometry
+    * query, and ctxsw_align is the alignment horizon_gpu already binds
+    * Zcull context buffers at (channel.c, CHANNEL_ZCULL_ALIGN).
+    *
+    * A failure leaves has_zcull_info false, which is what NVK checks
+    * before touching the struct; nouveau lets this query fail too.
     */
-   info->has_zcull_info = false;
+   horizon_gpu_zcull_info zc;
+   horizon_gpu_result zres = horizon_gpu_device_get_zcull_info(dev, &zc);
+   if (zres.status == HORIZON_GPU_OK) {
+      info->zcull_info = (struct nv_zcull_device_info) {
+         .width_align_pixels = zc.width_align_pixels,
+         .height_align_pixels = zc.height_align_pixels,
+         .pixel_squares_by_aliquots = zc.pixel_squares_by_aliquots,
+         .aliquot_total = zc.aliquot_total,
+         .zcull_region_byte_multiplier = zc.region_byte_multiplier,
+         .zcull_region_header_size = zc.region_header_size,
+         .zcull_subregion_header_size = zc.subregion_header_size,
+         .subregion_count = zc.subregion_count,
+         .subregion_width_align_pixels = zc.subregion_width_align_pixels,
+         .subregion_height_align_pixels = zc.subregion_height_align_pixels,
+         .ctxsw_size = zc.ctx_size,
+         .ctxsw_align = 0x20000,
+      };
+      info->has_zcull_info = true;
+   } else {
+      info->has_zcull_info = false;
+   }
 }
 
 VkResult
@@ -248,7 +280,7 @@ nvkmd_horizon_create_pdev(struct vk_object_base *log_obj,
                        "nv 0x%08" PRIx32, (int)res.status, res.nv);
    }
 
-   fill_dev_info(&pdev->base.dev_info, &pdev->gpu_info);
+   fill_dev_info(&pdev->base.dev_info, &pdev->gpu_info, pdev->gpu);
 
    /* What this backend can and cannot do. Each false is a statement
     * about Horizon, not a gap left for later:
-- 
