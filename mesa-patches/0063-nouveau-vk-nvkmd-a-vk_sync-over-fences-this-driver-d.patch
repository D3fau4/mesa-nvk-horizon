+ */
+uint32_t nvk_horizon_sync_get_foreign_fences(struct vk_sync *sync,
+                                             horizon_gpu_channel *chan,
+                                             horizon_gpu_fence *fences_out,
+                                             uint32_t max_fences);
+
+/* Gives `sync` an imported payload: `fence_count` syncpoint fences that
+ * something outside this driver will increment, and the device a CPU
+ * wait on them goes through.
+ *
+ * The sync must be freshly created (RESET) and of this type; the fences
