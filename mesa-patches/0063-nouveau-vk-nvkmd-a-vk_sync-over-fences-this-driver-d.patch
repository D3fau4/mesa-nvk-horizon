diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_sync.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_sync.c
index 0a9183d..899b4ae 100644
--- a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_sync.c
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_sync.c
@@ -216,6 +216,8 @@ nvk_horizon_sync_reset(struct vk_device *device, struct vk_sync *_sync)
    sync->chan = NULL;
    sync->meter = NULL;
    sync->fence_set_ns = 0;
+   sync->ext_dev = NULL;
+   sync->ext_fence_count = 0;
    /* Reset is a binary operation — the runtime never resets a timeline —
     * so the counter goes back to where init leaves it. */
    sync->signalled_value = 0;
@@ -265,6 +267,11 @@ nvk_horizon_sync_move(struct vk_device *device,
    src->chan = NULL;
    src->meter = NULL;
    src->fence_set_ns = 0;
+   /* The struct copy above already carried the imported payload to dst,
+    * exactly as it carried `fence` and `chan`. Only the emptying of the
+    * source is written out. */
+   src->ext_dev = NULL;
+   src->ext_fence_count = 0;
    src->signalled_value = 0;
    src->passed_value = 0;
 
@@ -278,6 +285,68 @@ nvk_horizon_sync_move(struct vk_device *device,
    return VK_SUCCESS;
 }
 
+/* Waits out an IMPORTED payload on the CPU: every fence in it, one
+ * after another, sharing the caller's one deadline.
+ *
+ * Sequential and not "wait on the set", because a set wait is not what
+ * is being asked: the sync is reached when the LAST of them is, so the
+ * total is the maximum, and waiting for them in turn costs the maximum
+ * plus the loop. horizon_gpu has no wait-for-all and inventing one for
+ * a list that is at most four long would be machinery for nothing.
+ *
+ * horizon_gpu_fence_wait rather than horizon_gpu_channel_wait_fence,
+ * because there is no channel: these counters belong to whatever
+ * produced them, and channel_wait_fence refuses a fence whose syncpoint
+ * is not its channel's own. What is lost with the channel is the
+ * error-notifier re-check, and it was never applicable — a channel of
+ * ours faulting says nothing about a counter somebody else increments.
+ *
+ * The remaining budget is recomputed from the clock between fences.
+ * That is the same relative-duration discipline decision D8 asks for
+ * (never an absolute deadline held across a wait) and it has the same
+ * residual: os_time_get_nano is this platform's real-time clock, so a
+ * date change during the wait can perturb one step's share. Guarded
+ * against going backwards, which is the part that would turn a
+ * perturbation into an enormous timeout.
+ *
+ * `failed_out` names the fence that ended the wait, so the caller's
+ * error message says which of the four it was.
+ */
+static horizon_gpu_result
+nvk_horizon_sync_wait_imported(horizon_gpu_device *dev,
+                               const horizon_gpu_fence *fences,
+                               uint32_t fence_count,
+                               uint64_t timeout_ns,
+                               horizon_gpu_fence *failed_out)
+{
+   const uint64_t start_ns = os_time_get_nano();
+
+   for (uint32_t i = 0; i < fence_count; i++) {
+      uint64_t budget_ns = HORIZON_GPU_NO_TIMEOUT;
+
+      if (timeout_ns != HORIZON_GPU_NO_TIMEOUT) {
+         const uint64_t now_ns = os_time_get_nano();
+         const uint64_t spent_ns = now_ns > start_ns ? now_ns - start_ns : 0;
+         /* An exhausted budget becomes a ZERO one and still goes through
+          * the call below, which is a poll rather than a wait. Returning
+          * TIMEOUT here instead would answer "not reached" about a fence
+          * nothing had looked at — and it would make the whole function
+          * useless as the poll get_value() needs, where the caller's
+          * budget is zero by construction. */
+         budget_ns = timeout_ns > spent_ns ? timeout_ns - spent_ns : 0;
+      }
+
+      horizon_gpu_result res =
+         horizon_gpu_fence_wait(dev, fences[i], budget_ns);
+      if (horizon_gpu_failed(res)) {
+         *failed_out = fences[i];
+         return res;
+      }
+   }
+
+   return horizon_gpu_ok();
+}
+
 static VkResult
 nvk_horizon_sync_wait(struct vk_device *device,
                       struct vk_sync *_sync,
@@ -381,6 +450,15 @@ nvk_horizon_sync_wait(struct vk_device *device,
     */
    chan = sync->chan;
    fence = sync->fence;
+   /* The imported payload travels with the other two and under the same
+    * rule: immutable while PENDING, so one copy taken here is what the
+    * wait below runs on. `ext_count` is the discriminator — above zero
+    * `chan` is NULL and `fence` is unused. */
+   horizon_gpu_device *const ext_dev = sync->ext_dev;
+   const uint32_t ext_count = sync->ext_fence_count;
+   horizon_gpu_fence ext_fences[NVKMD_MAX_SYNCPT_FENCES];
+   for (uint32_t i = 0; i < ext_count; i++)
