                                     horizon_gpu_channel *chan);
 
-/* The fence of a sync that is PENDING on a channel OTHER than `chan`,
- * which is exactly the set of waits a GPU-side syncpoint wait can carry.
+/* The fences of a sync that is PENDING on something other than `chan` —
+ * another channel of ours, or an imported dependency with no channel at
