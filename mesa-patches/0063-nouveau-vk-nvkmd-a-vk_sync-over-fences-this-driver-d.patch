  */
-bool nvk_horizon_sync_get_foreign_fence(struct vk_sync *sync,
-                                        horizon_gpu_channel *chan,
-                                        horizon_gpu_fence *fence_out);
+VkResult nvk_horizon_sync_import_fences(struct vk_sync *sync,
+                                        horizon_gpu_device *dev,
+                                        const horizon_gpu_fence *fences,
