diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c
index 13dcd92..6ac248e 100644
--- a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c
@@ -152,12 +152,70 @@ nvkmd_horizon_pdev_get_syncpt_fence(struct nvkmd_pdev *pdev,
    return VK_SUCCESS;
 }
 
+/* The reverse of get_syncpt_fence: somebody else's counters, wrapped in
+ * a vk_sync so a submit can be ordered behind them by the host engine
+ * rather than by this thread.
+ *
+ * `pdev->gpu` and not a device's, for the reason the header comment
+ * gives: there is one horizon_gpu_device per process (decision D9), the
+ * pdev owns it, and it outlives every sync created from it. The sync
+ * needs it because a CPU wait on a counter with no channel behind it
+ * has nowhere else to go.
+ */
+static VkResult
+nvkmd_horizon_pdev_import_syncpt_fence(struct nvkmd_pdev *_pdev,
+                                       struct vk_device *vk_dev,
+                                       const struct nvkmd_syncpt_fence *fences,
+                                       uint32_t fence_count,
+                                       struct vk_sync **sync_out)
+{
+   struct nvkmd_horizon_pdev *pdev = nvkmd_horizon_pdev(_pdev);
+
+   /* Refused rather than truncated: a dropped fence is a dependency
+    * that is never waited for, and it reports itself as nothing. The
+    * caller falls back to whatever it did before imports existed. */
+   if (vk_dev == NULL || fences == NULL || fence_count == 0 ||
+       fence_count > NVKMD_MAX_SYNCPT_FENCES)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   /* Two numbers across a layer boundary, copied field by field for the
+    * reason nvkmd_horizon_pdev_get_syncpt_fence gives going the other
+    * way: a struct assignment between them would make the boundary
+    * invisible. */
+   horizon_gpu_fence gpu_fences[NVKMD_MAX_SYNCPT_FENCES];
+   for (uint32_t i = 0; i < fence_count; i++) {
+      gpu_fences[i].syncpt_id = fences[i].id;
+      gpu_fences[i].threshold = fences[i].value;
+   }
+
+   struct vk_sync *sync = NULL;
+   VkResult result = vk_sync_create(vk_dev, &nvk_horizon_sync_type,
+                                    0 /* flags */, 0 /* initial_value */,
+                                    &sync);
+   if (result != VK_SUCCESS)
+      return result;
+
+   result = nvk_horizon_sync_import_fences(sync, pdev->gpu, gpu_fences,
+                                           fence_count);
+   if (result != VK_SUCCESS) {
+      /* Torn down in the reverse of the order it was built, with
+       * nothing handed back: a sync with no payload would be an
+       * already-unsignalled object the caller would wait on forever. */
+      vk_sync_destroy(vk_dev, sync);
+      return result;
+   }
+
+   *sync_out = sync;
+   return VK_SUCCESS;
+}
+
 const struct nvkmd_pdev_ops nvkmd_horizon_pdev_ops = {
    .destroy = nvkmd_horizon_pdev_destroy,
    .get_vram_used = nvkmd_horizon_pdev_get_vram_used,
    .get_drm_primary_fd = nvkmd_horizon_pdev_get_drm_primary_fd,
    .create_dev = nvkmd_horizon_create_dev,
    .get_syncpt_fence = nvkmd_horizon_pdev_get_syncpt_fence,
+   .import_syncpt_fence = nvkmd_horizon_pdev_import_syncpt_fence,
 };
 
