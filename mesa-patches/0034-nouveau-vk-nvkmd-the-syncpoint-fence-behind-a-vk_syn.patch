From 6be12965d037497eb2a67ae65463f2efc1309812 Mon Sep 17 00:00:00 2001
From: mesa-nvk-horizon <mesa-nvk-horizon@localhost>
Date: Wed, 5 Aug 2026 10:09:47 +0000
Subject: [PATCH 34/49] nouveau/vk: nvkmd, the syncpoint fence behind a vk_sync
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

mesa-nvk-horizon: Phase 6 item 8 (Correct fence-based synchronisation at
 acquire and present)
Why: Horizon's compositor takes an NvMultiFence with a queued buffer and
 waits on it itself, so a present can be handed over while its rendering
 is still running. Without a way to obtain that fence, a WSI backend has
 only one option left — wait on the CPU for the render to finish and
 then queue with no fence — which is precisely the defect
 is precisely the defect both reference ports share
 (wsi_common_switch.c:374 and nxvk's wsi_switch.c:446-458), and which
 CLAUDE.md's rule 6 forbids: a CPU stall is allowed only where Vulkan's
 own semantics put one.
 The fence a present must wait on is the one the WSI's own
 vkQueueSubmit2 signals — a VkFence, hence a vk_sync, hence
 nvk_horizon_sync. Reading it out of the sync object needs the backend's
 internals, which the WSI layer may not have, so it becomes an nvkmd
 operation instead. Every other backend leaves it NULL and the wrapper
 answers VK_ERROR_FEATURE_NOT_PRESENT.
 abs_timeout_ns bounds a wait for the sync to become PENDING, never for
 the work to complete — VK_SYNC_WAIT_PENDING is exactly that
 distinction. A wait is needed at all because NVK's timeline semaphores
 are the runtime's emulation, which selects
 VK_QUEUE_SUBMIT_MODE_DEFERRED (vk_device.c:208-209); in the ordinary
 case vk_queue_submit flushes on the spot and the wait returns without
 blocking.
Evidence: cross build of build/mesa-nvk (aarch64-none-elf-gcc 15.2.0,
 meson 1.9.1). The pair returned is nvk_horizon_sync::fence, the same
 {syncpt_id, threshold} horizon_gpu_channel_wait_fence already waits on
 in nvk_horizon_sync_wait, so nothing new computes it — it is read out
 under the same mutex that guards every other access to it. Not run on a
 console yet.
Upstream: no — a syncpoint fence has no meaning on a DRM kernel driver,
 where the same job belongs to a sync file.
---
 .../vulkan/nvkmd/horizon/nvkmd_horizon.h      | 14 +++++
 .../vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c | 30 ++++++++++
 .../vulkan/nvkmd/horizon/nvkmd_horizon_sync.c | 43 ++++++++++++++
 src/nouveau/vulkan/nvkmd/nvkmd.h              | 59 +++++++++++++++++++
 4 files changed, 146 insertions(+)

diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon.h b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon.h
index d2aa0b6..797e267 100644
--- a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon.h
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon.h
@@ -244,6 +244,20 @@ void nvk_horizon_sync_set_fence(struct vk_sync *sync,
                                 horizon_gpu_fence fence,
                                 uint64_t signal_value);
 
+/* The channel fence this sync will be signalled by, for a consumer
+ * outside the GPU — the display block, which can wait on a syncpoint
+ * itself. `abs_timeout_ns` bounds a wait for the sync to become
+ * *pending*, never for the work to complete. See the definition.
+ *
+ * VK_ERROR_FEATURE_NOT_PRESENT for a sync of any other type.
+ * `*has_fence_out` is false for a sync that was signalled on the CPU and
+ * never submitted: there is nothing to wait for.
+ */
+VkResult nvk_horizon_sync_get_fence(struct vk_sync *sync,
+                                    uint64_t abs_timeout_ns,
+                                    horizon_gpu_fence *fence_out,
+                                    bool *has_fence_out);
+
 VkResult nvkmd_horizon_create_ctx(struct nvkmd_dev *dev,
                                   struct vk_object_base *log_obj,
                                   enum nvkmd_engines engines,
diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c
index 3e8131c..b91a3a6 100644
--- a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c
@@ -122,11 +122,41 @@ nvkmd_horizon_pdev_get_drm_primary_fd(struct nvkmd_pdev *_pdev)
    return -1;
 }
 
+static VkResult
+nvkmd_horizon_pdev_get_syncpt_fence(struct nvkmd_pdev *pdev,
+                                    struct vk_sync *sync,
+                                    uint64_t abs_timeout_ns,
+                                    struct nvkmd_syncpt_fence *fence_out,
+                                    bool *has_fence_out)
+{
+   horizon_gpu_fence fence = { 0, 0 };
+   bool has_fence = false;
+
+   VkResult result = nvk_horizon_sync_get_fence(sync, abs_timeout_ns,
+                                                &fence, &has_fence);
+   if (result != VK_SUCCESS)
+      return result;
+
+   /* horizon_gpu_fence and nvkmd_syncpt_fence hold the same two
+    * numbers and are deliberately different types: one belongs to the
+    * GPU layer and one to nvkmd's interface, and a struct assignment
+    * between them would make a layer boundary invisible. */
+   if (has_fence) {
+      fence_out->id = fence.syncpt_id;
+      fence_out->value = fence.threshold;
+   }
+   *has_fence_out = has_fence;
+
+   (void)pdev;
+   return VK_SUCCESS;
+}
+
 const struct nvkmd_pdev_ops nvkmd_horizon_pdev_ops = {
    .destroy = nvkmd_horizon_pdev_destroy,
    .get_vram_used = nvkmd_horizon_pdev_get_vram_used,
    .get_drm_primary_fd = nvkmd_horizon_pdev_get_drm_primary_fd,
    .create_dev = nvkmd_horizon_create_dev,
+   .get_syncpt_fence = nvkmd_horizon_pdev_get_syncpt_fence,
 };
 
 static void
diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_sync.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_sync.c
index d85c49b..fe956d7 100644
--- a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_sync.c
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_sync.c
@@ -513,3 +513,46 @@ nvk_horizon_sync_set_fence(struct vk_sync *_sync,
    cnd_broadcast(&sync->cond);
    mtx_unlock(&sync->mutex);
 }
+
+VkResult
+nvk_horizon_sync_get_fence(struct vk_sync *_sync, uint64_t abs_timeout_ns,
+                           horizon_gpu_fence *fence_out, bool *has_fence_out)
+{
+   if (_sync->type != &nvk_horizon_sync_type)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   struct nvk_horizon_sync *sync = to_horizon_sync(_sync);
+
+   /* VK_SYNC_WAIT_PENDING returns as soon as the object has a payload —
+    * as soon as a submit has attached a fence to it — WITHOUT waiting
+    * for that work to finish. That distinction is the whole point of
+    * this function: a caller that waited for completion would be doing
+    * on the CPU exactly the wait it is asking the display block to do.
+    *
+    * A wait is needed at all because a submit may be deferred: NVK's
+    * timeline semaphores are the runtime's emulation, which puts the
+    * device in VK_QUEUE_SUBMIT_MODE_DEFERRED (vk_device.c:208-209), and
+    * a deferred submit whose waits are not yet satisfied has not
+    * reached a channel and has no fence. In the ordinary case
+    * vk_queue_submit flushes immediately and this returns without
+    * blocking at all.
+    */
+   VkResult result = vk_sync_wait(NULL, _sync, 0, VK_SYNC_WAIT_PENDING,
+                                  abs_timeout_ns);
+   if (result != VK_SUCCESS)
+      return result;
+
+   mtx_lock(&sync->mutex);
+   /* RESET cannot be reached here: WAIT_PENDING only returns success
+    * for PENDING or SIGNALLED. SIGNALLED with no fence is the sync that
+    * was signalled on the CPU and never submitted — there is nothing to
+    * wait for, which is an answer and not a failure.
+    */
+   const bool has_fence = sync->state == NVK_HORIZON_SYNC_PENDING;
+   if (has_fence)
+      *fence_out = sync->fence;
+   mtx_unlock(&sync->mutex);
+
+   *has_fence_out = has_fence;
+   return VK_SUCCESS;
+}
diff --git a/src/nouveau/vulkan/nvkmd/nvkmd.h b/src/nouveau/vulkan/nvkmd/nvkmd.h
index bd82905..ee537cd 100644
--- a/src/nouveau/vulkan/nvkmd/nvkmd.h
+++ b/src/nouveau/vulkan/nvkmd/nvkmd.h
@@ -26,6 +26,7 @@ struct nvkmd_va;
 
 struct _drmDevice;
 struct vk_object_base;
+struct vk_sync;
 struct vk_sync_wait;
 struct vk_sync_signal;
 
@@ -139,6 +140,20 @@ struct nvkmd_info {
    bool has_compression;
 };
 
+/** A host1x syncpoint fence: a counter and the value that means
+ * "reached".
+ *
+ * Platforms whose display block waits on syncpoints — Horizon — need
+ * this pair in order to hand a frame to the compositor while its
+ * rendering is still running, instead of stalling the CPU until it
+ * finishes. It has no counterpart under DRM, where a sync file does the
+ * same job through a file descriptor.
+ */
+struct nvkmd_syncpt_fence {
+   uint32_t id;
+   uint32_t value;
+};
+
 struct nvkmd_pdev_ops {
    void (*destroy)(struct nvkmd_pdev *pdev);
 
@@ -149,6 +164,30 @@ struct nvkmd_pdev_ops {
    VkResult (*create_dev)(struct nvkmd_pdev *pdev,
                           struct vk_object_base *log_obj,
                           struct nvkmd_dev **dev_out);
+
+   /** The syncpoint fence `sync` will be signalled by, for a display
+    * block that can wait on one.
+    *
+    * `abs_timeout_ns` bounds a wait for the sync to become *pending* —
+    * for a submit to have attached a fence to it — and NOT for that
+    * work to complete. The two are different by exactly the amount this
+    * operation exists to save: a caller that waited for completion
+    * would be doing on the CPU the wait it is trying to hand to the
+    * display.
+    *
+    * On VK_SUCCESS, `*has_fence_out` says whether there is anything to
+    * wait for at all: a sync signalled on the CPU, with no submit ever
+    * attached to it, has no fence and needs none. Only when it is true
+    * is `*fence_out` written.
+    *
+    * Optional; a NULL op means the platform's display does not consume
+    * syncpoints and the caller must synchronise some other way.
+    */
+   VkResult (*get_syncpt_fence)(struct nvkmd_pdev *pdev,
+                                struct vk_sync *sync,
+                                uint64_t abs_timeout_ns,
+                                struct nvkmd_syncpt_fence *fence_out,
+                                bool *has_fence_out);
 };
 
 struct nvkmd_pdev {
@@ -439,6 +478,26 @@ nvkmd_pdev_get_drm_primary_fd(struct nvkmd_pdev *pdev)
    return pdev->ops->get_drm_primary_fd(pdev);
 }
 
+/** The syncpoint fence behind a vk_sync, or FEATURE_NOT_PRESENT.
+ *
+ * FEATURE_NOT_PRESENT means "ask something else", not "this failed":
+ * every backend but Horizon leaves the op NULL, and a caller turns the
+ * answer into whatever synchronisation that platform does use.
+ */
+static inline VkResult MUST_CHECK
+nvkmd_pdev_get_syncpt_fence(struct nvkmd_pdev *pdev,
+                            struct vk_sync *sync,
+                            uint64_t abs_timeout_ns,
+                            struct nvkmd_syncpt_fence *fence_out,
+                            bool *has_fence_out)
+{
+   if (pdev->ops->get_syncpt_fence == NULL)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   return pdev->ops->get_syncpt_fence(pdev, sync, abs_timeout_ns,
+                                      fence_out, has_fence_out);
+}
+
 static inline VkResult MUST_CHECK
 nvkmd_pdev_create_dev(struct nvkmd_pdev *pdev,
                       struct vk_object_base *log_obj,
-- 
2.43.0

