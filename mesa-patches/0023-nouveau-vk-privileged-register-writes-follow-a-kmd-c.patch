From f192dc6b01574eb02827b2835b6395e0a7e586ad Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 28 Jul 2026 19:10:23 +0000
Subject: [PATCH 23/54] nouveau/vk: privileged register writes follow a kmd
 capability (R18)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

nvk_push_draw_state_init issues two SET_PRIV_REG writes whenever the 3D
class is MAXWELL_B or later -- gr_gpcs_tpcs_sm_disp_ctrl (0x419f78) and
sms_hww_warp_esp_report_mask (0x419e44). The class check says the chip
supports the method. Whether the driver underneath lets an unprivileged
channel use it is a different question, and on Horizon the answer is no:
the write is rejected and the channel is reset, after which every submit
on it times out.

That is known-risks R18, recorded in Phase 0 from the reference ports'
hardware experience and expected in Phase 5. It arrives in Phase 4
because these writes happen while the queue's context is initialised,
long before any draw -- which matches the third hardware run exactly:
vkCreateDevice returns 0 because submission is asynchronous, and the
next kickoff on that channel fails with LibnxNvidiaError_Timeout and an
error notifier set.

Add nvkmd_info::has_priv_reg_writes, true for nouveau where NVK's
behaviour is unchanged, false for horizon.

R18's instruction was to determine what NVK loses rather than inherit a
silent no-op, so it is written down at the declaration: bit 3 of
sm_disp_ctrl enables FP helper invocation memory loads, without which
one dEQP subgroups test fails occasionally; sms_hww_warp_esp_report_mask
disables Out Of Range Address exceptions for a case involving an empty
fragment shader. Neither is reachable by anything this port runs today.

mesa-nvk-horizon: Phase 4 — known-risks R18, expected in Phase 5
Why: the MAXWELL_B class check says the chip supports SET_PRIV_REG;
  whether the kernel driver lets an unprivileged channel use it is a
  different question, and on Horizon the write resets the channel.
Evidence: third hardware run — vkCreateDevice returns 0, the next
  kickoff on that channel fails with LibnxNvidiaError_Timeout and the
  error notifier set; the reference ports recorded the same rejection
  (R18, Phase 0).
Upstream: yes — same shape as has_sparse: it moves a driver-dependent
  answer from the chip check to the kmd, and nouveau's answer keeps
  NVK's behaviour identical.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/nouveau/vulkan/nvk_cmd_draw.c              |  6 ++++--
 .../vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c  | 18 ++++++++++++++++++
 .../vulkan/nvkmd/nouveau/nvkmd_nouveau_pdev.c  |  3 +++
 src/nouveau/vulkan/nvkmd/nvkmd.h               |  9 +++++++++
 4 files changed, 34 insertions(+), 2 deletions(-)

diff --git a/src/nouveau/vulkan/nvk_cmd_draw.c b/src/nouveau/vulkan/nvk_cmd_draw.c
index 3a7c3f2211e..d8afc1cd771 100644
--- a/src/nouveau/vulkan/nvk_cmd_draw.c
+++ b/src/nouveau/vulkan/nvk_cmd_draw.c
@@ -190,7 +190,8 @@ nvk_push_draw_state_init(struct nvk_queue *queue, struct nv_push *p)
     * dEQP-VK.subgroups.vote.frag_helper.subgroupallequal_bvec2_fragment will
     * occasionally fail.
     */
-   if (pdev->info.cls_eng3d >= MAXWELL_B) {
+   if (pdev->info.cls_eng3d >= MAXWELL_B &&
+       pdev->nvkmd->kmd_info.has_priv_reg_writes) {
       unsigned reg = get_sm_disp_ctrl_reg(&pdev->info);
       P_1INC(p, NV9097, CALL_MME_MACRO(NVK_MME_SET_PRIV_REG));
       P_INLINE_DATA(p, 0);
@@ -244,7 +245,8 @@ nvk_push_draw_state_init(struct nvk_queue *queue, struct nv_push *p)
     *
     * This clears bit 14 of gr_gpcs_tpcs_sms_hww_warp_esr_report_mask
     */
-   if (pdev->info.cls_eng3d >= MAXWELL_B) {
+   if (pdev->info.cls_eng3d >= MAXWELL_B &&
+       pdev->nvkmd->kmd_info.has_priv_reg_writes) {
       unsigned reg = get_sms_hww_warp_esp_report_mask_reg(&pdev->info);
       P_1INC(p, NV9097, CALL_MME_MACRO(NVK_MME_SET_PRIV_REG));
       P_INLINE_DATA(p, 0);
diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c
index 93a888cb39b..199fa22db44 100644
--- a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_pdev.c
@@ -295,6 +295,24 @@ nvkmd_horizon_create_pdev(struct vk_object_base *log_obj,
        * the work is known and bounded, and nothing in Phase 4 needs it.
        */
       .has_sparse = false,
+      /* Horizon rejects privileged graphics-register writes from an
+       * unprivileged channel and resets the channel, after which every
+       * submit on it times out. Recorded in Phase 0 as known-risks R18,
+       * from the reference ports' hardware experience, and expected
+       * there in Phase 5; it arrives in Phase 4 because
+       * nvk_push_draw_state_init issues two of them while the queue's
+       * context is being initialised, long before any draw.
+       *
+       * What NVK loses by not making them, from its own comments:
+       * gr_gpcs_tpcs_sm_disp_ctrl bit 3 enables FP helper invocation
+       * memory loads, without which one dEQP subgroups test fails
+       * occasionally; and sms_hww_warp_esp_report_mask disables Out Of
+       * Range Address exceptions for a case involving an empty fragment
+       * shader. Neither is reachable by anything this port runs today,
+       * and R18's instruction was to determine the cost rather than
+       * inherit a silent no-op — so it is written down here.
+       */
+      .has_priv_reg_writes = false,
       .has_dma_buf = false,
       .has_get_vram_used = false,
       .has_alloc_tiled = false,
diff --git a/src/nouveau/vulkan/nvkmd/nouveau/nvkmd_nouveau_pdev.c b/src/nouveau/vulkan/nvkmd/nouveau/nvkmd_nouveau_pdev.c
index 9d7e8fcba36..9088c4bc79d 100644
--- a/src/nouveau/vulkan/nvkmd/nouveau/nvkmd_nouveau_pdev.c
+++ b/src/nouveau/vulkan/nvkmd/nouveau/nvkmd_nouveau_pdev.c
@@ -101,6 +101,9 @@ nvkmd_nouveau_try_create_pdev(struct _drmDevice *drm_device,
        * and binds into it, so the answer here is the chip's, which is
        * what the feature check already asked. */
       .has_sparse = true,
+      /* nouveau lets a channel drive SET_PRIV_REG; this is where NVK's
+       * behaviour has always been, and the class check still gates it. */
+      .has_priv_reg_writes = true,
       .has_dma_buf = true,
       .has_get_vram_used = nouveau_ws_device_vram_used(ws_dev) != 0,
       .has_alloc_tiled = nouveau_ws_device_has_tiled_bo(ws_dev),
diff --git a/src/nouveau/vulkan/nvkmd/nvkmd.h b/src/nouveau/vulkan/nvkmd/nvkmd.h
index 8506d571ef9..f33a4051953 100644
--- a/src/nouveau/vulkan/nvkmd/nvkmd.h
+++ b/src/nouveau/vulkan/nvkmd/nvkmd.h
@@ -122,6 +122,15 @@ struct nvkmd_info {
     * driver underneath, and the two need not agree.
     */
    bool has_sparse;
+   /* Whether a channel of this kernel-mode driver may write privileged
+    * graphics registers from its pushbuffer, through the SET_PRIV_REG
+    * MME method. NVK otherwise decides this from the 3D class alone,
+    * which says the *chip* supports the method; whether the driver
+    * underneath lets an unprivileged channel use it is a separate
+    * question, and on some the answer is no — the write is rejected and
+    * the channel is reset, after which every submit times out.
+    */
+   bool has_priv_reg_writes;
    bool has_dma_buf;
    bool has_get_vram_used;
    bool has_alloc_tiled;
-- 
