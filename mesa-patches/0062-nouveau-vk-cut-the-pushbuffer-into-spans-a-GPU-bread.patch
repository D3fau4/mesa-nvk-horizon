From 266290ec4d6a37001b5574b99931654a66df4646 Mon Sep 17 00:00:00 2001
From: mesa-nvk-horizon <mesa-nvk-horizon@localhost>
Date: Wed, 2 Sep 2026 21:37:39 +0200
Subject: [PATCH 62/62] nouveau/vk: cut the pushbuffer into spans a GPU
 breadcrumb can bracket

horizon_gpu's hang recorder brackets each GPFIFO span with a WFI-ordered
semaphore release, which is the finest progress trace this platform can
produce: Switch 1's channel ABI returns no USERD, so there is no GET
pointer to read. NVK hands that recorder whole 64 KiB command-buffer
chunks, and the answer it gave for Godot's Forward+ hang was "somewhere
inside these 16372 dwords".

NVK_HORIZON_PUSH_SPLIT=<dwords> ends the push every N dwords, in
nvk_cmd_buffer_push(), which is the one place NVK is between two method
groups -- so a span never ends inside a method's data. Off by default and
one predicted compare against a global that stays 0 when off.

NVK_HORIZON_PUSH_SPLIT_MAX (512) bounds it. The backend's GPFIFO entry
queue is 0x800 entries and the recorder adds two entries per span, so an
unbounded split turns a large command buffer into a submit horizon_gpu
has to refuse with BUSY. Splitting stops at the cap instead.

mesa-nvk-horizon: diagnostic instrumentation (GM20B hang snapshot)
Why: a 64 KiB command-buffer chunk is one GPFIFO span, and the only
 progress evidence this platform yields is per-span, so a hang inside one
 push cannot be localised further without cutting the push.
Evidence: measured on GM20B 2026-09-02 with Godot 4.1 Forward+ on a single
 cube. Without it: "frontend: breadcrumb=15 submit=8 span=0
 phase=before-span push=[0x11174000,0x11183fd0)" -- 16372 dwords. With
 NVK_HORIZON_PUSH_SPLIT=64: "breadcrumb=893 submit=8 span=169
 phase=before-span push=[0x1118126c,0x11181378)", 67 dwords at offset
 0x349b of the same chunk, which NVK_DEBUG=push_sync decodes as
 CALL_MME_MACRO(12) = NVK_MME_DRAW_INDEXED with 0x24 indices -- the scene
 shader's colour draw. The same cube's depth-prepass draw at offset 0x32c7
 completes.
Upstream: no -- it exists to feed a breadcrumb recorder that only the
 Horizon backend has.
---
 src/nouveau/vulkan/nvk_cmd_buffer.c | 44 +++++++++++++++++++++++++++++
 src/nouveau/vulkan/nvk_cmd_buffer.h | 19 +++++++++++++
 2 files changed, 63 insertions(+)

diff --git a/src/nouveau/vulkan/nvk_cmd_buffer.c b/src/nouveau/vulkan/nvk_cmd_buffer.c
index 4e14e33..7f373dc 100644
--- a/src/nouveau/vulkan/nvk_cmd_buffer.c
+++ b/src/nouveau/vulkan/nvk_cmd_buffer.c
@@ -19,6 +19,8 @@
 #include "vk_pipeline_layout.h"
 #include "vk_synchronization.h"
 #include "util/compiler.h"
+#include "util/u_debug.h"
+#include "c11/threads.h"
 
 #include "clb097.h"
 #include "clb197.h"
@@ -49,6 +51,34 @@ nvk_descriptor_state_fini(struct nvk_cmd_buffer *cmd,
    }
 }
 
+/* Diagnostic: NVK_HORIZON_PUSH_SPLIT=<dwords>.
+ *
+ * A GPFIFO span is the finest granularity horizon_gpu's hang recorder can
+ * bracket with a GPU breadcrumb, and NVK hands it whole 64 KiB command-buffer
+ * chunks: when one of those never completes, the evidence says "somewhere in
+ * these 16372 dwords" and nothing more.  Ending the push every N dwords turns
+ * the same recorder into an N-dword-resolution progress trace, at the cost of
+ * one GPFIFO entry per N dwords.
+ *
+ * The split is taken in nvk_cmd_buffer_push(), which is the one place NVK is
+ * between method groups, so a span never ends inside a method's data.
+ *
+ * NVK_HORIZON_PUSH_SPLIT_MAX bounds the damage: the GPFIFO entry queue is
+ * 0x800 entries and the hang recorder brackets each span with two more, so an
+ * unbounded split turns a large command buffer into a submit the backend has
+ * to refuse.  Splitting stops at the cap rather than failing the submit.
+ */
+static uint32_t nvk_cmd_push_split_max_val;
+uint32_t nvk_cmd_push_split_dw;
+
+static void
+nvk_cmd_push_split_init(void)
+{
+   nvk_cmd_push_split_dw = debug_get_num_option("NVK_HORIZON_PUSH_SPLIT", 0);
+   nvk_cmd_push_split_max_val =
+      debug_get_num_option("NVK_HORIZON_PUSH_SPLIT_MAX", 512);
+}
+
 static void
 nvk_destroy_cmd_buffer(struct vk_command_buffer *vk_cmd_buffer)
 {
@@ -102,6 +132,9 @@ nvk_create_cmd_buffer(struct vk_command_pool *vk_pool,
 
    cmd->prev_subc = ffs(nvk_cmd_buffer_subchannel_mask(cmd)) - 1;
 
+   static once_flag push_split_once = ONCE_FLAG_INIT;
+   call_once(&push_split_once, nvk_cmd_push_split_init);
+
    *cmd_buffer_out = &cmd->vk;
 
    return VK_SUCCESS;
@@ -129,6 +162,8 @@ nvk_reset_cmd_buffer(struct vk_command_buffer *vk_cmd_buffer,
    cmd->push = (struct nv_push) {0};
    cmd->cond_render_mem = NULL;
 
+   cmd->push_splits = 0;
+
    util_dynarray_clear(&cmd->pushes);
    util_dynarray_clear(&cmd->copy_memory_indirect_temps);
 
@@ -208,6 +243,15 @@ nvk_cmd_buffer_flush_push(struct nvk_cmd_buffer *cmd, bool incomplete)
    cmd->push.start = cmd->push.end;
 }
 
+void
+nvk_cmd_buffer_split_push(struct nvk_cmd_buffer *cmd)
+{
+   if (cmd->push_splits >= nvk_cmd_push_split_max_val)
+      return;
+   cmd->push_splits++;
+   nvk_cmd_buffer_flush_push(cmd, false);
+}
+
 void
 nvk_cmd_buffer_new_push(struct nvk_cmd_buffer *cmd)
 {
diff --git a/src/nouveau/vulkan/nvk_cmd_buffer.h b/src/nouveau/vulkan/nvk_cmd_buffer.h
index 4bf5321..8ffbfbc 100644
--- a/src/nouveau/vulkan/nvk_cmd_buffer.h
+++ b/src/nouveau/vulkan/nvk_cmd_buffer.h
@@ -262,6 +262,12 @@ struct nvk_cmd_buffer {
     */
    struct util_dynarray pushes;
 
+   /* Diagnostic only: how many extra pushes NVK_HORIZON_PUSH_SPLIT has cut
+    * out of this command buffer, bounded so a split cannot make a submit
+    * exceed the backend's GPFIFO entry queue.
+    */
+   uint32_t push_splits;
+
    uint8_t prev_subc;
 };
 
@@ -284,6 +290,15 @@ nvk_cmd_buffer_pool(struct nvk_cmd_buffer *cmd)
 
 void nvk_cmd_buffer_new_push(struct nvk_cmd_buffer *cmd);
 
+/* Diagnostic, zero unless NVK_HORIZON_PUSH_SPLIT is set; see
+ * nvk_cmd_buffer.c.  Every N dwords the push is ended here, between two
+ * method groups, so the GPFIFO span the backend submits -- and the GPU
+ * breadcrumb horizon_gpu brackets it with -- has N-dword resolution instead
+ * of one 64 KiB chunk.
+ */
+extern uint32_t nvk_cmd_push_split_dw;
+void nvk_cmd_buffer_split_push(struct nvk_cmd_buffer *cmd);
+
 #define NVK_CMD_BUFFER_MAX_PUSH 512
 
 static inline struct nv_push *
@@ -294,6 +309,10 @@ nvk_cmd_buffer_push(struct nvk_cmd_buffer *cmd, uint32_t dw_count)
    /* Compare to the actual limit on our push bo */
    if (unlikely(cmd->push.end + dw_count > cmd->push_mem_limit))
       nvk_cmd_buffer_new_push(cmd);
+   else if (unlikely(nvk_cmd_push_split_dw != 0) &&
+            (uint32_t)(cmd->push.end - cmd->push.start) >=
+            nvk_cmd_push_split_dw)
+      nvk_cmd_buffer_split_push(cmd);
 
    cmd->push.limit = cmd->push.end + dw_count;
    
-- 
