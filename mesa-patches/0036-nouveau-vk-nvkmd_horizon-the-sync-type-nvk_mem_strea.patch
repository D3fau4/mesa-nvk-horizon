From ace9a4f69dda3b29852e2500055e5557a0005252 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 28 Jul 2026 18:37:42 +0000
Subject: [PATCH 36/59] nouveau/vk: nvkmd_horizon, the sync type nvk_mem_stream
 uses needs get_value

nvk_mem_stream_init creates its stream sync on sync_types[0] with
VK_SYNC_IS_TIMELINE. On nouveau that is a DRM syncobj, which is binary
and timeline both; here it is nvk_horizon_sync_type, which is binary.
The runtime's guard is an assert in vk_sync_init and this is a -DNDEBUG
build, so the mismatch never surfaced as an error.

It surfaces as a crash instead. vk_sync_get_value calls
sync->type->get_value with no NULL check, and this type had no
get_value: a jump to address zero, reached from
nvk_mem_stream_chunk recycling as soon as a chunk's idle time point is
ahead of what the stream has seen pass.

Give the type the timeline bookkeeping that use needs. The object now
carries the value its pending fence will complete and the largest value
known to have completed; get_value polls the fence (channel_wait_fence
with a zero timeout, which also notices a faulted channel and needs no
device pointer) and reports the latter. wait() returns at once for a
value already passed, and records the value its fence covers.

nvkmd_horizon_ctx_signal now passes signal_value through rather than
dropping it, which is what left that counter at zero.

Binary use is unchanged: wait_value is 0 there, passed_value starts at
0, and the new early-out is never taken.

The larger question -- whether this type should advertise
VK_SYNC_FEATURE_TIMELINE and replace the runtime's emulation, the way
nouveau's syncobj does -- stays open in STATUS.md. Reordering
sync_types alone would hand nvkmd_horizon_ctx_signal a vk_sync_timeline
to container_of, which is worse than the mismatch it fixes.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 .../vulkan/nvkmd/horizon/nvkmd_horizon.h      | 21 +++++-
 .../vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c  |  6 +-
 .../vulkan/nvkmd/horizon/nvkmd_horizon_sync.c | 70 ++++++++++++++++++-
 3 files changed, 94 insertions(+), 3 deletions(-)

diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon.h b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon.h
index 1cb266b..a5ddb5d 100644
--- a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon.h
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon.h
@@ -173,13 +173,32 @@ struct nvk_horizon_sync {
     * waited on forever.
     */
    horizon_gpu_channel *chan;
+
+   /* Timeline bookkeeping.
+    *
+    * nvk_mem_stream_init creates its stream sync on sync_types[0] with
+    * VK_SYNC_IS_TIMELINE and then calls vk_sync_get_value() on it. On
+    * nouveau that type is a DRM syncobj, which is binary *and* timeline;
+    * here it is this one, which is binary. The runtime's check is an
+    * assert and this is a -DNDEBUG build, so the mismatch does not
+    * surface as an error — vk_sync_get_value calls type->get_value with
+    * no NULL check, and a missing one is a jump to zero.
+    *
+    * `signalled` is the timeline value `fence` will complete; `passed`
+    * is the largest value known to have completed. Every signal on one
+    * of these comes from one channel and syncpoints are monotonic, so
+    * the latest fence covers every earlier value and one pair is enough.
+    */
+   uint64_t signalled_value;
+   uint64_t passed_value;
 };
 
 extern const struct vk_sync_type nvk_horizon_sync_type;
 
 void nvk_horizon_sync_set_fence(struct vk_sync *sync,
                                 horizon_gpu_channel *chan,
-                                horizon_gpu_fence fence);
+                                horizon_gpu_fence fence,
+                                uint64_t signal_value);
 
 VkResult nvkmd_horizon_create_ctx(struct nvkmd_dev *dev,
                                   struct vk_object_base *log_obj,
diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c
index 1fbac96..df58208 100644
--- a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_ctx.c
@@ -286,8 +286,12 @@ nvkmd_horizon_ctx_signal(struct nvkmd_ctx *_ctx,
    }
 
    for (uint32_t i = 0; i < signal_count; i++) {
+      /* signal_value matters for a timeline: nvk_mem_stream signals its
+       * stream sync with a monotonically increasing push counter and
+       * then asks for it back through vk_sync_get_value. Dropping it
+       * left that counter at zero forever. */
       nvk_horizon_sync_set_fence(signals[i].sync, ctx->chan,
-                                 ctx->last_fence);
+                                 ctx->last_fence, signals[i].signal_value);
    }
 
    return VK_SUCCESS;
diff --git a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_sync.c b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_sync.c
index 3d226f9..a96ec64 100644
--- a/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_sync.c
+++ b/src/nouveau/vulkan/nvkmd/horizon/nvkmd_horizon_sync.c
@@ -67,6 +67,10 @@ nvk_horizon_sync_init(struct vk_device *device,
                                : NVK_HORIZON_SYNC_RESET;
    sync->fence = (horizon_gpu_fence) { 0, 0 };
    sync->chan = NULL;
+   /* Timeline use starts the counter at initial_value; binary use passes
+    * 0 or 1 and never reads these back. */
+   sync->signalled_value = initial_value;
+   sync->passed_value = initial_value;
 
    return VK_SUCCESS;
 }
@@ -94,6 +98,10 @@ nvk_horizon_sync_signal(struct vk_device *device,
     * only ever waits on fences this backend produced itself.
     */
    sync->state = NVK_HORIZON_SYNC_SIGNALLED;
+   /* Timeline use: a CPU signal moves the counter to `value`. Binary use
+    * passes 0, which leaves both alone. */
+   sync->signalled_value = MAX2(sync->signalled_value, value);
+   sync->passed_value = MAX2(sync->passed_value, value);
 
    return VK_SUCCESS;
 }
@@ -106,6 +114,10 @@ nvk_horizon_sync_reset(struct vk_device *device, struct vk_sync *_sync)
    sync->state = NVK_HORIZON_SYNC_RESET;
    sync->fence = (horizon_gpu_fence) { 0, 0 };
    sync->chan = NULL;
+   /* Reset is a binary operation — the runtime never resets a timeline —
+    * so the counter goes back to where init leaves it. */
+   sync->signalled_value = 0;
+   sync->passed_value = 0;
 
    return VK_SUCCESS;
 }
@@ -127,6 +139,8 @@ nvk_horizon_sync_move(struct vk_device *device,
    src->state = NVK_HORIZON_SYNC_RESET;
    src->fence = (horizon_gpu_fence) { 0, 0 };
    src->chan = NULL;
+   src->signalled_value = 0;
+   src->passed_value = 0;
 
    return VK_SUCCESS;
 }
@@ -143,6 +157,12 @@ nvk_horizon_sync_wait(struct vk_device *device,
    if (sync->state == NVK_HORIZON_SYNC_SIGNALLED)
       return VK_SUCCESS;
 
+   /* Timeline use (nvkmd_horizon.h): a value already known to have
+    * completed needs no wait at all. `wait_value` is 0 for binary use,
+    * and passed_value starts at 0, so this is never taken there. */
+   if (wait_value != 0 && sync->passed_value >= wait_value)
+      return VK_SUCCESS;
+
    /* VK_SYNC_WAIT_PENDING asks only that the operation has been
     * submitted, not that it has completed. A fence exists exactly when
     * the submit happened, so that question is already answered.
@@ -191,7 +211,52 @@ nvk_horizon_sync_wait(struct vk_device *device,
    }
 
    sync->state = NVK_HORIZON_SYNC_SIGNALLED;
+   /* The fence covers every timeline value up to the one it carries. */
+   sync->passed_value = MAX2(sync->passed_value, sync->signalled_value);
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvk_horizon_sync_get_value(struct vk_device *device,
+                           struct vk_sync *_sync,
+                           uint64_t *value)
+{
+   struct nvk_horizon_sync *sync = to_horizon_sync(_sync);
+
+   /* Present because nvk_mem_stream calls it (see nvkmd_horizon.h), and
+    * a missing entry here is a call through a NULL pointer rather than
+    * an error the caller could handle.
+    */
+   if (sync->state == NVK_HORIZON_SYNC_SIGNALLED) {
+      /* A CPU-side signal completes everything asked of this object. */
+      sync->passed_value = MAX2(sync->passed_value, sync->signalled_value);
+      *value = sync->passed_value;
+      return VK_SUCCESS;
+   }
+
+   if (sync->state == NVK_HORIZON_SYNC_PENDING) {
+      /* A zero timeout makes channel_wait_fence a poll: it reads the
+       * syncpoint once, finds the deadline already past and reports
+       * TIMEOUT. Used rather than horizon_gpu_fence_poll because this
+       * form also notices a faulted channel, and because it needs no
+       * device pointer — a channel does not hand one out.
+       */
+      horizon_gpu_result res =
+         horizon_gpu_channel_wait_fence(sync->chan, sync->fence, 0);
+      if (res.status == HORIZON_GPU_OK) {
+         sync->passed_value = MAX2(sync->passed_value, sync->signalled_value);
+         sync->state = NVK_HORIZON_SYNC_SIGNALLED;
+      } else if (res.status != HORIZON_GPU_ERR_TIMEOUT) {
+         return vk_errorf(device, nvkmd_horizon_result(res),
+                          "horizon_gpu_channel_wait_fence(%" PRIu32 ", %"
+                          PRIu32 ", poll) failed: status %d, nv 0x%08" PRIx32,
+                          sync->fence.syncpt_id, sync->fence.threshold,
+                          (int)res.status, res.nv);
+      }
+   }
 
+   *value = sync->passed_value;
    return VK_SUCCESS;
 }
 
@@ -221,6 +286,7 @@ const struct vk_sync_type nvk_horizon_sync_type = {
    .reset = nvk_horizon_sync_reset,
    .move = nvk_horizon_sync_move,
    .wait = nvk_horizon_sync_wait,
+   .get_value = nvk_horizon_sync_get_value,
    /* No import/export: there is no dma-buf, no sync file and no fd on
     * this platform to carry one through. wait_many is left to the
     * runtime's emulation over wait(), which is correct and is not on
@@ -231,11 +297,13 @@ const struct vk_sync_type nvk_horizon_sync_type = {
 void
 nvk_horizon_sync_set_fence(struct vk_sync *_sync,
                            horizon_gpu_channel *chan,
-                           horizon_gpu_fence fence)
+                           horizon_gpu_fence fence,
+                           uint64_t signal_value)
 {
    struct nvk_horizon_sync *sync = to_horizon_sync(_sync);
 
    sync->chan = chan;
    sync->fence = fence;
+   sync->signalled_value = signal_value;
    sync->state = NVK_HORIZON_SYNC_PENDING;
 }
-- 
2.43.0

