# mesa-nvk-horizon — versions.
#
# Plain KEY=value, sourceable by any POSIX shell. No absolute paths from
# any developer's machine (scripts/check-no-abs-paths.sh enforces this):
# host-side locations are resolved at run time through $DEVKITPRO or
# $PWD, and the only absolute paths named here are *inside* the
# container image.
#
# THE FILE HAS TWO HALVES:
#
#   ENVIRONMENT — how to *reach* the Switch toolchain. Nothing about its
#                 contents is recorded, checked or updated here.
#   PINNED      — the inputs this project chooses. Changing one is a
#                 decision.
#
# Copyright (c) mesa-nvk-horizon contributors
# SPDX-License-Identifier: MIT

# =====================================================================
# ENVIRONMENT — the Switch toolchain, taken as given
# =====================================================================
# Policy (owner's decision, 2026-07-26): **libnx and the rest of the
# Switch toolchain belong to the environment, not to this project.**
# They are neither pinned nor updated from here. Whatever `$DEVKITPRO`
# points at, or whatever is inside the container image the developer
# runs, is what gets used.
#
# Why this is the right split, and not laziness: libnx gains fixes and
# new `nv`-service bindings frequently, and this backend is written
# against exactly those services. A version recorded in this file could
# only ever be a stale copy of a fact that lives somewhere else — and a
# misleading one, because the image builds libnx from git HEAD on top of
# the package, so `dkp-pacman -Q libnx` describes only 21 of its 226
# installed files (measured: `dkp-pacman -Qkk libnx` reports 205
# altered). Updating libnx is `dkp-pacman -Syu`, or a newer image. It is
# not an edit to this repository.
#
# What this project does instead of tracking versions is *record what it
# actually used*: scripts/package-horizon.sh writes the resolved image
# digest and the live package versions into build/pkg/MANIFEST.txt next
# to each artefact's sha256, so a result measured on console stays
# attributable to a specific build. Reading, never pinning.
#
# Report what the current environment provides:
#   scripts/print-toolchain-versions.sh

# Used only when $DEVKITPRO is unset, as the fallback toolchain
# (CLAUDE.md). Override with HORIZON_NX_IMAGE=<any reference> to build
# against a different environment — including a specific digest, when
# reproducing the artefacts behind a recorded hardware run.
HORIZON_NX_IMAGE_REPO=ghcr.io/d3fau4/nx-dev
HORIZON_NX_IMAGE_TAG=latest

# devkitPro install prefix *inside* that image. Recorded so no script
# types the path inline; it is a property of the image's layout, not a
# version.
HORIZON_NX_IMAGE_DEVKITPRO=/opt/devkitpro

# Both directories the build resolves bare tool names from — the Meson
# cross file lists its [binaries] unqualified on purpose, so both have
# to be on PATH.
#
# Each was found missing in a different mode, which is why both are
# listed explicitly rather than assumed:
#   - the image's PATH omits devkitA64/bin (it lists tools/bin,
#     devkitARM/bin and devkitPPC/bin), so the cross compiler is not
#     found in a plain `docker run ... sh -c`;
#   - a local devkitPro needs tools/bin adding as well, for elf2nro and
#     nacptool. The image's PATH already had that one, which masked it
#     until the local path was actually exercised.
HORIZON_TOOLCHAIN_BINDIR_REL=devkitA64/bin
HORIZON_TOOLS_BINDIR_REL=tools/bin

# Stable properties of the devkitA64 cross toolchain. These are what the
# build actually depends on, and unlike package versions they do not
# move when the environment is updated.
DEVKITA64_TARGET_TRIPLE=aarch64-none-elf
DEVKITA64_TOOL_PREFIX=aarch64-none-elf-

# Where rustup lives inside the image. The image installs the rolling
# `nightly` with rust-src; which nightly, like libnx, is the
# environment's business (docs/rust-toolchain.md).
RUST_CARGO_HOME_IN_IMAGE=/opt/cargo

# =====================================================================
# PINNED — changing these is a decision, not an update
# =====================================================================

# ---------------------------------------------------------------------
# Mesa (decision D2)
# ---------------------------------------------------------------------
# Current stable series at Phase 2 start. Chosen over the reference
# port's 25.0.7 for a modern nvkmd surface and a credible upstreaming
# path (docs/known-risks.md R14).
#
# Pinned, unlike the Switch toolchain, because it is genuinely ours:
# mesa-patches/ applies to a specific tree, and a Mesa that moved
# underneath would break Phase 3 silently rather than loudly.
#
#   git ls-remote --tags https://gitlab.freedesktop.org/mesa/mesa.git mesa-26.1.5
MESA_REPO=https://gitlab.freedesktop.org/mesa/mesa.git
MESA_TAG=mesa-26.1.5

# The commit the tag points at. This is what scripts/fetch-mesa.sh
# verifies; the tag alone is not enough, since tags can be moved.
MESA_COMMIT=6a02618ccf6c5651ecb9cccbde571eb61fd73592
MESA_TAG_OBJECT=3c008c397d06d707cd6cdda3fdad65ce4efe6e2b

# Fallback when git-over-https is blocked: GitLab serves subtree
# tarballs addressed by commit. Verified working from this environment.
MESA_ARCHIVE_BASE=https://gitlab.freedesktop.org/mesa/mesa/-/archive

# ---------------------------------------------------------------------
# Meson
# ---------------------------------------------------------------------
# Mesa 26.1.5's root meson.build declares meson_version : '>= 1.4.0'.
# The image has no meson at all and Debian bookworm's is 1.3.2, so
# scripts/ install this version into a gitignored directory. Pinned
# because nothing in the environment supplies it — it is ours to choose.
MESON_VERSION=1.11.2

# ---------------------------------------------------------------------
# Python modules Mesa's code generators need (milestone item 6)
# ---------------------------------------------------------------------
# Mesa runs these on the *build* machine to generate sources; they are
# not part of the Switch toolchain and the image ships neither them nor
# pip. Measured by configuring the pinned tree: without mako, Mesa stops
# at "Python (3.x) mako module >= 0.8.0 required to build mesa".
#
# Pinned for the same reason as Meson: nothing in the environment
# supplies them, so the choice is ours. Installed on the host — the
# container has no network — into a gitignored directory and made
# visible through PYTHONPATH.
MESA_PYTHON_MAKO_VERSION=1.3.12
MESA_PYTHON_PYYAML_VERSION=6.0.3

# ---------------------------------------------------------------------
# Rust target (docs/rust-toolchain.md, R13)
# ---------------------------------------------------------------------
# rustc already ships this target (tier 3, os = "horizon", std = false,
# panic = abort). We do NOT define a custom one.
#
# toolchain/aarch64-horizon.json snapshots its spec. That is a tripwire,
# not a pin: the target definition decides how NAK/NIL get compiled, so
# a silent change to its panic strategy or feature set should show up as
# a diff. Precisely because the environment's nightly floats,
# scripts/check-rust-target.sh reports drift and exits 0 by default.
RUST_TARGET=aarch64-nintendo-switch-freestanding

# No Rust std sysroot is built. R13 was investigated against the Mesa
# tree at MESA_COMMIT before any toolchain work: NAK/NIL need `std` as
# Mesa links them today, but the gap to no_std+alloc is a handful of
# mechanical substitutions, deferred to mesa-patches/ in Phase 3/4.
RUST_BUILD_STD=no
