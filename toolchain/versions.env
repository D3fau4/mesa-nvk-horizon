# mesa-nvk-horizon — the single source of truth for every pinned version.
#
# Plain KEY=value, sourceable by any POSIX shell. No absolute paths from
# any developer's machine (scripts/check-no-abs-paths.sh enforces this):
# host-side locations are resolved at run time through $DEVKITPRO or
# $PWD, and the only absolute paths named here are *inside* the
# container image, which this file pins by digest.
#
# Every value below was read out of the pinned image or out of the
# upstream git remote; the command that produced it is quoted above it.
# Re-derive them with scripts/print-toolchain-versions.sh.
#
# Copyright (c) mesa-nvk-horizon contributors
# SPDX-License-Identifier: MIT

# ---------------------------------------------------------------------
# Toolchain container (docs/known-risks.md R15)
# ---------------------------------------------------------------------
# devkitPro ships rolling packages and its servers are unreachable from
# some networks (pkg.devkitpro.org and apt.devkitpro.org both answer 403
# here), so the container image *is* the toolchain pin. Always resolve
# it by digest: the `latest` tag moves.
#
#   curl -H "Authorization: Bearer <ghcr token>" \
#        -H "Accept: application/vnd.oci.image.index.v1+json" \
#        -D- https://ghcr.io/v2/d3fau4/nx-dev/manifests/latest
#   -> docker-content-digest
HORIZON_NX_IMAGE_REPO=ghcr.io/d3fau4/nx-dev

# OCI image index (multi-arch). This is what `docker pull` should use.
HORIZON_NX_IMAGE_DIGEST=sha256:61a38fe43da645876023783344619bc0ac28adf260de3e251b2ac6f98c751043

# The linux/amd64 manifest inside that index, recorded so a mismatch is
# traceable to a platform rather than to a re-push of the tag.
HORIZON_NX_IMAGE_AMD64_DIGEST=sha256:04c91da3af9a6835bd06d0f8122b602cffc56a46a370b6d2c44909ee7e6472a0

# From the image config blob (.created).
HORIZON_NX_IMAGE_CREATED=2026-07-26T18:44:45Z

# devkitPro install prefix *inside* the image. The image already exports
# DEVKITPRO=/opt/devkitpro; this is recorded so scripts never type the
# path inline.
HORIZON_NX_IMAGE_DEVKITPRO=/opt/devkitpro

# The image's own PATH does NOT include devkitA64/bin (it lists
# tools/bin, devkitARM/bin and devkitPPC/bin only). Anything that
# resolves the cross compiler by bare name — the Meson cross file does —
# must prepend this. Verified: `aarch64-none-elf-gcc` is not found in a
# plain `docker run ... sh -c` without it.
HORIZON_TOOLCHAIN_BINDIR_REL=devkitA64/bin

# ---------------------------------------------------------------------
# devkitA64 / devkitPro packages
#   docker run --rm $IMAGE dkp-pacman -Q
# ---------------------------------------------------------------------
DEVKITA64_VERSION=r29.2-1
DEVKITA64_GCC_VERSION=15.2.0-7
DEVKITA64_BINUTILS_VERSION=2.45.1-2
DEVKITA64_NEWLIB_VERSION=4.6.0.20260123-4
DEVKITA64_RULES_VERSION=1.1.1-1

# Compiler and linker banners, for the record:
#   aarch64-none-elf-gcc (devkitA64) 15.2.0   [-dumpmachine: aarch64-none-elf]
#   GNU ld (GNU Binutils) 2.45.1
DEVKITA64_TARGET_TRIPLE=aarch64-none-elf
DEVKITA64_TOOL_PREFIX=aarch64-none-elf-

# elf2nro / nacptool / elf2nso live in switch-tools; bin2s and friends
# in general-tools.
SWITCH_TOOLS_VERSION=1.13.1-1
GENERAL_TOOLS_VERSION=1.4.4-1

# devkitPro's own Meson cross-file generators (meson-cross.sh,
# meson-toolchain.sh). We do not call them — they bake absolute paths
# from `which` into the generated file — but toolchain/horizon-aarch64.cross
# is kept consistent with the machine description they emit.
DKP_MESON_SCRIPTS_VERSION=1.1.0-1
DKP_TOOLCHAIN_VARS_VERSION=1.0.5-1

# ---------------------------------------------------------------------
# libnx — NOT pinned by its package version. See docs/known-risks.md R15.
# ---------------------------------------------------------------------
# dkp-pacman reports libnx 4.12.0-1, but the image then does
#   git clone --depth=1 https://github.com/switchbrew/libnx && make install
# on top of it, so the installed tree is whatever switchbrew/libnx HEAD
# was when the image was built. Measured:
#
#   docker run --rm $IMAGE dkp-pacman -Qkk libnx
#   -> libnx: 226 total files, 205 altered files
#      (libnx.a and libnxd.a: size, MD5 and SHA256 all mismatch)
#
# So LIBNX_PACKAGE_VERSION below is provenance, not a pin. The real pin
# for libnx is HORIZON_NX_IMAGE_DIGEST. Do not "upgrade libnx" by
# changing this number — rebuild the image and re-pin the digest.
LIBNX_PACKAGE_VERSION=4.12.0-1
LIBNX_SOURCE=git-head-at-image-build
LIBNX_PINNED_BY=HORIZON_NX_IMAGE_DIGEST

# Present in the image, unused by Phase 1 (recorded so a future
# dependency on it is a deliberate change, not a surprise).
DEKO3D_VERSION=0.5.0-1

# ---------------------------------------------------------------------
# Mesa (decision D2)
# ---------------------------------------------------------------------
# Current stable series at Phase 2 start. Chosen over the reference
# port's 25.0.7 for a modern nvkmd surface and a credible upstreaming
# path (docs/known-risks.md R14).
#
#   git ls-remote --tags https://gitlab.freedesktop.org/mesa/mesa.git mesa-26.1.5
MESA_REPO=https://gitlab.freedesktop.org/mesa/mesa.git
MESA_TAG=mesa-26.1.5

# The commit the tag points at. This is the pin scripts/fetch-mesa.sh
# verifies; MESA_TAG alone is not enough (tags can be moved).
MESA_COMMIT=6a02618ccf6c5651ecb9cccbde571eb61fd73592

# The annotated tag object itself, so `git ls-remote --tags` output can
# be checked without dereferencing.
MESA_TAG_OBJECT=3c008c397d06d707cd6cdda3fdad65ce4efe6e2b

# Fallback when git-over-https is blocked: gitlab serves subtree
# tarballs. Verified working from this environment.
MESA_ARCHIVE_BASE=https://gitlab.freedesktop.org/mesa/mesa/-/archive

# ---------------------------------------------------------------------
# Build tools
# ---------------------------------------------------------------------
# Mesa 26.1.5's root meson.build declares meson_version : '>= 1.4.0'.
# The image has no meson at all and Debian bookworm's is 1.3.2, so
# scripts/ install this version into a gitignored directory rather than
# relying on either.
MESON_VERSION=1.11.2

# Shipped in the image; recorded, not installed by us.
NINJA_VERSION=1.11.1
PYTHON_VERSION=3.11.2

# ---------------------------------------------------------------------
# Rust (docs/known-risks.md R13, docs/rust-toolchain.md)
# ---------------------------------------------------------------------
# The image installs rustup's rolling `nightly` with the rust-src
# component, so — exactly like libnx — the Rust version is pinned by the
# image digest, not by a channel name.
#
#   docker run --rm $IMAGE sh -c 'PATH=/opt/cargo/bin:$PATH rustc --version'
RUST_CHANNEL=nightly
RUST_VERSION=1.99.0-nightly
RUST_COMMIT_HASH=008fa22ce
RUST_COMMIT_DATE=2026-07-25
RUST_CARGO_VERSION=1.99.0-nightly
RUST_PINNED_BY=HORIZON_NX_IMAGE_DIGEST
RUST_CARGO_HOME_IN_IMAGE=/opt/cargo

# rustc already ships this target (tier 3, os = "horizon", std = false,
# panic = abort). We do NOT define a custom target: see
# docs/rust-toolchain.md. toolchain/aarch64-horizon.json is a snapshot of
# this target's spec used only to detect drift between nightlies.
RUST_TARGET=aarch64-nintendo-switch-freestanding

# No Rust std sysroot is built. R13 was investigated against the Mesa
# tree at MESA_COMMIT before any toolchain work: NAK/NIL need `std` as
# Mesa links them today, but the gap to no_std+alloc is a handful of
# mechanical substitutions, deferred to mesa-patches/ in Phase 3/4.
RUST_BUILD_STD=no
